(function(){
 'use strict';
 const GUIDES={"34":{"intro":"Числовое неравенство сравнивает два известных числа или выражения. Здесь не ищут множество решений: выясняют, какая величина больше, и применяют свойства сравнения.","steps":"Установи исходный знак сравнения. При прибавлении одинакового числа знак сохраняется; при умножении на отрицательное число знак меняется. Перед возведением в квадрат учитывай знаки сравниваемых чисел.","check":"Подставь конкретные числа или выполни обе операции и проверь, что новое сравнение действительно верно."},"56":{"intro":"Метод удвоения медианы превращает отрезок от вершины до середины стороны в диагональ вспомогательного параллелограмма.","steps":"Если AM — медиана к BC, продолжи AM за M и отложи MD=AM. Получатся равные треугольники ABM и DCM, потому что BM=MC, AM=MD и вертикальные углы равны. Затем используй равенство соответствующих сторон или углов.","check":"Убедись, что M — середина BC и одновременно середина AD. Только после этого можно переносить длины и углы по равенству треугольников."},"61":{"intro":"Средняя линия трапеции соединяет середины боковых сторон, параллельна основаниям и равна их полусумме.","steps":"Обозначь основания a и b и найди m=(a+b):2. Если известны m и одно основание, найди другое из равенства 2m=a+b. Для площади с высотой h используй S=m·h.","check":"Длина средней линии лежит между длинами оснований (или равна им при равных основаниях); площадь имеет квадратные единицы."},"71":{"intro":"У подобных фигур линейные размеры меняются с коэффициентом k, а площади — с коэффициентом k².","steps":"Определи, от какой фигуры к какой берётся коэффициент подобия k. Для площадей записывай S₂:S₁=k², а если даны площади — находи положительный корень из их отношения. Для периметров коэффициент остаётся k.","check":"Если стороны увеличились в k раз, площадь должна увеличиться в k² раз. Не используй отношение площадей как отношение сторон."},"82":{"steps":"Для выпуклого четырёхугольника сравни суммы противоположных сторон: AB+CD и BC+AD. Их равенство — необходимое и достаточное условие существования вписанной окружности. Для касательных из одной вершины используй равенство отрезков касательных.","check":"Уточни, что четырёхугольник выпуклый. При неравных суммах сторон вписанная окружность невозможна."},"83":{"intro":"Число общих точек окружностей определяется их радиусами R и r и расстоянием d между центрами.","steps":"Вычисли R+r и |R−r|. Сравни с d: при |R−r|<d<R+r две общие точки; при равенстве одной из границ — касание; при d>R+r или d<|R−r| общих точек нет. Совпадающие окружности (d=0 и R=r) рассматривай отдельно.","check":"Не путай внутреннее и внешнее касание. При совпадающих окружностях общих точек бесконечно много."},"84":{"intro":"Касание двух различных окружностей означает, что у них ровно одна общая точка.","steps":"При внешнем касании расстояние между центрами d=R+r, при внутреннем d=|R−r| (для различающихся радиусов). Если нужно найти неизвестный радиус, составь соответствующее равенство.","check":"При R=r и d=0 окружности совпадают, а не касаются в одной точке."},"85":{"intro":"Количество общих касательных определяется взаимным расположением двух окружностей.","steps":"Сравни расстояние d между центрами с R+r и |R−r|. Если окружности лежат отдельно, общих касательных 4; при внешнем касании 3; при пересечении в двух точках 2; при внутреннем касании 1; если одна строго внутри другой, 0.","check":"Учитывай особый случай совпадающих окружностей: у них бесконечно много общих касательных."},"91":{"steps":"Сначала определи, о чём спрашивают: принадлежность a∈A, включение A⊆B или собственное подмножество A⊂B. Для включения проверь каждый элемент первого множества; чтобы опровергнуть его, достаточно одного контрпримера.","check":"Набор одинаковых элементов задаёт одно множество независимо от их порядка и повторов. Не путай a∈A с {a}⊆A."},"99":{"intro":"В теории графов дерево — это связный граф без циклов; это не то же самое, что схема ветвления случайного эксперимента.","steps":"Выпиши вершины и рёбра, проверь связность и отсутствие циклов. Для дерева из V вершин число рёбер E=V−1. Добавление ребра между уже соединёнными путём вершинами создаёт цикл.","check":"Условие E=V−1 само по себе не гарантирует, что произвольный граф является деревом: нужна связность."},"100":{"intro":"В дереве между любыми двумя вершинами существует ровно один простой путь. Листом называют вершину степени 1.","steps":"Для поиска пути последовательно переходи по существующим рёбрам, не повторяя вершины. Для листьев подсчитай степень каждой вершины и выбери те, у которых ровно одно ребро.","check":"Проверь каждое ребро найденного пути и убедись, что все листья имеют степень 1."},"101":{"intro":"Для любого дерева с V вершинами количество рёбер E=V−1, а для леса из C деревьев E=V−C.","steps":"Проверь, что граф действительно дерево или лес, и только затем используй формулу. При удалении листа дерева удаляется ровно одна вершина и одно ребро; при соединении двух разных деревьев одним ребром число компонент уменьшается на 1.","check":"Если в графе есть цикл, применять E=V−1 как готовое свойство дерева нельзя."},"102":{"intro":"Дерево вариантов помогает последовательно перечислить решения, когда выбор делается в несколько этапов.","steps":"Укажи число допустимых вариантов на каждом шаге. Если каждый вариант первого шага сочетается со всеми вариантами второго, умножь их количества; при ограничениях пересчитай число допустимых продолжений по ветвям.","check":"Не перемножай числа вариантов механически, если некоторые сочетания запрещены условием."},"103":{"steps":"Опиши полное множество исходов Ω, затем событие A. Противоположное событие состоит из всех исходов Ω, не входящих в A. Для вероятностей используй P(не A)=1−P(A).","check":"Событие A и противоположное не имеют общих исходов, а вместе покрывают всё Ω."},"104":{"steps":"Для A∩B оставь исходы, принадлежащие обоим событиям; для A∪B собери исходы хотя бы одного. В общем случае P(A∪B)=P(A)+P(B)−P(A∩B), иначе общая часть будет посчитана дважды.","check":"Если события пересекаются, нельзя просто складывать их вероятности без вычитания пересечения."},"105":{"steps":"Проверь, что события несовместны: A∩B=∅. Только в этом случае P(A∪B)=P(A)+P(B). В задачах с карточками отдельно сосчитай количество исходов каждого события.","check":"Сумма вероятностей несовместных событий не превышает 1."},"106":{"steps":"Определи, какое событие уже известно (B), и сузь пространство исходов до B. При P(B)>0 вычисли P(A|B)=P(A∩B)/P(B). Для равновозможных исходов можно считать благоприятные исходы внутри B.","check":"Знаменатель условной вероятности соответствует условию B, а не обязательно всему исходному пространству."},"107":{"steps":"Для последовательных событий используй P(A∩B)=P(A)·P(B|A). Без возвращения после первого извлечения меняются число объектов и вероятность второго события.","check":"Произведение P(A)P(B) без условной вероятности допустимо только при независимости событий."},"108":{"steps":"Найди P(A), P(B) и P(A∩B). События независимы тогда и только тогда, когда P(A∩B)=P(A)P(B); одну лишь равновозможность исходов нельзя принимать за независимость.","check":"Приведи обе части равенства к общему знаменателю и сравни точно, а не по округлениям."},"109":{"steps":"Подпиши вероятность каждой ветви с учётом уже пройденного пути. Вероятность полного пути найди умножением вероятностей ветвей; для события, состоящего из нескольких несовместных путей, сложи их вероятности.","check":"В корректном полном дереве вероятности исходящих из одной вершины ветвей суммируются до 1; сумма вероятностей всех конечных путей тоже равна 1."}};
 const PLACEHOLDER='<div class="g8-theory852-example"></div>';
 // В версиях 19–20 разобранные примеры полностью статичны, но старый
 // слой всё ещё создавал 48 случайных вопросов перед их заменой.
 // Заполним только кеш из текущего каталога 8 класса: поздние слои
 // заменят эту заглушку на соответствующий проверенный пример.
 if(typeof G8_STAGE852_THEORY_CACHE==='object' && typeof g8AllTopics==='function'){
  for(const topic of g8AllTopics()){
   const raw=rawCourseId(topic.id);
   if(!G8_STAGE852_THEORY_CACHE[raw])G8_STAGE852_THEORY_CACHE[raw]=PLACEHOLDER;
  }
 }
 const previousLesson=g8Lesson;
 g8Lesson=function(id){
  const source=previousLesson(id);
  if(!String(id).startsWith('g8:'))return source;
