   case 'two_model_ratio':{const x=rnd(6,12),m1=rnd(2,5),m2=rnd(2,5);return N(`Модель №1 в ${m1} раза меньше настоящего объекта и имеет длину ${x*m2} см. Модель №2 в ${m2} раза меньше того же объекта. Найди длину модели №2.`,x*m1,`Длина объекта ${x*m2}·${m1}=${x*m2*m1}; модель №2: ${x*m2*m1}:${m2}=${x*m1} см.`);}
   case 'scale_then_area':{const width=rnd(3,9),len=rnd(4,10);return N(`У прямоугольной модели стороны ${width} и ${len} см. Увеличили все линейные размеры в ${k} раза. Найди площадь увеличенного прямоугольника.`,width*len*k*k,`Изначальная площадь ${width*len} см²; площади увеличиваются в ${k*k} раз: ${width*len*k*k} см².`,'см²');}
   case 'similar_area_difference':{const S=rnd(6,22);return N(`Площади двух подобных фигур относятся как 1:${k*k}. Разность их площадей ${S*(k*k-1)} см². Найди площадь меньшей фигуры.`,S,`Пусть меньшая площадь x, тогда ${k*k}x−x=${S*(k*k-1)}, x=${S} см².`,'см²');}
   case 'ratio_with_unknown':{const side=rnd(4,10),coef=rnd(2,5),sum=rnd(12,35);return N(`В подобных треугольниках AB=${side} см и A′B′=${side*coef} см. Если периметр большего равен ${coef*(side+sum)} см, найди сумму длин двух оставшихся сторон меньшего.`,sum,`Периметр меньшего ${coef*(side+sum)}:${coef}=${side+sum} см. Убираем AB=${side} см: остаётся ${sum} см.`);}
  }throw Error('QA7 unknown similarity '+v);
 }
 function area(d,v){const raw='area_properties',N=(t,a,e,model=null,unit='см²')=>number(raw,d,v,t,a,e,model,unit),Q=(t,a,w,e,model=null)=>choice(raw,d,v,t,a,w,e,model);
