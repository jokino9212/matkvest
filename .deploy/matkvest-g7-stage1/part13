  case 'find_side':{const W=rnd(4,17),H=rnd(4,12);return N(`Площадь прямоугольника ${W*H} см². Одна сторона ${W} см. Найди другую.`,H,`Другая сторона S:${W}=${W*H}:${W}=${H} см.`,null,'см');}
