  if(v==='ticket_fee'){
   const a=r(6,20),b=r(4,16),p1=one([200,250,300,350]),p2=one([100,120,150]),fee=one([200,300,400]),gross=a*p1+b*p2,net=gross-fee;
   return mk(raw,v,{a,b,p1,p2,fee,gross,net},`На спектакль продали ${a+b} билетов: взрослые по ${p1} ₽, детские по ${p2} ₽. После удержания фиксированного сбора ${fee} ₽ осталось ${net} ₽. Сколько взрослых билетов продали?`,a,`Полная выручка ${net}+${fee}=${gross}. Для количеств x и y: x+y=${a+b}, ${p1}x+${p2}y=${gross}. Получаем x=${a}, y=${b}.`);
  }
  if(v==='two_receipts'){
   const x=r(20,110),y=r(15,90),[a,b,c,d]=one([[2,3,3,2],[2,5,3,4],[3,2,5,3],[4,3,3,5]]),p=a*x+b*y,q=c*x+d*y;
   return mk(raw,v,{x,y,a,b,c,d,p,q},`За ${a} тетради и ${b} альбома заплатили ${p} ₽. За ${c} тетради и ${d} альбома заплатили ${q} ₽. Сколько стоит одна тетрадь?`,x,`Пусть x и y — цены. Система ${html(eq(a,b,p),eq(c,d,q))} имеет решение x=${x}, y=${y}; стоимость тетради ${x} ₽.`);
  }
  if(v==='heads_legs_cost'){
   const chickens=r(5,17),rabbits=r(3,13),heads=chickens+rabbits,legs=2*chickens+4*rabbits,priceChicken=one([7,9,11]),priceRabbit=one([12,14,17]),cost=chickens*priceChicken+rabbits*priceRabbit;
   return mk(raw,v,{chickens,rabbits,heads,legs,priceChicken,priceRabbit,cost},`Во дворе куры и кролики: ${heads} ${form(heads,'голова','головы','голов')} и ${legs} ${form(legs,'нога','ноги','ног')}. Корм одной курицы стоит ${priceChicken} ₽ в день, кролика — ${priceRabbit} ₽. Сколько рублей тратят на корм всех животных за день?`,cost,`x+y=${heads}, 2x+4y=${legs}, откуда кур ${chickens}, кроликов ${rabbits}. Стоимость ${chickens}·${priceChicken}+${rabbits}·${priceRabbit}=${cost} ₽.`);
  }
  if(v==='parent_future'){
   const parent=r(32,50),child=r(7,17),S=parent+child,D=parent-child,t=r(4,9);
   return mk(raw,v,{parent,child,S,D,t},`Сумма возрастов родителя и ребёнка сейчас ${S} ${form(S,'год','года','лет')}. Родитель старше ребёнка на ${D} ${form(D,'год','года','лет')}. Сколько лет будет родителю через ${t} ${form(t,'год','года','лет')}?`,parent+t,`x+y=${S}, x−y=${D}. Родителю сейчас ${parent} ${form(parent,'год','года','лет')}, через ${t} ${form(t,'год','года','лет')} будет ${parent+t}.`);
  }
  if(v==='rectangle_extended'){
   const a=r(4,11),b=a+r(3,9),P=2*(a+b),D=b-a,extend=r(2,6);
   return mk(raw,v,{a,b,P,D,extend},`Периметр прямоугольника ${P} см, длина больше ширины на ${D} см. Длину увеличили на ${extend} см, ширину оставили прежней. Найди новую площадь в см².`,a*(b+extend),`Ширина x=${a}, длина y=${b}, поскольку x+y=${P/2}, y−x=${D}. Новая площадь ${a}·(${b}+${extend})=${a*(b+extend)} см².`);
  }
  if(v==='two_digit'){
   const tens=r(4,9),units=r(1,tens-1),S=tens+units,diff=9*(tens-units),num=10*tens+units;
   return mk(raw,v,{tens,units,S,diff,num},`Сумма цифр двузначного числа равна ${S}. Число на ${diff} больше числа, полученного перестановкой его цифр. Найди исходное двузначное число.`,num,`Для десятков x и единиц y: x+y=${S}, 9(x−y)=${diff}. Получаем x=${tens}, y=${units}; число ${num}.`);
  }
  if(v==='river_trip'){
   const boat=one([12,15,18,20]),current=one([2,3,4,5].filter(z=>z<boat)),down=boat+current,up=boat-current,L=down*up;
   return mk(raw,v,{boat,current,down,up,L},`Лодка за час проходит по течению ${down} км, против течения — ${up} км. На сколько часов путь длиной ${L} км против течения дольше, чем по течению?`,L/up-L/down,`Скорость лодки в стоячей воде (${down}+${up})/2=${boat}, течение (${down}−${up})/2=${current}. Время: против ${L}/${up}=${L/up} ч, по течению ${L}/${down}=${L/down} ч, разница ${L/up-L/down} ч.`);
  }
  if(v==='mixture'){
   const x=r(4,12),y=r(4,12),lo=one([10,15,20]),hi=one([30,40,50]),total=x+y,solute=lo*x+hi*y;
   if(hi<=lo)return words(v);
   return mk(raw,v,{x,y,lo,hi,total,solute},`Смешали ${total} л растворов с концентрациями ${lo}% и ${hi}%. В полученной смеси содержится ${String(solute/100).replace('.',',')} л растворённого вещества. Сколько литров раствора с концентрацией ${hi}% взяли?`,y,`Пусть x — объём ${lo}%-го, y — объём ${hi}%-го. Тогда x+y=${total}, ${lo}x+${hi}y=${solute} (в сотых долях литра). Получаем x=${x}, y=${y}.`);
  }
  if(v==='cyclist_distance'){
   const slow=r(9,18),fast=slow+r(4,12),t=r(2,5),sum=t*(slow+fast),gap=fast-slow,k=r(2,5);
   return mk(raw,v,{slow,fast,t,sum,gap,k},`Два велосипедиста одновременно выехали в противоположных направлениях. За ${t} ${form(t,'час','часа','часов')} расстояние между ними стало ${sum} км; скорость одного на ${gap} км/ч больше другого. Сколько километров проедет более быстрый за ${k} ${form(k,'час','часа','часов')}?`,fast*k,`Из t(v₁+v₂)=${sum} и v₂−v₁=${gap} находим v₁=${slow}, v₂=${fast} км/ч. За ${k} ч быстрый проедет ${fast*k} км.`);
  }
  if(v==='production'){
   const x=r(4,15),y=r(3,13),[a,b,c,d]=one([[2,3,3,2],[4,2,3,5],[2,5,4,3]]),p=a*x+b*y,q=c*x+d*y,t=r(3,6);
   return mk(raw,v,{x,y,a,b,c,d,p,q,t},`Первая мастерская выпускает x деталей в час, вторая — y. За ${a} ч работы первой и ${b} ч второй произведено ${p} деталей. За ${c} ч первой и ${d} ч второй — ${q} деталей. Сколько деталей изготовят обе мастерские вместе за ${t} ч?`,t*(x+y),`Получаем систему ${html(eq(a,b,p),eq(c,d,q))}. Решение x=${x}, y=${y} деталей в час. За ${t} ч вместе: (${x}+${y})·${t}=${t*(x+y)}.`);
  }
  throw Error('Unknown word scenario '+v);
 }
 function scenario(raw,v){if(raw==='linear_system_elimination')return elimination(v);if(raw==='nonlinear_systems_intro')return nonlinear(v);return words(v)}
 const plain=s=>{const el=document.createElement('div');el.innerHTML=String(s);return (el.textContent||'').replace(/\s+/g,' ').trim()};
 function unique(raw,v,used){for(let i=0;i<80;i++){
   const q=scenario(raw,v),txt=plain(q.text);
   if(q.ans==null||!q.ex||!txt||/\b(?:NaN|undefined|Infinity)\b/.test(q.text+' '+q.ex))throw Error('QA10 invalid '+raw+'/'+v);
   if(!used.has(txt)){return q}
  }throw Error('QA10 repeated statement '+raw+'/'+v)
 }
 function applyGrammar(q){if(q&&typeof q.text==='string')q.text=gramm(q.text);if(q&&typeof q.ex==='string')q.ex=gramm(q.ex);return q}
 makeG8Question=function(id,d=null){const raw=topic(id),stage=Number.isInteger(d)?d:activeDifficulty();
  if(!Object.prototype.hasOwnProperty.call(keys,raw)||!String(id).startsWith('g8:'))return prevMake(id,d);
  if(stage!==2)return applyGrammar(prevMake(id,d));
  return unique(raw,one(pools[raw]),new Set());
 };
 freshQuiz=function(id){const raw=topic(id),s=blockSession;
  if(!Object.prototype.hasOwnProperty.call(keys,raw)||!String(id).startsWith('g8:'))return prevFresh(id);
  if(!s||s.kind!=='g8quiz'||s.key!=='g8:'+raw||Number(s.stageIndex)!==2)return applyGrammar(prevFresh(id));
  const at=Number(s.done)||0;
  if(at<0||at>=10)return applyGrammar(prevFresh(id));
  let plan=s._qa10MasterPlan;
  if(!plan||plan.raw!==raw||plan.variants.length!==10){plan={raw,variants:shuffle(pools[raw])};s._qa10MasterPlan=plan}
  const used=new Set((s.items||[]).map(x=>plain(x.prompt||x.text||'')));
  const q=unique(raw,plan.variants[at],used);
  q._signature=q.sig;registerSignature(q.sig);return q;
 };
 const notes={
  linear_system_elimination:'<b>Уровень «Мастер»:</b> при сложении можно домножать обе строки на разные числа, используя НОК коэффициентов. Следи за изменением знаков при вычитании. Умножать нужно и правую часть. Также можно комбинировать уравнения, не решая их полностью.',
  nonlinear_systems_intro:'<b>Уровень «Мастер»:</b> приравнивай правые части, например x²=kx+b, и решай квадратное уравнение. Два различных корня дают две точки пересечения, один корень — касание, отсутствие действительных корней — отсутствие пересечений. У систем с xy и x+y используй квадратное уравнение.',
  systems_word_problems:'<b>Уровень «Мастер»:</b> сначала выбери две неизвестные, составь два независимых уравнения, реши систему и только затем вычисли искомую величину. Всегда проверяй единицы измерения, положительность количества и смысл полученного ответа.'
 };
 g8Lesson=function(id){const raw=topic(id);return !String(id).startsWith('g8:')||!notes[raw]?prevLesson(id):prevLesson(id)+'<div class="g8-qa10-note" style="margin-top:8px;padding:9px 11px;border:1px solid #cfe4d6;border-radius:11px;background:#f7fbf8">'+notes[raw]+'</div>'};
 window.G8_QA10_AUDIT={version:10,masterPlans:pools,topics:Object.keys(keys)};
})();

</script>

<script id="mk-g8-stage14-quality-final">
/* Only future grade-8 questions are normalized; question IDs, storage and finished attempts remain stable. */
(function(){'use strict';
 const forms=(n,one,few,many)=>{const k=Math.abs(n)%100,j=k%10;return k>=11&&k<=14?many:j===1?one:j>=2&&j<=4?few:many;};
 function grammar(text){
  if(typeof text!=='string')return text;
  const prev=(src,offset)=>src.slice(Math.max(0,offset-65),offset).replace(/<[^>]*>/g,'').toLowerCase();
  const genitive=before=>/(?:\bиз|\bдля|\bсреди|\bот|\bбез|\bпосле|\bоколо|\bменее|\bболее|\bсвыше|\bдо)\s*$/.test(before);
  // Agreement depends on the case. Keep already-correct phrases such as "из 4 исходов".
  const noun=(word,one,few,many,when)=>{
   const reg=new RegExp('\\b(\\d+)\\s+(?:'+word+')(?=[^а-яё]|$)','giu');
   text=text.replace(reg,(match,n,offset,src)=>{
    const context=prev(src,offset);if(genitive(context)||when&&!when(context))return match;
    return `${n} ${forms(+n,one,few,many)}`;
   });
  };
  noun('исходов|исхода|исход','исход','исхода','исходов',s=>/(?:входят|благоприятствуют|содержит|содержат|получились|получилось|всего|имеется|осталось)\s*$/.test(s));
  noun('рёбер|ребер|ребра|ребро','ребро','ребра','рёбер',s=>/(?:содержит|содержат|имеет|удалили|провели|добавили|добавлено|потребуется|нарисовали)\s*$/.test(s));
  noun('вершин|вершины|вершина','вершина','вершины','вершин',s=>/(?:имеет|содержит|всего|получилось|получились|добавили)\s*$/.test(s));
  noun('листьев|листа|лист','лист','листа','листьев',s=>/(?:имеет|всего|содержит|получилось|осталось|образовалось|найдено)\s*$/.test(s));
  noun('маршрутов|маршрута|маршрут','маршрут','маршрута','маршрутов',s=>/(?:получается|получилось|всего|получим|будет|образуется|содержит)\s*$/.test(s));
  noun('билетов|билета|билет','билет','билета','билетов',s=>/(?:купили|продали|осталось|всего|приобрели)\s*$/.test(s));
  noun('деталей|детали|деталь','деталь','детали','деталей',s=>/(?:всего|осталось|изготовили|сделали|собрали)\s*$/.test(s));
  text=text.replace(/из\s+(\d+)\s+(?:тетради|тетрадей)\b/giu,(_,n)=>`из ${n} тетрадей`);
  text=text.replace(/\b(\d+)\s+раза?(?=[^а-яё]|$)/giu,(_,n)=>`${n} ${forms(+n,'раз','раза','раз')}`);
  text=text.replace(/\b(\d+)\s+разных\s+(?:рёбер|ребер|ребра|ребро)(?=[^а-яё]|$)/giu,(match,n,offset,src)=>genitive(prev(src,offset))?match:`${n} ${forms(+n,'разное ребро','разных ребра','разных рёбер')}`);
  text=text.replace(/\b(\d+)\s+общих\s+(?:исходов|исхода|исход)(?=[^а-яё]|$)/giu,(_,n)=>`${n} ${forms(+n,'общий исход','общих исхода','общих исходов')}`);
  text=text.replace(/из них\s+(\d+)\s+общих\b/giu,(_,n)=>`из них ${n} ${forms(+n,'общий','общих','общих')}`);
  text=text.replace(/из\s+(\d+)\s+пары\s+обуви/giu,(_,n)=>`из ${n} пар обуви`);
  text=text.replace(/(\d+)\s*[·×]\s*(\d+)\s+маршрутов/giu,(_,a,b)=>`${a}·${b}=${Number(a)*Number(b)} ${forms(Number(a)*Number(b),'маршрут','маршрута','маршрутов')}`);
  return text;
 }
 function apply(q){if(!q||typeof q!=='object')return q;for(const key of ['text','ex','explanation'])if(typeof q[key]==='string')q[key]=grammar(q[key]);return q;}
 const MAKE=makeG8Question;makeG8Question=function(id,d){const q=MAKE(id,d);return rawCourseId(id)===String(id)&&!g8InfoById('g8:'+rawCourseId(id))?q:apply(q);};
 const FRESH=freshQuiz;
 const MEDIAN='median_doubling_method';
 const MEDIAN_PLANS=[
  ['find_ad','find_am','find_bc','transfer_bd','transfer_cd'],
  ['find_ad','find_bc','transfer_bd','transfer_cd','parallelogram_perimeter','find_ac_from_perimeter','triangle_perimeter'],
  ['parallelogram_perimeter','find_ac_from_perimeter','triangle_perimeter','angle_transfer','area_equal','half_and_side','perimeter_difference','two_medians','ratio_areas','length_expression']
 ];
 freshQuiz=function(id){const raw=rawCourseId(id);if(raw===MEDIAN&&blockSession&&blockSession.kind==='g8quiz'){
   const d=Math.max(0,Math.min(2,activeDifficulty())),i=Number(blockSession.done)||0,plan=MEDIAN_PLANS[d];
   if(i>=0&&i<plan.length){window.__mkG8MedianForced=plan[i];try{
    for(let trial=0;trial<100;trial++){
      const q=apply(g8Make811Median(MEDIAN,d));const sig=q.sig||`g8median:${d}:${plan[i]}:${q.text}`;
      if((blockSession.items||[]).some(z=>normalizePromptForCompare(z.prompt||'')===normalizePromptForCompare(q.text||'')))continue;
      if(q.sig)registerSignature(q.sig);q._signature=sig;return q;
    }
    throw Error('Could not build median exercise '+plan[i]);
   }finally{window.__mkG8MedianForced=null;}}
  }
  return apply(FRESH(id));
 };
})();
</script>

<script id="mk-g8-stage14-master-plus">
/* Content audit 11–13: replace residual elementary master prompts, without altering course IDs or saves. */
(function(){'use strict';
 const N=(lo,hi)=>Math.floor(Math.random()*(hi-lo+1))+lo;
 const P=a=>a[N(0,a.length-1)];
 const F=(s,a,e,tag)=>g7Number(s,a,e,'mk14master:'+tag+':'+a+':'+N(10000,99999));
 const C=(s,a,opts,e,tag)=>g7StrictChoice(s,a,opts,e,'mk14master:'+tag+':'+N(10000,99999),{});
 const makers={
  'equivalent_inequalities:max_integer':()=>{
   const a=N(2,5),b=N(-4,4),c=N(2,14),v=N(-6,8),right=a*(v+1+b)-c;
   return F(`Найди наибольшее целое решение неравенства ${a}(x${b>=0?'+':''}${b}) − ${c} < ${right}.`,v,`Раскрой скобки, перенеси слагаемые и раздели на ${a}: x < ${v+1}. Наибольшее целое решение — ${v}.`,'eqmax');
  },
  'equivalent_inequalities:min_integer':()=>{
   const a=N(2,6),b=N(-4,4),c=N(1,14),v=N(-6,8),right=a*(v-1+b)-c;
   return F(`Найди наименьшее целое решение неравенства ${a}(x${b>=0?'+':''}${b}) − ${c} > ${right}.`,v,`После равносильных преобразований получаем x > ${v-1}. Наименьшее целое решение — ${v}.`,'eqmin');
  },
  'linear_inequalities:select':()=>{
   const l=N(-8,2),r=l+N(3,10),a=N(2,5),b=N(2,5),c=N(1,5);
   return F(`Сколько целых x одновременно удовлетворяют двум неравенствам: ${a}(x − ${l}) ≥ 0 и ${b}(x − ${r}) ≤ 0?`,r-l+1,`Первое даёт x ≥ ${l}, второе — x ≤ ${r}. Целых решений ${r-l+1}.`,'linsystem');
  },
  'linear_inequalities:maximal':()=>{
   const a=N(2,6),b=N(-3,4),v=N(-8,8),right=a*(v+1+b);
   return F(`Найди наибольшее целое x, при котором ${a}(x${b>=0?'+':''}${b}) < ${right}.`,v,`Получаем x < ${v+1}, поэтому ответ ${v}.`,'linmax');
  },
  'linear_inequalities:minimal':()=>{
   const a=N(2,6),b=N(-3,4),v=N(-8,8),right=a*(v-1+b);
   return F(`Найди наименьшее целое x, при котором ${a}(x${b>=0?'+':''}${b}) > ${right}.`,v,`Получаем x > ${v-1}, поэтому ответ ${v}.`,'linmin');
  },
  'function_concept:is_function':()=>{
   const x=N(-4,4),a=N(2,5),b=N(-5,5),c=N(-6,6);
   const v=a*(x*x+b)+c;
   return F(`Заданы функции g(x)=x²${b>=0?'+':''}${b} и f(x)=${a}x${c>=0?'+':''}${c}. Найди f(g(${x})).`,v,`g(${x})=${x*x+b}; f(g(${x}))=${a}·${x*x+b}${c>=0?'+':''}${c}=${v}.`,'funcompose');
  },
  'function_concept:error':()=>{
   const x=N(-5,4), y=N(-4,6), same=Math.random()<.5;
   const other=same?y:y+P([-3,-2,-1,1,2,3]);const ans=same?'ДА':'НЕТ';
   return C(`Соответствие задано четырьмя парами: (${x};${y}), (${x+1};${y+2}), (${x};${other}), (${x+2};${y-1}). Является ли оно функцией?`,ans,[ans==='ДА'?'НЕТ':'ДА','невозможно определить'],same?'Повторяющемуся аргументу соответствует одно значение, поэтому это функция.':'Одному аргументу соответствуют разные значения, поэтому это не функция.','funerror');
  },
  'function_domain_range:domain_member':()=>{
   const l=N(-6,1),r=l+N(2,5),h=r+N(3,7),answer=h-l;
   return F(`Для функции y=√(x − (${l})) / (x − (${r})) найди количество целых x из отрезка [${l}; ${h}], принадлежащих области определения.`,answer,`Из корня следует x ≥ ${l}, а знаменатель исключает x=${r}. Из ${h-l+1} целых чисел исключаем одно: ${answer}.`,'domain');
  },
  'function_domain_range:range_member':()=>{
   const a=P([-4,-3,2,3,4]),b=N(-4,4),l=N(-5,0),h=l+N(4,9),answer=Math.abs(a)*(h-l);
   return F(`Функция f(x)=${a}x${b>=0?'+':''}${b} задана для целых x от ${l} до ${h} включительно. Найди разность наибольшего и наименьшего значений f.`,answer,`Приращение значения линейной функции на отрезке по модулю равно |${a}|·(${h}−(${l}))=${answer}.`,'range');
  },
