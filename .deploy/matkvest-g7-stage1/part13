  const number=g8AllTopics().findIndex(t=>t.id===topic.id)+1;
  const update=GUIDES[String(number)];
  if(!update)return source;
  const host=document.createElement('div');host.innerHTML=source;
  const blocks=[...host.querySelectorAll('p')];
  const kinds={intro:'Сначала смысл.',steps:'Как начать задание.',check:'Проверка.'};
  for(const [type,prefix] of Object.entries(kinds)){
   if(!update[type])continue;
   const match=blocks.find(p=>p.textContent.trim().startsWith(prefix));
   if(match){
    // Используем textContent, чтобы арифметические знаки < и > никогда
    // не интерпретировались HTML-парсером как начало тега.
    match.replaceChildren();
    const strong=document.createElement('b');strong.textContent=prefix;
    match.append(strong,document.createTextNode(' '+update[type]));
   }
  }
  return host.innerHTML;
 };
