   const total=choose([8,10,12,15,18,20]),nB=randint(3,total-2),nAB=randint(1,nB-1),pB=rational(nB,total),pAB=rational(nAB,total),ans=rational(nAB,nB);
   return mk(raw,d,v,g8E822Number(raw,d,v,`Известно P(B)=${g8E822Frac(pB)} и P(A∩B)=${g8E822Frac(pAB)}. Найди условную вероятность P(A|B).`,ans,
