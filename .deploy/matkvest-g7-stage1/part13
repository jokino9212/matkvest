   if(variant==='belong')return makeChoice(raw,d,variant,`Окружность имеет центр O и радиус ${r} см. Не показанная на рисунке точка P находится от O на расстоянии ${dist} см. Принадлежит ли P этой окружности?`,offset===0?'ДА':'НЕТ',['ДА','НЕТ'].filter(x=>x!==(offset===0?'ДА':'НЕТ')),`Принадлежность окружности требует OP = r. Здесь OP = ${dist} см, r = ${r} см, поэтому ответ: <b>${offset===0?'ДА':'НЕТ'}</b>.`,[r,dist],data);
   if(variant==='classify'){
    const ans=offset===0?'на окружности':offset<0?'внутри круга':'вне круга';
    return makeChoice(raw,d,variant,`Радиус круга с центром O равен ${r} см. Не показанная на рисунке точка P находится от центра на расстоянии ${dist} см. Где P?`,ans,['на окружности','внутри круга','вне круга'].filter(x=>x!==ans),`Сравниваем OP и r: ${dist} ${offset===0?'=':offset<0?'<':'>'} ${r}, значит P <b>${ans}</b>.`,[r,dist],data);
   }
   const ans=choose(['окружность','круг']);
   const question=ans==='окружность'?`Какое множество образуют все точки, удалённые от O ровно на ${r} см?`:`Какое множество образуют все точки, удалённые от O не более чем на ${r} см?`;
   return makeChoice(raw,d,variant,question,ans,['окружность','круг','прямая','отрезок'].filter(x=>x!==ans),ans==='окружность'?'Равное фиксированное расстояние от центра определяет окружность (границу круга).':'Расстояние не больше радиуса включает границу и все внутренние точки круга.',[r,ans],data);
  }
  if(raw==='geo_circumcircle_triangle'){
   const variant=choose(d===0?['radii','radius']:d===1?['radii','diameter','radius']:['right','radius','diameter']);
   const r=ri(3+d,13+3*d), data=g7CircleTopicData('g7-circumcircle',{points:variant==='right'||variant==='radius'?{A:{x:230,y:110},B:{x:450,y:290},C:{x:230,y:290}}:{A:{x:320,y:78},B:{x:155,y:300},C:{x:485,y:300}},showRadii:d>0});
   if(variant==='radii')return makeNumber(raw,d,variant,`O — центр окружности, описанной около △ABC. Если OA = ${r} см, найди OC.`,r,`OA и OC — радиусы одной окружности. Поэтому OC = OA = <b>${r} см</b>.`,[r],data,'OA=OB=OC.','см');
   if(variant==='diameter')return makeNumber(raw,d,variant,`Около прямоугольного треугольника ABC (∠C=90°) описана окружность радиуса ${r} см. Найди гипотенузу AB.`,2*r,`В прямоугольном треугольнике гипотенуза — диаметр описанной окружности: AB = 2R = 2 · ${r} = <b>${2*r} см</b>.`,[r],g7CircleTopicData('g7-circumcircle',{points:{A:{x:230,y:110},B:{x:450,y:290},C:{x:230,y:290}},showRadii:true}),'AB — диаметр описанной окружности.','см');
   if(variant==='radius')return makeNumber(raw,d,variant,`△ABC прямоугольный (∠C=90°), гипотенуза AB = ${2*r} см. Найди радиус описанной окружности.`,r,`Центр O лежит в середине гипотенузы. Радиус равен её половине: R = ${2*r} : 2 = <b>${r} см</b>.`,[r],data,'O — середина AB.','см');
   return makeNumber(raw,d,variant,`O — середина гипотенузы AB прямоугольного △ABC. Если OB = ${r} см, чему равна длина AB?`,2*r,`В прямоугольном треугольнике O — центр описанной окружности и середина гипотенузы, поэтому AB = 2 · OB = <b>${2*r} см</b>.`,[r],data,'AO = OB = OC.','см');
  }
  return null;
 }
 makeG7Question=function(id,stageOverride=null){
  const raw=rawCourseId(id),d=Math.max(0,Math.min(2,Number.isInteger(stageOverride)?stageOverride:activeDifficulty()));
  if(!targeted.has(raw)||Math.random()<0.08)return previousG7(id,stageOverride);
  const q=newQuestion(raw,d);
  return q?gPolishQuestionObject(q):previousG7(id,stageOverride);
 };
})();
