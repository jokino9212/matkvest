   case 'two_shadow_times':{const u=rnd(2,6),z=rnd(2,5),H=u*k;return number(raw,d,v,`В полдень рейка ${u} м даёт тень ${a} м, а дерево — ${a*k} м. Позже тень дерева стала ${b*k*z} м. Найди длину тени той же рейки позже.`,b*z,`Высота дерева H=${u}·${k}=${H} м. Позже отношение высот ${H}:${u}=${k}, поэтому тень рейки ${b*k*z}:${k}=${b*z} м.`,null,'м');}
   case 'nested_similarity':{const x=rnd(3,10),mult=rnd(2,4);return N(`В треугольнике ABC отрезок DE∥BC, AD:AB=1:${mult}. Если BC=${x*mult} см, а второй такой же масштабный переход увеличивает результат в ${k} раза, чему равна последняя длина?`,x*k,`DE=BC/${mult}=${x} см; после увеличения DE·${k}=${x*k} см.`);}
