  if(raw==='conditional_probability'&&v==='practical'){
   const total=randint(18,32),girls=randint(8,total-5),music=randint(2,girls-2),ans=rational(music,girls);
   return mk(raw,d,v,g8E822Number(raw,d,v,`В группе ${total} учеников: ${girls} девочек, из них ${music} занимаются музыкой. Случайно выбранный ученик оказался девочкой. Найди вероятность того, что она занимается музыкой.`,ans,
