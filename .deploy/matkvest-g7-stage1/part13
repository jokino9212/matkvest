   return mk(raw,d,v,g8E822Number(raw,d,v,`Дано P(A)=${g8E822Frac(pA)}, P(A∩B)=${g8E822Frac(joint)}. Найди P(B|A).`,cond,
    `P(B|A)=P(A∩B)/P(A)=(${g8E822Frac(joint)})/(${g8E822Frac(pA)})=${g8E822Frac(cond)}.`,{pA,joint,cond}));
