  if(raw==='probability_multiplication_rule'&&v==='cards_without_return'){
   const n=randint(4,12),first=randint(1,n);
   const secondCard=choose(Array.from({length:n},(_,i)=>i+1).filter(x=>x!==first)),ans=rational(1,n*(n-1));
   return mk(raw,d,v,g8E822Number(raw,d,v,`Из ${n} пронумерованных карточек выбирают две подряд без возвращения. Найди вероятность сначала вытянуть карточку №${first}, затем №${secondCard}.`,ans,
    `Первую указанную карточку выбирают с вероятностью 1/${n}. После этого среди ${n-1} оставшихся карточек одна нужная: вероятность 1/${n-1}. Произведение ${g8E822Frac(ans)}.`,{n,first,second:secondCard,ans}));
  }
  if(raw==='probability_multiplication_rule'&&v==='dependent_balls'){
   const red=randint(2,8),blue=randint(2,9),total=red+blue,ans=rational(red*blue,total*(total-1));
   return mk(raw,d,v,g8E822Number(raw,d,v,`В мешке ${red} красных и ${blue} синих шаров. Достают два шара без возвращения. Найди вероятность: первый красный, второй синий.`,ans,
    `Вероятности последовательных шагов: ${red}/${total} и ${blue}/${total-1}. Умножаем: ${g8E822Frac(ans)}.`,{red,blue,total,ans}));
  }
  if(raw==='probability_multiplication_rule'&&v==='reverse_conditional'){
   const a=randint(1,4),b=randint(1,5),pA=rational(a,6),cond=rational(b,7),joint=rational(a*b,42);
   return mk(raw,d,v,g8E822Number(raw,d,v,`Дано P(A)=${g8E822Frac(pA)} и P(B|A)=${g8E822Frac(cond)}. Найди P(A∩B).`,joint,
    `По правилу умножения P(A∩B)=P(A)·P(B|A)=${g8E822Frac(pA)}·${g8E822Frac(cond)}=${g8E822Frac(joint)}.`,{pA,cond,joint}));
