}
function teacherRandomSalt(){
 try{if(globalThis.crypto?.getRandomValues){const a=new Uint8Array(16);crypto.getRandomValues(a);return [...a].map(x=>x.toString(16).padStart(2,"0")).join("")}}catch(e){}
 return `${Date.now().toString(36)}_${Math.random().toString(36).slice(2)}_${Math.random().toString(36).slice(2)}`;
}
async function teacherSha256(text){
 try{if(globalThis.crypto?.subtle&&globalThis.TextEncoder){const data=new TextEncoder().encode(String(text||"")),buf=await crypto.subtle.digest("SHA-256",data);return [...new Uint8Array(buf)].map(x=>x.toString(16).padStart(2,"0")).join("")}}catch(e){}
 return "";
}
async function setTeacherPinValue(pin){
