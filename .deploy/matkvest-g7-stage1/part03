function purchasableStickerItems(){return SHOP_CATALOG.stickers.filter(x=>!x.rewardOnly)}
function profileInventoryHas(profile,type,id){return Array.isArray(profile?.inventory?.[type])&&profile.inventory[type].includes(id)}
function achievementUnlockView(profile){const src=profile?.achievementUnlocks&&typeof profile.achievementUnlocks==="object"&&!Array.isArray(profile.achievementUnlocks)?profile.achievementUnlocks:{},out={};for(const [id,v] of Object.entries(src)){if(v&&typeof v==="object")out[id]={unlockedAt:Number(v.unlockedAt||0)||null,rewardGranted:v.rewardGranted!==false,legacy:!!v.legacy};else if(v)out[id]={unlockedAt:null,rewardGranted:true,legacy:true}}for(const a of ACHIEVEMENTS){if(a.rewardType&&a.rewardId&&profileInventoryHas(profile,a.rewardType,a.rewardId)&&!out[a.id])out[a.id]={unlockedAt:null,rewardGranted:true,legacy:true}}return out}
function normalizeAchievementUnlocks(profile){if(!profile||typeof profile!=="object")return {};profile.achievementUnlocks=achievementUnlockView(profile);return profile.achievementUnlocks}
function profileDirectBest(profile,key){const cp=profile?.courseProgress||{},k=courseKey(key),p=cp[k]||cp[key]||{};return Array.isArray(p.best)?p.best:[0,0,0]}
function profileDirectStagePassed(profile,key,i){const needs=[4,5,8];return Number(profileDirectBest(profile,key)[i]||0)>=Number(needs[i]||0)}
