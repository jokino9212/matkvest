 teacherSettings={enabled:true,pinHash:sha||fallback,pinFallbackHash:fallback,pinSalt:salt,pinAlgo:sha?"sha256":"fallback"};saveTeacherSettings();return true;
}
async function verifyTeacherPinValue(pin){
