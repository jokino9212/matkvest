function normalizeTeacherSettings(v){
 const x=(v&&typeof v==="object")?v:{};
 return {enabled:!!x.enabled,pinHash:String(x.pinHash||""),pinFallbackHash:String(x.pinFallbackHash||""),pinSalt:String(x.pinSalt||""),pinAlgo:String(x.pinAlgo||"")};
}
function saveTeacherSettings(){
 teacherSettings=normalizeTeacherSettings(teacherSettings);appSettings=(appSettings&&typeof appSettings==="object")?appSettings:{};appSettings.teacherSettings=deepCopy(teacherSettings);
 try{localStorage.setItem(APP_SETTINGS_KEY,JSON.stringify(appSettings))}catch(e){reportStorageError(e,true)}
}
function teacherFallbackHash(text){
 let h1=2166136261>>>0,h2=2246822519>>>0;const str=String(text||"");
 for(let i=0;i<str.length;i++){const c=str.charCodeAt(i);h1=Math.imul(h1^c,16777619)>>>0;h2=Math.imul(h2^c,3266489917)>>>0;h2=((h2<<13)|(h2>>>19))>>>0}
