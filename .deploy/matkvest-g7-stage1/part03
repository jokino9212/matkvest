function migrateUnifiedProfile(p){
 if(!p||typeof p!=="object")return p;
 p.courseProgress=p.courseProgress||{};
 for(const k of Object.keys(p.courseProgress)){
   if(!isNamespacedKey(k)){
     const nk=`g4:${k}`;
