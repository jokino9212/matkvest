function wasUsedInBlock(sig){
 return !!blockSession?.usedSignatures?.includes(sig);
}
function wasRecent(sig){
 return historyList().includes(sig);
}
function registerSignature(sig){
 if(!sig)return;
 if(blockSession && !blockSession.usedSignatures.includes(sig))blockSession.usedSignatures.push(sig);
 const h=historyList();
 const i=h.indexOf(sig);if(i>=0)h.splice(i,1);
 h.unshift(sig);
 if(h.length>60)h.length=60;
}
function freshCandidate(generator,signatureFn,maxTries=120){
 let candidate=null,sig="";
 // Сначала ищем задачу, которой не было ни в текущем блоке, ни недавно.
 for(let i=0;i<maxTries;i++){
   candidate=generator();sig=signatureFn(candidate);
   if(!wasUsedInBlock(sig)&&!wasRecent(sig)){registerSignature(sig);candidate._signature=sig;return candidate}
 }
 // Если недавняя история исчерпала небольшой пул (например таблицу умножения),
 // разрешаем старую задачу, но всё равно НЕ повторяем её внутри текущего блока.
 const mostRecent=historyList()[0]||"";
 for(let i=0;i<maxTries;i++){
   candidate=generator();sig=signatureFn(candidate);
   if(!wasUsedInBlock(sig)&&sig!==mostRecent){registerSignature(sig);candidate._signature=sig;return candidate}
 }
 // Защитный bounded fallback: даже при исчерпанном маленьком пуле стараемся
 // не повторить буквально предыдущий вопрос.
 for(let i=0;i<Math.min(30,maxTries);i++){
   candidate=generator();sig=signatureFn(candidate);
   if(sig!==mostRecent){registerSignature(sig);candidate._signature=sig;return candidate}
 }
 candidate=generator();sig=signatureFn(candidate);registerSignature(sig);candidate._signature=sig;return candidate;
}
function recordBlockItem(firstTry){
 if(!blockSession)return false;
 if(blockSession.finished)return true;
 blockSession.done=Math.min(blockSession.total,blockSession.done+1);
 if(firstTry)blockSession.correct=Math.min(blockSession.done,blockSession.correct+1);
 if(blockSession.done>=blockSession.total){
