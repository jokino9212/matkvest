function stableIdHash(s){
 let h=2166136261;for(const ch of String(s||"")){h^=ch.charCodeAt(0);h=Math.imul(h,16777619)}
 return (h>>>0).toString(36);
}
function newAttemptItemId(){
 try{if(globalThis.crypto?.randomUUID)return "item_"+crypto.randomUUID()}catch(e){}
 return `item_${Date.now().toString(36)}_${Math.random().toString(36).slice(2,10)}`;
}
function normalizeRemediation(rem){
 if(!rem||typeof rem!=="object")return null;
 return {
   resolved:!!rem.resolved,
   resolvedAt:rem.resolvedAt?Number(rem.resolvedAt):null,
   resolvedAttemptId:rem.resolvedAttemptId||null,
   lastAttemptAt:rem.lastAttemptAt?Number(rem.lastAttemptAt):null,
   lastAttemptId:rem.lastAttemptId||null,
   lastResult:rem.lastResult||null,
   attempts:Math.max(0,Number(rem.attempts||0))
 };
}
function ensureAttemptItemIds(profile){
 if(!profile||typeof profile!=="object")return profile;
 const normalizeRecord=r=>{
   if(!r||typeof r!=="object")return;
   // Для старых backup ID выводится только из устойчивых свойств самой попытки,
   // а не из её позиции в массиве. Поэтому одинаковая старая попытка получит
   // одинаковый ID даже после сортировки или импорта на другом компьютере.
   if(!r.id)r.id=`legacy_a_${stableIdHash(`${r.startedAt||0}|${r.key||""}|${r.stageIndex??""}|${r.kind||""}|${r.topicId||""}|${r.total||""}`)}`;
   const fixItem=item=>{
     if(!item||typeof item!=="object")return;
     if(!item.itemId)item.itemId=`legacy_i_${stableIdHash(`${r.id}|${item.index||""}|${item.startedAt||0}|${stripHtmlText(item.prompt||"")}|${item.correctAnswer||""}|${item.taskMode||""}`)}`;
     if(item.remediation)item.remediation=normalizeRemediation(item.remediation);
   };
   (Array.isArray(r.items)?r.items:[]).forEach(fixItem);
   if(r.currentItem)fixItem(r.currentItem);
 };
 (Array.isArray(profile.attemptHistory)?profile.attemptHistory:[]).forEach(normalizeRecord);
 if(profile.activeAttempt)normalizeRecord(profile.activeAttempt);
 return profile;
}
