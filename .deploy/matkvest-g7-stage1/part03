function ensureCourse(){state.courseProgress=state.courseProgress||{};return state.courseProgress}
function progressFor(key){
 const cp=ensureCourse(),k=courseKey(key);
 if(!cp[k])cp[k]={best:[0,0,0],bonus:[false,false,false]};
 if(!Array.isArray(cp[k].best))cp[k].best=[0,0,0];
 if(!Array.isArray(cp[k].bonus))cp[k].bonus=[false,false,false];
 return cp[k];
}
function stagePassed(key,i){return (progressFor(key).best[i]||0)>=STAGES[i].need}
function stageUnlocked(key,i){return i===0||stagePassed(key,i-1)}
function completedStages(key){return STAGES.filter((_,i)=>stagePassed(key,i)).length}
function columnCompleted(){return ["add","sub","mul","div"].reduce((s,m)=>s+completedStages("column:"+m),0)}
function topicProgressText(id){
 if(id==="column")return `${columnCompleted()}/12 этапов`;
 return `${completedStages(id)}/3 этапа`;
}
