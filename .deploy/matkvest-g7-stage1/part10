function mk870SelectOptions(){return Object.keys(profiles).sort((a,b)=>a.localeCompare(b,'ru')).map(n=>`<option value="${esc(n)}" ${n===currentProfile?'selected':''}>${esc(n)}${profiles[n]?.developerTestProfile?' [TEST]':''}</option>`).join('')}
