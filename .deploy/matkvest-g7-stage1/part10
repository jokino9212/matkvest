<script id="mk872-avatar-zoom-script">
(function(){
 'use strict';
 const viewer=document.getElementById('mk872AvatarViewer');
 const visual=document.getElementById('mk872ViewerVisual');
 const title=document.getElementById('mk872ViewerTitle');
 const closeButton=viewer.querySelector('.mk872-viewer-close');
 let previousFocus=null;
 function targetFor(node){
   const avatar=node.closest('.avatar-badge');
   if(avatar && !avatar.closest('#mk872AvatarViewer'))return avatar;
   const shop=node.closest('.mk868-final-hero-card .shop-icon');
   if(shop && !shop.closest('#mk872AvatarViewer'))return shop;
   return null;
 }
 function getName(target){
   const image=target.querySelector('img.mk868-avatar-img');
   const card=target.closest('.mk868-final-hero-card');
   if(card){const name=card.querySelector('strong');if(name?.textContent.trim())return name.textContent.trim()}
   return image?.getAttribute('alt')?.trim()||'Аватар';
 }
 function open(target){
   const image=target.querySelector('img.mk868-avatar-img');
   visual.replaceChildren();
   if(image){
     const enlarged=document.createElement('img');
     enlarged.className='mk872-viewer-image';
     enlarged.src=image.currentSrc||image.src;
     enlarged.alt=image.alt||'Аватар';
     enlarged.draggable=false;
     visual.append(enlarged);
   }else{
     const emoji=document.createElement('div');
     emoji.className='mk872-viewer-emoji';
     const core=target.querySelector('.avatar-core')||target;
     emoji.textContent=core.textContent.trim()||'🙂';
     visual.append(emoji);
   }
   title.textContent=getName(target);
   previousFocus=document.activeElement;
   viewer.classList.add('mk872-open');
   viewer.setAttribute('aria-hidden','false');
   closeButton.focus({preventScroll:true});
 }
 function close(){
   if(!viewer.classList.contains('mk872-open'))return;
   viewer.classList.remove('mk872-open');
   viewer.setAttribute('aria-hidden','true');
   visual.replaceChildren();
   if(previousFocus?.isConnected)previousFocus.focus({preventScroll:true});
   previousFocus=null;
 }
 document.addEventListener('click',function(event){
   if(viewer.contains(event.target))return;
   const target=targetFor(event.target);
   if(!target)return;
   event.preventDefault();event.stopPropagation();
   open(target);
 },true);
 document.addEventListener('keydown',function(event){
   if(event.key==='Escape'&&viewer.classList.contains('mk872-open')){event.preventDefault();event.stopPropagation();close();return}
   if(event.key==='Tab'&&viewer.classList.contains('mk872-open')){event.preventDefault();closeButton.focus();return}
   if((event.key==='Enter'||event.key===' ')&&!viewer.classList.contains('mk872-open')){
     const target=targetFor(event.target);
     if(target&&event.target===target){event.preventDefault();open(target)}
   }
 },true);
 viewer.addEventListener('click',function(event){if(event.target===viewer||event.target===closeButton)close()});
 // Rendered avatars are replaced by existing screens; refresh keyboard affordances dynamically.
 function mark(root){
   if(root.nodeType!==1&&root.nodeType!==9)return;
   const targets=[];
   if(root.nodeType===1 && root.matches?.('.avatar-badge,.mk868-final-hero-card .shop-icon'))targets.push(root);
   root.querySelectorAll?.('.avatar-badge,.mk868-final-hero-card .shop-icon').forEach(el=>targets.push(el));
   targets.forEach(el=>{if(el.closest('#mk872AvatarViewer'))return;el.classList.add('mk872-viewable');if(!el.hasAttribute('tabindex'))el.setAttribute('tabindex','0');if(!el.hasAttribute('title'))el.setAttribute('title','Нажмите, чтобы увеличить аватар');});
 }
 mark(document);
 const observer=new MutationObserver(records=>{records.forEach(r=>r.addedNodes.forEach(mark))});
 observer.observe(document.body,{childList:true,subtree:true});
})();
</script>


