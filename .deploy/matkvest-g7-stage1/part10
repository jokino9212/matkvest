function mk870Disable(){mk870ClosePanel();developerModeEnabled=false;try{localStorage.removeItem('mq_dev_mode_enabled_870')}catch(_){}if(state?.developerTestProfile){const regular=Object.keys(profiles).find(n=>!profiles[n]?.developerTestProfile);if(regular){currentProfile=regular;state={...EMPTY_STATE,...profiles[regular]};mk870CommitAnySelection();}}mk870RefreshButton();openProfiles()}
