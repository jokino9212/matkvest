      p.equipped ||= {};
      if(p.equipped.avatar!==entry.id){p.equipped.avatar=entry.id;repaired=true;}
    }
  }
  for(const p of Object.values(profiles))normalizeProfileShopData(p,{syncRewards:false});
  if(profiles[currentProfile]){
    state.inventory=deepCopy(profiles[currentProfile].inventory);
    state.equipped=deepCopy(profiles[currentProfile].equipped);
    normalizeProfileShopData(state,{syncRewards:false});
  }
  if(repaired){try{localStorage.setItem('mq4_profiles',JSON.stringify(profiles));localStorage.setItem('mq4',JSON.stringify(state))}catch(e){reportStorageError(e,true)}}

  // Canonical source: profile.equipped.avatar, persisted by the existing save() mechanism.
  const oldAvatarHtml=avatarHtml;
  avatarHtml=function(p=state,size=''){
    // Suppress face and head overlays for ALL heroes (including legacy artworks).
    const html=oldAvatarHtml(p,size);
    return html.replace(/<span class="avatar-accessory-layer">[\s\S]*?<\/span><\/span>/g,'');
  };
  mk855AccessoryLayer=function(){return ''};
  const oldShopTabs=shopTabs;
  shopTabs=function(active){return oldShopTabs(active==='accessories'?'avatars':active).replace(/<button class="shop-tab[^>]*onclick="openShop\('accessories'\)"[^>]*>[\s\S]*?<\/button>/g,'')};
  const oldOpenShop=openShop;
  openShop=function(category='avatars',rarity=null){return oldOpenShop(category==='accessories'?'avatars':category,rarity)};
  const oldShopCard=shopCard;
  shopCard=function(type,item){return type==='accessories'?'':oldShopCard(type,item)};
  const oldCollection=openCollection;
  openCollection=function(){
    oldCollection();
    const root=modal;
    root.querySelectorAll('[data-mk855-extra]').forEach(el=>{if(/аксессуар/i.test(el.textContent||''))el.remove()});
    root.querySelectorAll('.mk855-collection-extra .album-head').forEach(el=>{
      if(/аксессуар/i.test(el.textContent||'')){const next=el.nextElementSibling;el.remove();if(next?.classList.contains('cosmetic-owned-grid'))next.remove()}
    });
  };
  const oldShopPreview=shopPreview;
  shopPreview=function(){return oldShopPreview().replace(/<b>Аксессуар:<\/b>[\s\S]*? • /,'')};
  const oldBuy=buyShopItem,oldEquip=equipShopItem;
  buyShopItem=function(type,id){if(type==='accessories')return;return oldBuy(type,id)};
  equipShopItem=function(type,id){if(type==='accessories')return;return oldEquip(type,id)};
  const oldGrant=mk870GrantItems;
