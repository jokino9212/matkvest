<script id="mk872-catalog-legacy-hotfix">
/* Stable global catalog, shared by all profiles; ownership is profile-specific. */
const MK872_MODERN_HERO_IDS=Object.freeze([...MK868_FINAL_HERO_IDS]);
const MK872_MODERN_HERO_SET=new Set(MK872_MODERN_HERO_IDS);
function mk872ModernCatalog(){return MK872_MODERN_HERO_IDS.map(id=>catalogItem('avatars',id)).filter(Boolean)}
for(const item of SHOP_CATALOG.avatars){
  const current=MK872_MODERN_HERO_SET.has(item.id);
  item.hiddenInStore=!current;item.legacyHero=!current;item.finalHero=current;
  if(!current)item.chestEligible=false;
}
/* The actual Store hero enumeration always comes from the global registry. */
filteredShopItems=function(category){
 if(category!=='avatars'){
  const items=(SHOP_CATALOG[category]||[]);
  return shopRarityFilter==='all'?items:shopRarityFilter==='reward'?items.filter(x=>x.rewardOnly):items.filter(x=>x.rarity===shopRarityFilter);
 }
 const rank={common:0,uncommon:1,rare:2,epic:3,legendary:4};
 const items=mk872ModernCatalog();
 return items.filter(x=>shopRarityFilter==='all'||(shopRarityFilter==='reward'?!!x.rewardOnly:x.rarity===shopRarityFilter))
  .sort((a,b)=>(rank[a.rarity]??9)-(rank[b.rarity]??9)||Number(a.level||0)-Number(b.level||0)||Number(a.price||0)-Number(b.price||0)||a.name.localeCompare(b.name,'ru'));
};
/* Manual DEV-only cleanup; never auto-delete historically earned legacy items. */
function mk872LegacyItems(profile){
 const inv=profile?.inventory||{};
 return [
  ...(inv.avatars||[]).filter(id=>id!=='av_default'&&!MK872_MODERN_HERO_SET.has(id)&&!!catalogItem('avatars',id)).map(id=>({type:'avatars',id})),
  ...(inv.accessories||[]).filter(id=>id!=='acc_none'&&!!catalogItem('accessories',id)).map(id=>({type:'accessories',id}))
 ];
}
function mk872LegacyPanel(){
 const items=mk872LegacyItems(state);
 return `<section class="mk872-legacy-info"><b>Старые предметы (Legacy Cleanup)</b><div>Выбранный профиль: <b>${esc(currentProfile)}</b></div><div>Найдено старых предметов: <b>${items.length}</b></div><small>Очистка затронет только выбранного ученика. Исторические предметы не удаляются автоматически.</small><button type="button" class="btn soft" ${items.length?'':'disabled'} onclick="mk872CleanLegacy()">Очистить legacy-предметы</button></section>`;
}
const MK872_PRE_OPEN_DEVELOPER_PANEL=openDeveloperPanel;
openDeveloperPanel=function(){
 MK872_PRE_OPEN_DEVELOPER_PANEL();
 if(!developerModeEnabled)return;
 const body=document.getElementById('mk870PanelBody');
 if(body){const section=document.createElement('div');section.id='mk872LegacyPanel';section.innerHTML=mk872LegacyPanel();body.appendChild(section)}
};
function mk872CleanLegacy(){
 if(!developerModeEnabled)return;
 const items=mk872LegacyItems(state);
 if(!items.length)return;
 if(!confirm(`Удалить ${items.length} старых предметов только у профиля «${currentProfile}»? Историческое владение будет потеряно.`))return;
 const next=deepCopy(state);
 next.inventory ||= {};next.equipped ||= {};
 const avatars=new Set(items.filter(x=>x.type==='avatars').map(x=>x.id));
 if(avatars.has(next.equipped.avatar))next.equipped.avatar='av_default';
 for(const type of ['avatars','accessories']){
  const remove=new Set(items.filter(x=>x.type===type).map(x=>x.id));
  next.inventory[type]=(next.inventory[type]||[]).filter(id=>!remove.has(id));
 }
 if(items.some(x=>x.type==='accessories'&&x.id===next.equipped.accessory))next.equipped.accessory='acc_none';
 next.chestOwnedIds=(next.chestOwnedIds||[]).filter(id=>!items.some(x=>x.id===id));
 next.developerGrantedItems=(next.developerGrantedItems||[]).filter(key=>!items.some(x=>key===`${x.type}:${x.id}`));
 normalizeProfileShopData(next,{syncRewards:false});
 const nextProfiles={...profiles,[currentProfile]:next};
 try{
  localStorage.setItem('mq4_profiles',JSON.stringify(nextProfiles));
  localStorage.setItem('mq4_current_profile',currentProfile);
  localStorage.setItem('mq4',JSON.stringify(next));
 }catch(e){reportStorageError(e,true);return}
 profiles=nextProfiles;state=next;stats();openDeveloperPanel();
 mk870Error(`Очищено старых предметов: ${items.length}.`);
}
</script>

