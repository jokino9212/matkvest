function mk870SnapshotKey(){return MK870_SNAP_PREFIX+String(state.profileId||currentProfile)}
function mk870Snapshot(){if(!mk870TestOnly())return;mk870CommitProfile();try{localStorage.setItem(mk870SnapshotKey(),JSON.stringify(state))}catch(e){mk870Error('Не удалось сохранить снимок');return}mk870Error('Тестовый снимок сохранён')}
function mk870RestoreSnapshot(){if(!mk870TestOnly())return;let snap;try{snap=JSON.parse(localStorage.getItem(mk870SnapshotKey())||'null')}catch(_){}if(!snap||snap.developerTestProfile!==true){mk870Error('Снимок не найден');return}state={...EMPTY_STATE,...snap,profileId:state.profileId,developerTestProfile:true};normalizeShop();mk870CommitProfile();openDeveloperPanel()}
