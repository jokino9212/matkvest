<script id="mk-dev-access-script">
/* Локальная защита от случайного входа, не система безопасности. */
const DEV_ACCESS_CODE = '24-06';
let developerModeEnabled = (()=>{try{return localStorage.getItem('mq_dev_mode_enabled_870')==='1'}catch(_){return false}})();
(function(){
 const badge=document.getElementById('appVersionBadge');
 const overlay=document.getElementById('devAccessOverlay');
 const form=document.getElementById('devAccessForm');
 const input=document.getElementById('devAccessInput');
 const error=document.getElementById('devAccessError');
 const cancel=document.getElementById('devAccessCancel');
 if(!badge||!overlay||!form||!input||!error||!cancel)return;
 let count=0,firstAt=0;
 function close(){overlay.classList.remove('open');overlay.setAttribute('aria-hidden','true');input.value='';error.textContent='';badge.focus();}
 function open(){overlay.classList.add('open');overlay.setAttribute('aria-hidden','false');input.value='';error.textContent='';input.focus();}
 badge.setAttribute('tabindex','0');badge.setAttribute('role','button');
 badge.setAttribute('aria-label','Версия приложения');
 badge.addEventListener('click',()=>{
  const now=Date.now();
  if(!firstAt||now-firstAt>3000){firstAt=now;count=0;}
  if(++count===7){count=0;firstAt=0;open();}
 });
 badge.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();badge.click();}});
 form.addEventListener('submit',e=>{
  e.preventDefault();
  if(input.value===DEV_ACCESS_CODE){developerModeEnabled=true;try{localStorage.setItem('mq_dev_mode_enabled_870','1')}catch(_){}document.documentElement.dataset.developerMode='enabled';close();badge.title='Developer Mode включён';mk870RefreshButton();openDeveloperPanel();}
  else{error.textContent='Неверный код';input.value='';input.focus();}
 });
 cancel.addEventListener('click',close);
 overlay.addEventListener('click',e=>{if(e.target===overlay)close();});
 document.addEventListener('keydown',e=>{if(e.key==='Escape'&&overlay.classList.contains('open'))close();});
})();
</script>


