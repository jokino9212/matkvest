function mk870TestActions(){return `<div class="mk870-group"><h3>Монеты — только тестовый профиль</h3><div class="mk870-actions">${[100,500,1000,5000].map(n=>mk870Btn('+'+n,'mk870Coins('+n+')')).join('')}</div><div class="mk870-field"><input id="mk870CoinsInput" type="number" step="1" min="0" placeholder="Точное количество">${mk870Btn('Установить монеты','mk870SetValue(\'coins\',\'mk870CoinsInput\')')}</div></div>
 <div class="mk870-group"><h3>Опыт и уровень</h3><div class="mk870-actions">${[100,500,1000].map(n=>mk870Btn('+'+n+' XP','mk870Xp('+n+')')).join('')}</div><div class="mk870-field"><input id="mk870XpInput" type="number" step="1" min="0" placeholder="Точный XP">${mk870Btn('Установить XP','mk870SetValue(\'xp\',\'mk870XpInput\')')}</div><div class="mk870-actions" style="margin-top:8px">${[1,5,10,15,20,30].map(n=>mk870Btn('ур. '+n,'mk870Level('+n+')')).join('')}</div></div>
 <div class="mk870-group"><h3>Готовые состояния</h3><div class="mk870-actions">${[['Новый ученик',0,1],['Средний ученик',500,8],['Продвинутый',1500,20],['Максимальный тест',10000,30]].map((x,i)=>mk870Btn(x[0],'mk870Preset('+i+')')).join('')}</div></div>
 <div class="mk870-group"><h3>Предметы</h3><div class="mk870-actions">${mk870Btn('Открыть всех героев','mk870GrantItems(false)')}${mk870Btn('Открыть все предметы','mk870GrantItems(true)')}${mk870Btn('Убрать developer-предметы','mk870RemoveGrants()')}</div><small>Тестовая выдача не создаёт историю покупки и не даёт право на продажу.</small></div>
 <div class="mk870-group"><h3>Снимок и сброс</h3><div class="mk870-actions">${mk870Btn('Сохранить тестовый снимок','mk870Snapshot()')}${mk870Btn('Восстановить тестовый снимок','mk870RestoreSnapshot()')}${mk870Btn('Сбросить тестового ученика','mk870ResetTest()')}</div></div>`}
function openDeveloperPanel(){
 if(!mk870EnsureAccess())return;
 const overlay=document.getElementById('mk870Overlay');if(!overlay)return;
 let p=profiles[currentProfile]||state;
 document.getElementById('mk870PanelBody').innerHTML=`<div class="mk870-top"><h2>Панель разработчика</h2>${mk870Btn('Закрыть','mk870ClosePanel()')}</div><div class="mk870-field"><label for="mk870Select">Профиль:</label><select id="mk870Select" onchange="mk870SelectProfile(this.value)">${mk870SelectOptions()}</select>${mk870Btn('Создать тестового ученика','mk870CreateTest()')}</div><div class="mk870-status"><b>${esc(currentProfile)}</b> • ${p.developerTestProfile?'TEST':'Обычный'}<div>Монеты: <b>${Number(p.coins)||0}</b> • XP: <b>${Number(p.xp)||0}</b> • уровень: <b>${levelFor(p.xp||0)}</b></div><div>Предметов: <b>${mk870OwnCount(p)}</b> • выбранный герой: <b>${esc(catalogItem('avatars',p.equipped?.avatar||'av_default')?.name||'Классик')}</b></div></div>${p.developerTestProfile?mk870TestActions():'<div class="mk870-group">Изменение монет, опыта и предметов доступно только тестовым ученикам.</div>'}<div class="mk870-group"><h3>Управление</h3><div class="mk870-actions">${mk870Btn('Удалить все тестовые профили','mk870DeleteTests()')}${mk870Btn('Выключить режим разработчика','mk870Disable()')}</div></div><div id="mk870PanelError" class="mk870-error"></div>`;
 overlay.classList.add('open');overlay.setAttribute('aria-hidden','false');
}
