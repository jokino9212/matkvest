   }
   if(!chosen)throw new Error('Grade 8 algebra: not enough distinct template types '+key);
   registerSignature(chosen.sig);chosen._signature=chosen.sig;
   (variants[key]||(variants[key]=[])).push(chosen.templateId);
   (texts[key]||(texts[key]=[])).push(normalizePromptForCompare(chosen.text||''));
   return chosen;
 };
})();

