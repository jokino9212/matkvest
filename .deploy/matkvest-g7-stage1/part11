function areaMethods(raw,d){
 const variants=d===0?['add','cut','half','principle','compare']:
   d===1?['add','cut','half','inverse_cut','compare','two_triangles','double']:
   ['inverse_cut','two_triangles','two_triangles_diff','double','cut','add','half','split_inverse','cut_area','two_triangles_ratio'];
 const v=forcedVariant&&variants.includes(forcedVariant)?forcedVariant:pick(variants), w=pick([5,6,7,8]),h=pick([4,6,8]);
 if(v==='add'){const w2=pick([3,4,5]),h2=h;return number(raw,d,v,`Два прямоугольника ${w}×${h} см и ${w2}×${h2} см сложены без перекрытия. Найди общую площадь.`,w*h+w2*h2,`Сумма площадей ${w}·${h}+${w2}·${h2}=${w*h+w2*h2} см².`,partModel('split',{w,h1:h,w2,h2}),'см²');}
 if(v==='cut'){const cw=pick([2,3]),ch=pick([2,3]),s=w*h-cw*ch;return number(raw,d,v,`От прямоугольника ${w}×${h} см отрезали угловой прямоугольник ${cw}×${ch} см. Найди площадь оставшейся части.`,s,`S=${w}·${h}−${cw}·${ch}=${s} см².`,partModel('cut',{w,h,cw,ch}),'см²');}
 if(v==='half'){return number(raw,d,v,`Прямоугольник со сторонами ${w} см и ${h} см разделили диагональю на два треугольника. Найди площадь одного треугольника.`,w*h/2,`S=${w}·${h}/2=${w*h/2} см².`,partModel('diagonal',{w,h}),'см²');}
 if(v==='inverse_cut'){const cw=pick([2,3]),ch=pick([2,3]),s=w*h-cw*ch;return number(raw,d,v,`Площадь оставшейся после углового выреза части прямоугольника ${w}×${h} см равна ${s} см². Ширина выреза ${cw} см. Найди высоту выреза.`,ch,`Площадь выреза ${w*h}−${s}=${cw*ch}; высота ${cw*ch}/${cw}=${ch} см.`,partModel('cut',{w,h,cw,ch},{ch:'? см'}),'см');}
 if(v==='two_triangles'){const a=pick([4,6,8]),b=pick([4,6]),ht=pick([4,6,8]);return number(raw,d,v,`Два треугольника с общей высотой ${ht} см имеют основания ${a} и ${b} см. Они не перекрываются. Найди сумму площадей.`,(a+b)*ht/2,`S=(a+b)·h/2=(${a}+${b})·${ht}/2=${(a+b)*ht/2} см².`,partModel('twoTriangles',{a,b,h:ht,w:a+b}),'см²');}
 if(v==='two_triangles_diff'){const a=pick([6,8,10]),b=pick([2,4]),ht=pick([4,6,8]);return number(raw,d,v,`Два треугольника с общей высотой ${ht} см имеют основания ${a} и ${b} см. На сколько см² площадь первого больше?`,(a-b)*ht/2,`S₁−S₂=(${a}−${b})·${ht}/2=${(a-b)*ht/2} см².`,partModel('twoTriangles',{a,b,h:ht,w:a+b}),'см²');}
 if(v==='double'){const cw=pick([2,3]),ch=pick([2,3]),s=w*h-cw*ch;return number(raw,d,v,`Из прямоугольника ${w}×${h} см вырезали угол ${cw}×${ch} см. Какова суммарная площадь двух таких одинаковых оставшихся фигур?`,2*s,`Площадь одной ${w*h}−${cw*ch}=${s}; площадь двух ${2*s} см².`,partModel('cut',{w,h,cw,ch}),'см²');}
 if(v==='split_inverse'){const w2=pick([3,4,5]),area=(w+w2)*h;return number(raw,d,v,`Два прямоугольника высотой ${h} см, ширина первого ${w} см, вместе занимают ${area} см². Найди ширину второго.`,w2,`Ширина объединённой фигуры ${area}/${h}=${w+w2} см, поэтому вторая ширина ${w+w2}−${w}=${w2} см.`,partModel('split',{w,h1:h,w2,h2:h},{w2:'? см'}),'см');}
