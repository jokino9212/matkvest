  if(v==='context_small'&&d===2){const a=pick([2,3,4,5,6,7,8]),n=-rnd(6,8),e=n+9;return number(r,d,v,`Толщину ${sci(a,n)} м выразили в нанометрах (1 нм = 10⁻⁹ м). Найди показатель 10 в стандартной записи результата.`,e,`Для перехода от метров к нанометрам показатель увеличивается на 9: ${sci(a,e)} нм.`,{kind:'unitExponent',a,n,shift:9});}
  if(v==='to_big'||v==='context_big'){const a=coeff(),n=rnd(3,7),value=a*10**n;const correct=sci(a,n);return choice(r,d,v,`${v==='context_big'?'Длина условного маршрута':'Запиши число'} ${dec(value)} ${v==='context_big'?'м в стандартном виде.':'в стандартном виде.'}`,correct,[sci(a,n-1),sci(a,n+1),sci(a+1,n)],`Коэффициент ${h(a)} находится между 1 и 10. Ответ: ${correct}.`,{a,n,value,kind:'scientific'});}
  if(v==='to_small'||v==='context_small'){const a=coeff(),n=-rnd(3,6),value=a*10**n;const correct=sci(a,n);return choice(r,d,v,`Запиши ${dec(value)} ${v==='context_small'?'м (малую длину)':' '} в стандартном виде.`,correct,[sci(a,n-1),sci(a,n+1),sci(a,-n)],`Для числа меньше единицы показатель отрицательный: ${correct}.`,{a,n,value,kind:'scientific'});}
  if(v==='find_exp_big'||v==='find_exp_small'||v==='missing_exp'){const a=coeff(),n=v==='find_exp_big'?rnd(2,7):v==='find_exp_small'?-rnd(2,6):pick([-6,-5,-4,-3,3,4,5,6]),value=a*10**n;return number(r,d,v,`Число ${dec(value)} равно ${h(a)}·10ⁿ. Найди целое n.`,n,`Перенос запятой даёт ${sci(a,n)}, поэтому n=${n}.`,{kind:'exponent',a,n,value});}
  if(v==='coefficient_condition'||v==='standard_identify'){const a=coeff(),n=rnd(-5,5),correct=sci(a,n);return choice(r,d,v,v==='coefficient_condition'?'Выбери запись с коэффициентом от 1 до 10, не включая 10.':'Какая из записей является стандартной?',correct,[sci(a*10,n-1),sci(a/10,n+1),`<span class="math">${h(a)}+10${g8Sup82(n)}</span>`],`В стандартной записи число перед 10 должно удовлетворять 1 ≤ a < 10.`,{kind:'scientific',a,n});}
