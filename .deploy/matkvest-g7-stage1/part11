const MK5_GRADE5_IDS=new Set([...G5_CORE,...G5_FRACTIONS,...G5_DECIMALS].map(t=>t.id));
makeG5Question=function(id){
 const raw=String(id||'');
 const topic=raw==='fraction_mix'?mk5Pick(G5_FRACTIONS).id:raw;
 if(!MK5_GRADE5_IDS.has(topic))return MK5_ORIGINAL_MAKE(id);
 const stage=Math.max(0,Math.min(2,Number(activeDifficulty())||0));
 const pos=Math.max(0,Number(blockSession?.done)||0);
 const total=Math.max(3,Number(blockSession?.total)||5);
 const phase=Math.min(2,Math.floor(3*pos/total));
 const level=Math.min(2,Math.floor((stage+phase)/2));
 const mode=(pos+stage)%3;
 const qq=mk5ScoreVariant(topic,level,mode);
 if(!qq)throw new Error('Нет генератора для темы 5 класса '+topic);
 const correctChoice=qq.choices.find(c=>String(c.key)===String(qq.correct));
 if(!correctChoice)throw new Error('Правильный ответ не представлен в '+topic);
 const answerText=choicePlain(correctChoice);
 const promptKey=qq.text.includes('<svg')?`diagram_${mk5PromptHash(qq.text)}`:stripHtmlText(qq.text);
 // Difficulty is deliberately absent from identity: the *same visible task*
 // cannot be accepted twice just because it was generated at another tier.
 const sig=`g5:${raw}:${topic}:${qq.templateId}:${promptKey}:${String(qq.correct)}:${qq.choices.map(c=>academicHtmlPlain(c.label)).sort().join('~')}`;
 return {text:qq.text,ans:String(qq.correct),choices:qq.choices.map(c=>({label:c.label,key:String(c.key)})),ex:qq.explain,
  correctLabel:correctChoice.label,correctText:answerText,sourceTopicId:topic,templateId:qq.templateId,
  mk5Audit:{...(qq.mk5Audit||{}),level,phase,mode,stage,topic},sig};
};
function mk5Family(sig){const s=String(sig||'').split(':');return s.length>4&&s[0]==='g5'?s[3]:''}
function mk5PromptHash(value){let h=2166136261;for(const ch of String(value)){h=Math.imul(h^ch.charCodeAt(0),16777619)>>>0}return h.toString(36)}
freshQuiz=function(id){
 const sid=String(id||'');
 if(!sid.startsWith('g5:')||!['g5quiz','g5mix'].includes(blockSession?.kind))return MK5_ORIGINAL_FRESH(id);
 const raw=rawCourseId(sid),used=blockSession?.usedSignatures||[],lastFamily=mk5Family(used[used.length-1]);
 const past=new Set((blockSession?.items||[]).map(x=>String(x.prompt||'')));
 const familyMaker=()=>makeG5Question(raw),signature=q=>q.sig;
 for(let pass=0;pass<3;pass++)for(let attempt=0;attempt<160;attempt++){
  const q=familyMaker(),key=signature(q),sameFamily=mk5Family(key)===lastFamily;
  if(wasUsedInBlock(key))continue;
  if(pass===0&&(wasRecent(key)||sameFamily||past.has(q.text)))continue;
  if(pass===1&&(sameFamily||past.has(q.text)))continue;
  if(pass===2&&past.has(q.text))continue;
  registerSignature(key);q._signature=key;return q;
 }
 return freshCandidate(familyMaker,signature,600);
};
})();

