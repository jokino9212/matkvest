 if(v==='half_rectangle'){const a=rand(3,14),b=rand(2,12);return num(id,d,v,`Диагональ прямоугольника ${a}×${b} см делит его на два равных треугольника. Найди площадь одного.`,a*b/2,`S=${a}·${b}/2=${a*b/2} см².`,'см²')}
 if(v==='height'){const a=rand(3,18),h=rand(3,14);return num(id,d,v,`Площадь треугольника ${a*h} см², основание ${a} см. Найди проведённую к нему высоту.`,2*h,`h=2S/a=2·${a*h}/${a}=${2*h} см.`)}
