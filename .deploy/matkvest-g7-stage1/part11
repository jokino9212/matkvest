function thales(d){
 const v=pick([['rule','parallel','equal','half','ratio','count'],['ratio','half','equal','missing','segments','rule'],['missing','segments','ratio','reverse','multiple','proof']][d]),m=tri(T,d,v);
 if(v==='rule')return choice(T,d,v,'В треугольнике ABC точки D∈AB и E∈AC, DE∥BC. Какое равенство верно?','AD/AB=AE/AC',['AD/AB=AC/AE','AD/DB=AC/AE','AD=AE всегда'],'Параллельная прямая делит стороны треугольника пропорционально.',m);
 if(v==='parallel')return choice(T,d,v,'D и E лежат на сторонах AB и AC, AD/AB=AE/AC. Что следует из обратной теоремы Фалеса?','DE∥BC',['DE⊥BC','AD=AE','AB=AC'],'Равные отношения соответствующих отрезков дают параллельность DE и BC.',m);
 if(v==='equal')return choice(T,d,v,'Если AD=DB и DE∥BC, чему равно AE/EC?','1',['2','1/2','3'],'Прямая через середину одной стороны параллельно другой стороне делит третью сторону пополам.',m);
 if(v==='count'){let n=rnd(3,8);return num(T,d,v,`Параллельные прямые отсекают на одной секущей ${n} равных последовательных отрезков. Сколько равных отрезков они отсекают на другой секущей между теми же прямыми?`,n,'По теореме Фалеса равным отрезкам на одной секущей соответствуют равные отрезки на другой.',m,'');}
 if(v==='half'){let a=rnd(3,15);return num(T,d,v,`D — середина AB, DE∥BC, AE=${a} см. Найди EC.`,a,`По теореме Фалеса AE=EC=${a} см.`,m)}
 if(v==='ratio'){let k=rnd(2,5),a=rnd(2,9);setFraction(m,1,k+1);return num(T,d,v,`D∈AB, E∈AC, DE∥BC. AD:DB=1:${k}, AE=${a} см. Найди EC.`,a*k,`По теореме Фалеса AE:EC=1:${k}, поэтому EC=${a}·${k}=${a*k} см.`,m)}
 if(v==='missing'){let a=rnd(2,8),k=rnd(2,5);setFraction(m,1,k+1);return num(T,d,v,`DE∥BC, AD=${a} см, DB=${a*k} см, AE=${a+1} см. Найди EC.`,(a+1)*k,`AD:DB=AE:EC=1:${k}, значит EC=${a+1}·${k}=${(a+1)*k} см.`,m)}
 if(v==='segments'){let a=rnd(3,10),k=rnd(2,5);setFraction(m,1,k+1);return num(T,d,v,`D∈AB, E∈AC, DE∥BC. AD=${a} см, AB=${a*(k+1)} см, AC=${(a+2)*(k+1)} см. Найди EC.`,(a+2)*k,`AD/AB=1/${k+1}, поэтому AE=${a+2} см, EC=${(a+2)*(k+1)}−${a+2}=${(a+2)*k} см.`,m)}
 if(v==='reverse'){setFraction(m,2,5);return choice(T,d,v,'На сторонах AB и AC отмечены D и E, причём AD:DB=AE:EC=2:3. Что можно доказать?','DE∥BC',['AB=AC','DE=BC','AD=AE'],'Обратная теорема Фалеса: совпадение пропорций подтверждает параллельность.',m);}
 let a=rnd(2,7),k=rnd(2,5);setFraction(m,2,k+2);return num(T,d,v,`D∈AB, E∈AC, DE∥BC. AD:DB=2:${k}, AE=${2*a} см. Найди AC.`,a*(k+2),`AE:EC=2:${k}; EC=${a*k} см, AC=${2*a}+${a*k}=${a*(k+2)} см.`,m);
}
function proportional(d){
 const v=pick([['identify','basic','equivalence','factor','fraction','test'],['missing','factor','fraction','cross','compare','basic'],['cross','two_step','compare','missing','factor','check']][d]);const m=null;
 if(v==='identify')return choice(P,d,v,'Какая пропорция записана верно для равенства отношений 2:3 и 4:6?','2/3=4/6',['2/4=3/6','2/3=6/4','2/6=3/4'],'2·6=3·4=12.',m);
 if(v==='equivalence')return choice(P,d,v,'Если a/b=c/d и b,d≠0, какое равенство следует?','ad=bc',['ab=cd','ac=bd','a+d=b+c'],'Основное свойство пропорции: произведения крайних и средних членов равны.',m);
 if(v==='test')return choice(P,d,v,'Верна ли пропорция 6:9=10:15?','да',['нет','только при 6=10','невозможно определить'],'6·15=9·10=90.',m);
 if(v==='basic'){let k=rnd(3,8),a=rnd(2,9);return num(P,d,v,`Отрезки относятся как 2:${k}. Если меньший равен ${2*a} см, найди больший.`,a*k,`Одна доля ${a} см, больший отрезок ${a}·${k}=${a*k} см.`,m)}
 if(v==='fraction'){let k=rnd(2,7),n=rnd(2,10);return num(P,d,v,`AB:CD=${k}:3, CD=${3*n} см. Найди AB.`,k*n,`AB=(${k}/3)·${3*n}=${k*n} см.`,m)}
 if(v==='factor'){let a=rnd(2,9),k=rnd(2,6);return num(P,d,v,`Два отрезка относятся как ${a}:${a*k}. Во сколько раз второй длиннее первого?`,k,`(${a*k})/${a}=${k}.`,m,'раз');}
 if(v==='missing'){let a=rnd(2,9),k=rnd(2,5),b=rnd(3,11);return num(P,d,v,`Дано AB:BC=${a}:${a*k}, DE=${b} см и DE:EF=AB:BC. Найди EF.`,b*k,`DE:EF=1:${k}, EF=${b}·${k}=${b*k} см.`,m)}
 if(v==='cross'){let a=rnd(2,8),b=rnd(3,9),k=rnd(2,5);return num(P,d,v,`Реши пропорцию: ${a}/${a*k} = ${b}/x. Найди x.`,b*k,`x=${b}·${a*k}/${a}=${b*k}.`,m,'');}
 if(v==='compare'){let a=rnd(2,8),b=rnd(3,9),k=rnd(2,5);return choice(P,d,v,`Какая пара отношений равна ${a}:${a*k}?`,`1:${k}`,[`${k}:1`,`1:${k+1}`,`${k+1}:1`],`Сократим обе части отношения на ${a}: 1:${k}.`,m)}
 if(v==='check')return choice(P,d,v,'Могут ли отношения 4:6 и 10:15 задавать пропорциональные отрезки?','да',['нет','только равные отрезки','только перпендикулярные отрезки'],'Оба отношения равны 2:3.',m);
 let a=rnd(2,7),k=rnd(2,5),c=rnd(2,8);return num(P,d,v,`AB:BC=${a}:${a*k}; BC=${a*k*c} см. Найди AB+BC.`,a*c*(k+1),`AB=${a*c} см, сумма ${a*c}+${a*k*c}=${a*c*(k+1)} см.`,m)
}
function midline(d){
 const v=pick([['definition','parallel','half','identify','length','endpoint'],['length','inverse','perimeter','parallel','ratio','half'],['inverse','perimeter','two_mid','ratio','combined','length']][d]);const m=tri(M,d,v);m.t=.5;
 if(v==='definition')return choice(M,d,v,'D и E — середины AB и AC. Как называется DE?','средняя линия треугольника',['медиана','высота','биссектриса'],'Средняя линия соединяет середины двух сторон.',m);
 if(v==='parallel')return choice(M,d,v,'D и E — середины AB и AC. Как расположен DE относительно BC?','DE∥BC',['DE⊥BC','DE совпадает с BC','DE пересекает BC'],'Средняя линия параллельна третьей стороне.',m);
 if(v==='endpoint')return choice(M,d,v,'DE — средняя линия треугольника ABC, D∈AB, E∈AC. Какое равенство верно?','AD=DB',['AD=AB','DE=BC','AE=AC'],'Концы средней линии являются серединами сторон.',m);
 if(v==='identify')return choice(M,d,v,'Если D и E — середины AB и AC, какой отрезок является средней линией?','DE',['AD','BE','BC'],'Соединяем середины D и E.',m);
 if(v==='half')return choice(M,d,v,'Какое отношение DE:BC, если DE — средняя линия треугольника ABC?','1:2',['2:1','1:1','1:3'],'Средняя линия равна половине третьей стороны.',m);
 if(v==='length'){let a=rnd(4,20);return num(M,d,v,`D и E — середины AB и AC; BC=${2*a} см. Найди DE.`,a,`DE=BC/2=${2*a}/2=${a} см.`,m)}
 if(v==='inverse'){let a=rnd(3,18);return num(M,d,v,`DE — средняя линия треугольника ABC, DE=${a} см. Найди BC.`,2*a,`BC=2·DE=2·${a}=${2*a} см.`,m)}
 if(v==='ratio'){let a=rnd(4,18);return num(M,d,v,`D и E — середины AB и AC, BC=${2*a} см. Найди сумму DE+BC.`,3*a,`DE=${a} см, DE+BC=${a}+${2*a}=${3*a} см.`,m)}
 if(v==='perimeter'){let a=rnd(6,12),b=rnd(6,12),c=rnd(6,12);return num(M,d,v,`Стороны треугольника ABC равны ${2*a}, ${2*b}, ${2*c} см. Найди периметр треугольника, образованного соединением середин всех трёх сторон.`,a+b+c,`Каждая средняя линия вдвое меньше соответствующей стороны. Периметр = ${a}+${b}+${c}=${a+b+c} см.`,m)}
 if(v==='two_mid'){let a=rnd(5,18),b=rnd(4,15);return num(M,d,v,`В треугольнике ABC DE — средняя линия, параллельная BC, а FG — средняя линия, параллельная AB. DE=${a} см, FG=${b} см. Найди AB+BC.`,2*(a+b),`BC=2·${a}, AB=2·${b}; сумма ${2*(a+b)} см.`,m)}
 let a=rnd(5,19),b=rnd(3,12);return num(M,d,v,`DE — средняя линия треугольника ABC, DE=${a} см. Отрезок BC на ${b} см длиннее другой стороны AC. Найди BC−DE.`,a,`BC=2DE=${2*a} см, поэтому BC−DE=${a} см.`,m);
}
const previous=makeG8Question;makeG8Question=function(id,stageOverride=null){let raw=rawCourseId(id),d=Math.max(0,Math.min(2,Number.isInteger(stageOverride)?stageOverride:activeDifficulty()));if(raw===T)return thales(d);if(raw===P)return proportional(d);if(raw===M)return midline(d);return previous(id,stageOverride)};
})();
</script>
<script id="mk-g8-geometry-quality-stage5">
/* Stage 5: three grade-8 geometry generators. Existing saved question snapshots are unchanged. */
(function(){'use strict';
const C='triangle_centroid',S='similar_triangles_coefficient',T='triangle_similarity_tests';
const randint=(a,b)=>a+Math.floor(Math.random()*(b-a+1));
const choose=a=>a[randint(0,a.length-1)];
const number=(id,d,v,txt,ans,exp,model=null,unit='см')=>g8GeoNumber812(id,d,v,txt,ans,exp,model,'',unit);
const multiple=(id,d,v,txt,ans,wrong,exp,model=null)=>g8GeoChoice812(id,d,v,txt,ans,wrong,exp,model);
function centroid(d){let v=choose([['part','whole','fraction','definition','ratio','position'],['part','median','find_gm','two_medians','fraction','position'],['median','two_medians','combined','find_gm','ratio','reverse']][d]);
 const m=g8CentroidModel812({topic:C,variant:v});
 if(v==='definition')return multiple(C,d,v,'Как называется общая точка пересечения медиан треугольника?','центроид',['ортоцентр','центр вписанной окружности','середина стороны'],'Центроид — пересечение трёх медиан.',m);
 if(v==='ratio')return multiple(C,d,v,'Центроид G делит медиану AM в каком отношении AG:GM?','2:1',['1:2','1:1','3:1'],'От вершины до центроида две трети медианы.',m);
 if(v==='position')return multiple(C,d,v,'G — центроид треугольника ABC, M — середина BC. Где лежит G?','на медиане AM',['на прямой, параллельной BC через A','обязательно на стороне BC','обязательно вне треугольника'],'Все медианы проходят через центроид.',m);
 if(v==='part'){let x=randint(2,13);return number(C,d,v,`G — центроид треугольника, M — середина BC, GM=${x} см. Найди AG.`,2*x,`AG=2·GM=2·${x}=${2*x} см.`,m)}
 if(v==='whole'){let x=randint(3,14);return number(C,d,v,`AM — медиана, G — центроид, GM=${x} см. Найди AM.`,3*x,`AM=AG+GM=2·${x}+${x}=${3*x} см.`,m)}
 if(v==='fraction'){let x=randint(3,15);return number(C,d,v,`Длина медианы AM равна ${3*x} см. Найди расстояние от вершины A до центроида G.`,2*x,`AG=(2/3)·AM=${2*x} см.`,m)}
 if(v==='find_gm'){let x=randint(3,15);return number(C,d,v,`G — центроид, AG=${2*x} см. Найди GM, если M — середина BC.`,x,`GM=AG/2=${2*x}/2=${x} см.`,m)}
 if(v==='median'){let x=randint(3,13);return number(C,d,v,`G — центроид, AG=${2*x} см. Найди всю медиану AM.`,3*x,`GM=${x} см; AM=AG+GM=${3*x} см.`,m)}
 if(v==='two_medians'){let a=randint(3,12),b=randint(4,13);return number(C,d,v,`В треугольнике ABC медианы AM и BN пересекаются в G. GM=${a} см, BG=${2*b} см. Найди AM+BN.`,3*(a+b),`AM=3·${a}=${3*a}, BN=(3/2)·${2*b}=${3*b}; сумма ${3*(a+b)} см.`,m)}
 if(v==='combined'){let x=randint(3,13),b=randint(2,9);return number(C,d,v,`Медиана AM равна ${3*x} см, медиана BN на ${3*b} см длиннее AM. Медианы пересекаются в G. Найди BG−AG.`,2*b,`BG=(2/3)·${3*(x+b)}=${2*(x+b)}, AG=(2/3)·${3*x}=${2*x}; разность ${2*b} см.`,m)}
 return multiple(C,d,v,'На медиане AM отмечена точка G так, что AG:GM=2:1. Можно ли заключить, что G — центроид треугольника?','да',['нет','только для равнобедренного треугольника','только для прямоугольного треугольника'],'Точка на медиане, отстоящая от вершины на 2/3 её длины, — общий центр медиан.',m);
}
function simModel(){const m=g8SimilarPair812({});m.D={x:360,y:330};m.E={x:564,y:330};m.F={x:462,y:84};return m} // exact homothety factor 6/5 of triangle ABC; original height 205 -> 246
function similar(d){const v=choose([['concept','angles','direct','identify','perimeter','correspond'],['direct','inverse','perimeter','ratio','missing','identify'],['missing','combined','ratio','inverse','perimeter','reverse']][d]);let m=simModel();
 if(v==='concept')return multiple(S,d,v,'Что сохраняется при подобии треугольников?','величины соответствующих углов',['все длины сторон','площадь','абсолютная длина периметра'],'При подобии углы равны, а длины пропорциональны.',m);
 if(v==='angles')return multiple(S,d,v,'Если ΔABC∼ΔDEF, какие углы равны?','∠B=∠E',['∠B=∠D','∠A=∠F','∠C=∠D'],'Порядок букв: A↔D, B↔E, C↔F.',m);
 if(v==='correspond')return multiple(S,d,v,'Если ΔABC∼ΔDEF, какой стороне соответствует AC?','DF',['DE','EF','BC'],'По порядку вершин A↔D, C↔F.',m);
 if(v==='identify')return multiple(S,d,v,'Если k=3 — коэффициент подобия второго треугольника к первому, чему равно отношение их периметров P₂:P₁?','3:1',['9:1','1:3','1:1'],'Периметр масштабируется как линейная длина.',m);
 if(v==='direct'){let a=randint(3,14),k=randint(2,5);return number(S,d,v,`ΔABC∼ΔDEF, AB=${a} см, DE=${a*k} см. Найди коэффициент подобия второго треугольника к первому.`,k,`k=DE/AB=${a*k}/${a}=${k}.`,null,'')}
 if(v==='inverse'){let x=randint(3,12),k=randint(2,5);return number(S,d,v,`Коэффициент подобия второго треугольника к первому k=${k}, сторона второго ${x*k} см. Найди соответствующую сторону первого.`,x,`${x*k}/${k}=${x} см.`)}
 if(v==='perimeter'){let p=randint(15,45),k=randint(2,4);return number(S,d,v,`Периметр первого треугольника ${p} см. Второй подобен первому с коэффициентом k=${k}. Найди периметр второго.`,p*k,`P₂=k·P₁=${k}·${p}=${p*k} см.`)}
 if(v==='ratio'){let a=randint(3,10),k=randint(2,5),b=randint(3,11);return number(S,d,v,`ΔABC∼ΔDEF. AB=${a} см, DE=${a*k} см, BC=${b} см. Найди EF.`,b*k,`DE/AB=${k}; EF=${b}·${k}=${b*k} см.`)}
 if(v==='missing'){let a=randint(4,12),k=randint(2,5),b=randint(3,13);return number(S,d,v,`ΔABC∼ΔDEF. AB=${a} см, DE=${a*k} см, EF=${b*k} см. Найди BC.`,b,`k=DE/AB=${k}; BC=EF/k=${b*k}/${k}=${b} см.`)}
 if(v==='combined'){let a=randint(4,10),b=randint(4,10),c=randint(Math.abs(a-b)+1,a+b-1),k=randint(2,4);return number(S,d,v,`Стороны треугольника равны ${a}, ${b}, ${c} см. Периметр подобного ему треугольника в ${k} раза больше. Найди сумму соответствующих сторон второго треугольника.`,(a+b+c)*k,`P₁=${a+b+c}; P₂=${k}·${a+b+c}=${(a+b+c)*k} см.`)}
 return multiple(S,d,v,'Два треугольника имеют соответственно пропорциональные три пары сторон. Что следует?','они подобны',['они всегда равны','их углы в том же отношении, что стороны','их площади всегда равны'],'Признак подобия по трём сторонам.',m)
}
function tests(d){let v=choose([['aa','sas','sss','not_enough','angle_sum','name'],['aa_numbers','sas_numbers','sss_numbers','not_enough','angle_sum','proof'],['aa_numbers','sas_numbers','sss_numbers','counterexample','proof','reverse']][d]);let m=simModel();
 if(v==='aa')return multiple(T,d,v,'В двух треугольниках равны две пары соответствующих углов. Какой признак подобия применим?','по двум углам',['по одной стороне','по двум сторонам без угла','по медианам'],'Признак AA.',m);
 if(v==='sas')return multiple(T,d,v,'Две стороны пропорциональны, углы МЕЖДУ ними равны. Какой признак?','по двум сторонам и углу между ними',['по двум сторонам и любому углу','по одной стороне','по одной высоте'],'Угол обязательно заключён между сравниваемыми сторонами.',m);
 if(v==='sss')return multiple(T,d,v,'Все три пары соответствующих сторон пропорциональны. Какой признак?','по трём сторонам',['по одному углу','по одной стороне','по равным высотам'],'Признак SSS.',m);
 if(v==='not_enough')return multiple(T,d,v,'Каких данных недостаточно для подобия двух произвольных треугольников?','одна пара равных углов',['две пары соответствующих равных углов','три пары соответствующих пропорциональных сторон','две пары пропорциональных сторон и угол между ними'],'Один равный угол не задаёт форму.',m);
 if(v==='name')return multiple(T,d,v,'Как обозначают подобие треугольников ABC и DEF?','ΔABC∼ΔDEF',['ΔABC⊥ΔDEF','AB∥DE всегда','ΔABC=ΔDEF всегда'],'Знак подобия ∼.',m);
 if(v==='angle_sum'){let a=randint(35,65),b=randint(45,80);return number(T,d,v,`В ΔABC углы A=${a}°, B=${b}°. В ΔDEF углы D=${a}°, E=${b}°. Найди ∠F.`,180-a-b,`∠F=180°−${a}°−${b}°=${180-a-b}°.`,null,'°')}
 if(v==='aa_numbers'){let a=randint(35,65),b=randint(50,75);return multiple(T,d,v,`В ΔABC углы A=${a}°, B=${b}°. В ΔDEF углы D=${a}°, E=${b}°. Достаточно ли этого для подобия?`,'да',['нет','только если стороны равны','только если треугольники прямоугольные'],'Две пары углов равны, действует признак AA.',null)}
 if(v==='sas_numbers'){let a=randint(3,9),b=randint(4,10),k=randint(2,4);return multiple(T,d,v,`У первого треугольника стороны ${a} и ${b} образуют угол 60°. У второго стороны ${a*k} и ${b*k} образуют угол 60°. Подобны ли треугольники?`,'да',['нет','только если их периметры равны','не хватает третьей стороны'],'Две стороны пропорциональны с коэффициентом '+k+', и углы между ними равны.',null)}
