 if(v==='reverse'||v==='inverse')return number(raw,d,v,`Площадь большего прямоугольника ${large} см². Его стороны в ${k} раза больше соответствующих сторон меньшего. Найди площадь меньшего.`,s,`S₁=S₂/k²=${large}/${k*k}=${s} см².`,model({smallW:'a',smallH:'b'}),'см²');
 if(v==='k_from_ratio')return number(raw,d,v,`Площадь большего из двух подобных прямоугольников в ${k*k} раз больше площади меньшего. Во сколько раз больше соответствующая сторона?`,k,`Коэффициент подобия k=√${k*k}=${k}.`,model({largeW:'?',largeH:'?'}),'раз');
 if(v==='perimeter')return number(raw,d,v,`Периметр меньшего прямоугольника ${2*(w+h)} см. Все стороны подобного прямоугольника в ${k} раза больше. Найди его периметр.`,2*(w+h)*k,`Периметр меняется в k раз: P₂=${2*(w+h)}·${k}=${2*(w+h)*k} см.`,model(),'см');
 if(v==='difference')return number(raw,d,v,`Площади двух подобных прямоугольников относятся как 1:${k*k}, площадь меньшего ${s} см². На сколько см² площадь большего больше?`,large-s,`S₂=${s}·${k*k}=${large}; S₂−S₁=${large}-${s}=${large-s} см².`,model(),'см²');
 if(v==='two_steps')return number(raw,d,v,`Стороны меньшего прямоугольника ${w} см и ${h} см. Стороны подобного увеличены в ${k} раза. На сколько см² увеличилась площадь?`,large-s,`S₁=${w}·${h}=${s}; S₂=${s}·${k*k}=${large}; разница ${large-s} см².`,model(),'см²');
 if(v==='area_from_perimeter')return number(raw,d,v,`Меньший прямоугольник имеет стороны ${w} см и ${h} см. Периметр подобного большего равен ${2*(w+h)*k} см. Найди площадь большего.`,large,`Периметр меньшего ${2*(w+h)} см, поэтому k=${2*(w+h)*k}/${2*(w+h)}=${k}; S₂=${w}·${h}·${k*k}=${large} см².`,model(),'см²');
 if(v==='perimeter_then_area')return number(raw,d,v,`Периметр меньшего прямоугольника ${2*(w+h)} см, одна его сторона ${w} см. Все стороны подобного большего в ${k} раза больше. Найди площадь большего.`,large,`Вторая сторона меньшего ${2*(w+h)}/2−${w}=${h} см; S₁=${s}; S₂=${s}·${k*k}=${large} см².`,model({smallH:'? см',largeW:'?',largeH:'?'}),'см²');
