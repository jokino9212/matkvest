 if(v==='units')return choice(id,d,v,'Что необходимо знать для вычисления площади параллелограмма по формуле S=ah?','основание и высоту именно к нему',['две соседние стороны без угла','только периметр','только одну диагональ'],'Высота должна быть перпендикулярна выбранному основанию.');
