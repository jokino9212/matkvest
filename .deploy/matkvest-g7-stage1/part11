   const out=g8GeoNumber811(raw,d,v,text,answer,ex,m,'',unit);
   out.templateId=v;out.audit={...(out.audit||{}),type:'g8Stage14Median',topic:raw,stage:d,variant:v,model:{variant:v,answer}};
   return out;
 };
 const a=r(6,13),b=r(a+2,22);
 // A non-degenerate triangle is required whenever all three sides are given.
 // For |a-b| < c < a+b choose an integer strictly inside that interval.
 const c=v==='triangle_perimeter'
   ?r(Math.max(5,b-a+1),a+b-1)
   :r(6,15);
 if(v==='find_ad')return q(`AM — медиана треугольника ABC. Продолжили AM до D так, что MD=AM. Если AM=${a} см, найди AD.`,2*a,`AD=2AM=2·${a}=${2*a} см.`);
