function similar(raw,d){
 const variants=d===0?['ratio','direct','k_from_ratio','principle','inverse']:
  d===1?['direct','reverse','perimeter','k_from_ratio','compare','principle','difference']:
  ['difference','two_steps','perimeter','reverse','compare','k_from_ratio','direct','area_from_perimeter','perimeter_then_area','difference_reverse'];
 const v=forcedVariant&&variants.includes(forcedVariant)?forcedVariant:pick(variants),w=pick([3,4,5,6]),h=pick([2,3,4]),k=pick([2,3]),s=w*h,large=s*k*k;
