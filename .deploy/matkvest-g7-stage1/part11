 makeG8Question=function(id,override=null){const raw=rawCourseId(id),d=Math.max(0,Math.min(2,Number.isInteger(override)?override:activeDifficulty()));if(!IDS.has(raw))return PRE_MAKE(id,override);if(raw==='root_calculations_applications')return roots(raw,d);if(raw==='integer_exponent_definition')return integerDef(raw,d);return powers(raw,d)};
 const LEVEL_GROUPS={
   root_calculations_applications:[
     [['sum','squareSide','validLength'],['estimate','rootMean','rectDiag'],['hypotenuse','leg']],
     [['rootMean','squarePerimeter','rectDiag'],['rootExpression','hypotenuse','leg','reverseLength'],['rootProduct','nested','areasCompare']],
     [['hypotenuse','leg','squarePerimeter','estimate'],['rootExpression','rootProduct','nested','reverseLength','areasCompare'],['twoStagePerimeter','twoAreaDifference','compositeRectangle']]
   ],
   integer_exponent_definition:[
     [['expand','zero','sign'],['negativeValue','reciprocal','zeroRestriction'],['tenCompare','findExponent']],
     [['expand','zero','sign'],['reciprocal','negativeValue','zeroRestriction','negativeBase'],['tenCompare','findExponent','reciprocalReverse']],
     [['tenUnit','negativeSign','negativeBase'],['negativeBaseSign','parentheses','reciprocalReverse','compareReciprocals'],['fractionInverse','ratioReciprocal','twoBaseExpression','mixedProduct','mixedSignComparison']]
   ],
   integer_exponent_properties:[
     [['zero','ruleChoice','sumError'],['multiply','divide','powerPower'],['negativeRewrite','reverse']],
     [['multiply','divide','powerPower'],['negativeRewrite','powerProduct','powerQuotient','reverse'],['chain','numeric','divideNumeric']],
     [['multiply','divide','powerProduct','powerQuotient'],['chain','numeric','reverse','divideNumeric'],['mixedChain','compareForms','errorPower','negativeChain']]
   ]
 };
 const phase=(d,index)=>{const n=[5,7,10][d];if(index<Math.ceil(n*.3))return 0;if(index<n-Math.ceil(n*.3))return 1;return 2;};
 const PRE_FRESH=freshQuiz;
 freshQuiz=function(id){const raw=rawCourseId(id),full=`g8:${raw}`;
   if(!IDS.has(raw)||!blockSession||blockSession.kind!=='g8quiz'||String(blockSession.key)!==full)return PRE_FRESH(id);
   const d=activeDifficulty(),key=raw+'|'+d;
   const variants=blockSession._g8Algebra3Variants||(blockSession._g8Algebra3Variants={});
   const texts=blockSession._g8Algebra3Texts||(blockSession._g8Algebra3Texts={});
   const seen=new Set(variants[key]||[]),seenTexts=new Set(texts[key]||[]);
   let chosen=null;
   const currentPhase=phase(d,Number(blockSession.done)||0),allowed=new Set(LEVEL_GROUPS[raw][d][currentPhase]);
   for(let i=0;i<600;i++){
     const cand=makeG8Question(full,d),t=normalizePromptForCompare(cand.text||'');
     if(!allowed.has(cand.templateId)||seen.has(cand.templateId)||seenTexts.has(t)||wasUsedInBlock(cand.sig))continue;
