<script id="g8-geometry-session-dedupe-regression">
/* 8.72 geometry QA — avoid exact prompt repeats in ongoing grade-8 practice.
   No modifications to the catalog, localStorage, backups or unfinished attempts. */
(function(){
 const priorFresh=freshQuiz;
 const sessionHistory=new WeakMap();
 const normalized=q=>String(q?.text||'').replace(/<[^>]*>/g,' ').replace(/&nbsp;/g,' ').replace(/\s+/g,' ').trim();
 freshQuiz=function(id){
  const topic=typeof g8InfoById==='function'?g8InfoById(id):null;
  if(!topic||topic.course!=='geometry'||!blockSession||blockSession.kind!=='g8quiz')return priorFresh(id);
  let byTopic=sessionHistory.get(blockSession);
  if(!byTopic){byTopic=new Map();sessionHistory.set(blockSession,byTopic)}
  const key=String(topic.id)+'|'+String(blockSession.stageIndex??blockSession.stage??'');
  let seen=byTopic.get(key);
  if(!seen){seen=new Set();byTopic.set(key,seen)}
  let candidate=priorFresh(id),signature=normalized(candidate);
  if(seen.has(signature)){
   for(let attempt=0;attempt<100;attempt++){
    const next=priorFresh(id),nextSig=normalized(next);
    if(!seen.has(nextSig)){candidate=next;signature=nextSig;break}
   }
  }
  seen.add(signature);
  return candidate;
 };
})();
</script>
