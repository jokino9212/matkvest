 }
 const norm=(a,n)=>{while(a>=10){a/=10;n++}while(a<1&&a>0){a*=10;n--}return {a:Math.round(a*1e10)/1e10,n}};
 const expOptions=(correct,mismatches)=>[...new Set(mismatches.filter(x=>x!==correct))].slice(0,3);
 function notation(r,d){
  const vars=d===0?['to_big','to_small','find_exp_big','find_exp_small','coefficient_condition','convert_to_plain','standard_identify']:
    d===1?['from_shift','normalize_large_coef','normalize_small_coef','compare_same_exp','find_coefficient','order_of_magnitude','error_check','convert_to_plain']:
           ['compare_diff_exp','normalize_large_coef','normalize_small_coef','find_coefficient','from_shift','which_larger','precision_place','missing_exp','context_small','context_big','error_check'];
