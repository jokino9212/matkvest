function makePar(raw,d){
  const vars=d===0?['par_area','find_h','formula','rh_area','height_need']:d===1?['find_base','rh_find_diag','rh_side_height','compare','formula']:['scaled_height','compare_diff','rh_side_height','rh_find_diag','choose_formula','find_h'];
  const v=pick(vars);
  if(v==='par_area'){const a=pick([6,8,9,12,14]),h=pick([3,4,5,7]);return num(raw,d,v,`Основание параллелограмма ${a} см, высота к нему ${h} см. Найди площадь.`,a*h,`S=a·h=${a}·${h}=${a*h} см².`,parModel(`${a} см`,`${h} см`,{topic:raw}),'см²');}
  if(v==='find_h'){const a=pick([5,7,10,12]),h=pick([3,4,6,8]),s=a*h;return num(raw,d,v,`Площадь параллелограмма ${s} см², основание ${a} см. Найди высоту.`,h,`h=S/a=${s}/${a}=${h} см.`,parModel(`${a} см`,`? см`,{topic:raw}),'см');}
  if(v==='find_base'){const a=pick([6,8,9,12]),h=pick([3,5,7]),s=a*h;return num(raw,d,v,`Площадь параллелограмма ${s} см², высота ${h} см. Найди основание.`,a,`a=S/h=${s}/${h}=${a} см.`,parModel(`? см`,`${h} см`,{topic:raw}),'см');}
  if(v==='rh_area'){const d1=pick([6,8,10,12]),d2=pick([4,6,8,14]),s=d1*d2/2;return num(raw,d,v,`Диагонали ромба ${d1} см и ${d2} см. Найди площадь.`,s,`S=d₁·d₂/2=${d1}·${d2}/2=${s} см².`,rhDiagModel(`${d1} см`,`${d2} см`,{topic:raw}),'см²');}
  if(v==='rh_find_diag'){const d1=pick([6,8,10,12]),d2=pick([4,6,8]),s=d1*d2/2;return num(raw,d,v,`Площадь ромба ${s} см², одна диагональ ${d1} см. Найди вторую диагональ.`,d2,`d₂=2S/d₁=2·${s}/${d1}=${d2} см.`,rhDiagModel(`${d1} см`,`? см`,{topic:raw}),'см');}
  if(v==='rh_side_height'){const a=pick([5,6,8,10]),h=pick([3,4,5,7]);return num(raw,d,v,`Сторона ромба ${a} см, высота к этой стороне ${h} см. Найди площадь.`,a*h,`Площадь ромба как площадь параллелограмма: S=a·h=${a}·${h}=${a*h} см².`,rhHeightModel(`${a} см`,`${h} см`,{topic:raw}),'см²');}
  if(v==='compare'){const a=pick([6,8,10]),h=pick([3,4,5]),k=pick([2,3,4]);return num(raw,d,v,`У двух параллелограммов одинаковая высота ${h} см. Основания равны ${a} см и ${a*k} см. На сколько см² площадь второго больше?`,a*h*(k-1),`Разность площадей равна (${a*k}−${a})·${h}=${a*h*(k-1)} см².`,parModel(`${a} см`,`${h} см`,{topic:raw}),'см²');}
  if(v==='scaled_height'){const a=pick([6,8,10]),h=pick([3,4,6]),k=pick([2,3,4]);return num(raw,d,v,`Площадь параллелограмма увеличили в ${k} раза, не меняя основание ${a} см. Высота была ${h} см. Какой стала высота?`,h*k,`При неизменном основании площадь пропорциональна высоте, поэтому h₂=${h}·${k}=${h*k} см.`,parModel(`${a} см`,`? см`,{topic:raw}),'см');}
  if(v==='compare_diff'){const a=pick([5,7,9]),h=pick([4,6]),k=pick([2,3]);return num(raw,d,v,`Первый параллелограмм имеет основание ${a} см и высоту ${h} см. У второго основание в ${k} раза больше, а высота такая же. На сколько см² площадь второго больше?`,a*h*(k-1),`S₁=${a}·${h}=${a*h}, S₂=${a*k}·${h}=${a*h*k}. Разность ${a*h*(k-1)} см².`,parModel(`${a} см`,`${h} см`,{topic:raw}),'см²');}
  if(v==='choose_formula'){return choice(raw,d,v,'Какая формула площади ромба через диагонали верна?','S=d₁·d₂/2',['S=d₁·d₂','S=(d₁+d₂)/2','S=2d₁d₂'],'Площадь ромба через диагонали равна половине произведения диагоналей.',rhDiagModel('d₁','d₂',{topic:raw}));}
  if(v==='height_need'){return choice(raw,d,v,'Что нужно знать, чтобы найти площадь параллелограмма по формуле S=a·h?','основание и высоту к нему',['две соседние стороны','только диагонали','только периметр'],'Высота должна быть проведена именно к выбранному основанию.',parModel('a','h',{topic:raw}));}
  return choice(raw,d,v,'Какую формулу площади удобно использовать для параллелограмма?','S=a·h',['S=(a+b)h/2','S=d₁·d₂/2','S=a+b+h'],'Площадь параллелограмма равна произведению основания на высоту.',parModel('a','h',{topic:raw}));
}

function makeTrap(raw,d){
  const vars=d===0?['area','find_h','formula','mid','identify']:d===1?['find_sum','find_base','mid','compare','formula']:['find_base','find_h','scale_height','compare','mid','formula'];
  const v=pick(vars);
  if(v==='area'){const a=pick([6,8,10]),b=pick([12,14,16]),h=pick([4,6,8]),s=(a+b)*h/2;return num(raw,d,v,`Основания трапеции ${a} см и ${b} см, высота ${h} см. Найди площадь.`,s,`S=(a+b)·h/2=(${a}+${b})·${h}/2=${s} см².`,trapModel(`${a} см`,`${b} см`,`${h} см`),'см²');}
  if(v==='find_h'){const a=pick([6,8,10]),b=pick([12,14]),h=pick([4,6,8]),s=(a+b)*h/2;return num(raw,d,v,`Площадь трапеции ${s} см², основания ${a} см и ${b} см. Найди высоту.`,h,`h=2S/(a+b)=2·${s}/(${a}+${b})=${h} см.`,trapModel(`${a} см`,`${b} см`,`? см`),'см');}
  if(v==='find_sum'){const sum=pick([16,20,24,28]),h=pick([4,5,6]),s=sum*h/2;return num(raw,d,v,`Площадь трапеции ${s} см², высота ${h} см. Найди сумму оснований.`,sum,`a+b=2S/h=2·${s}/${h}=${sum} см.`,trapModel('a','b',`${h} см`),'см');}
  if(v==='find_base'){const a=pick([5,7,9]),b=pick([11,13,15]),h=pick([4,6]),s=(a+b)*h/2;return num(raw,d,v,`Площадь трапеции ${s} см², высота ${h} см, одно основание ${a} см. Найди второе основание.`,b,`a+b=2S/h=${a+b}, значит второе основание ${a+b}−${a}=${b} см.`,trapModel(`${a} см`,`? см`,`${h} см`),'см');}
  if(v==='mid'){const m=pick([7,9,11,13]),h=pick([4,6,8]),s=m*h;return num(raw,d,v,`Средняя линия трапеции ${m} см, высота ${h} см. Найди площадь.`,s,`S=m·h=${m}·${h}=${s} см².`,trapModel('a','b',`${h} см`,`${m} см`),'см²');}
  if(v==='compare'){const a=pick([4,6,8]),b=a+pick([4,6,8]),h=pick([3,5,7]),k=pick([2,3]);return num(raw,d,v,`У двух трапеций одинаковые основания ${a} см и ${b} см. Высота второй в ${k} раза больше высоты первой ${h} см. На сколько см² площадь второй больше?`,(a+b)*h*(k-1)/2,`S₁=(${a}+${b})·${h}/2=${(a+b)*h/2}, разность площадей ${(a+b)*h*(k-1)/2} см².`,trapModel(`${a} см`,`${b} см`,`${h} см`),'см²');}
  if(v==='scale_height'){const a=pick([6,8]),b=pick([10,14]),h=pick([4,5,6]),k=pick([2,3,4]);return num(raw,d,v,`Основания трапеции ${a} см и ${b} см. Высоту увеличили в ${k} раза. Во сколько раз увеличится площадь?`,k,`При неизменных основаниях площадь прямо пропорциональна высоте, значит увеличится в ${k} раза.`,trapModel(`${a} см`,`${b} см`,`${h} см`),'раз');}
  if(v==='identify'){return choice(raw,d,v,'Какие стороны трапеции являются основаниями?','параллельные стороны',['боковые стороны','диагонали','любые равные стороны'],'Основания трапеции — её параллельные стороны.',trapModel('a','b','h'));}
  return choice(raw,d,v,'Какая формула площади трапеции верна?','S=(a+b)·h/2',['S=(a−b)·h/2','S=(a+b)·h','S=a·b·h'],'Площадь трапеции равна произведению полусуммы оснований на высоту.',trapModel('a','b','h'));
}

function makeGrid(raw,d){
  const vars=d===0?['rect','triangle','split','method']:d===1?['lshape','split','triangle','rect','method']:['cut_inverse','lshape','triangle','split','method','rect'];
  const v=pick(vars);
  if(v==='rect'){const w=pick([4,5,6,7,8]),h=pick([3,4,5,6]);return num(raw,d,v,`На клетчатой бумаге прямоугольник занимает ${w} клетки по ширине и ${h} по высоте. Площадь одной клетки — 1 кв. ед. Найди площадь.`,w*h,`S=${w}·${h}=${w*h} кв. ед.`,gridModel({shape:'rect',w,h,left:1,top:1}),'кв. ед.');}
