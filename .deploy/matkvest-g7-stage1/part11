 if(v==='combined'){const a=rand(3,10),b=rand(3,10),k=rand(2,5);return num(id,d,v,`У двух подобных треугольников соответствующие стороны равны ${a} и ${a*k} см. Периметр первого на ${b*(k-1)} см меньше периметра второго. Найди периметр первого.`,b,`P₂=${k}P₁, поэтому (${k}−1)P₁=${b*(k-1)}; P₁=${b} см.`)}
 const p=rand(20,70),k=rand(2,5);return num(id,d,v,`Периметр большого треугольника равен ${p*k} см, коэффициент подобия большого к малому ${k}. Найди периметр малого.`,p,`Pмал=${p*k}/${k}=${p} см.`)
