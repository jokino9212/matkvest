<script id="g8-alg-first3-session-dedupe">
/* Темы 1–3: choose different structural variants within one session, not just different numbers.
   Existing currentItem snapshots are not modified. */
(function(){'use strict';
 const rawIds=new Set(['square_root_arithmetic','irrational_numbers_approximations','real_numbers_compare']);
 const previous=freshQuiz;
 freshQuiz=function(id){
  const raw=rawCourseId(id), full=`g8:${raw}`;
  if(!rawIds.has(raw)||!blockSession||blockSession.kind!=='g8quiz'||String(blockSession.key)!==full)return previous(id);
  const d=activeDifficulty();
  const seenByTopic=blockSession._algFirst3SeenVariants||(blockSession._algFirst3SeenVariants={});
  const seenTexts=blockSession._algFirst3SeenTexts||(blockSession._algFirst3SeenTexts={});
  const key=raw+'|'+d, seen=new Set(seenByTopic[key]||[]), seenTxt=new Set(seenTexts[key]||[]);
  let candidate=null;
  for(let attempt=0;attempt<250;attempt++){
   const qn=makeG8Question(full,d);
   const normalized=normalizePromptForCompare(qn.text||'');
   if(seen.has(qn.templateId)||seenTxt.has(normalized))continue;
   if(wasUsedInBlock(qn.sig)||wasRecent(qn.sig))continue;
   candidate=qn;break;
  }
  if(!candidate){
   for(let attempt=0;attempt<300;attempt++){
    const qn=makeG8Question(full,d),normalized=normalizePromptForCompare(qn.text||'');
    if(seen.has(qn.templateId)||seenTxt.has(normalized)||wasUsedInBlock(qn.sig))continue;
    candidate=qn;break;
   }
  }
  // Only when there are more questions than available scenarios is a reused scenario allowed.
  if(!candidate)return previous(id);
  registerSignature(candidate.sig);
  candidate._signature=candidate.sig;
  (seenByTopic[key]||(seenByTopic[key]=[])).push(candidate.templateId);
  (seenTexts[key]||(seenTexts[key]=[])).push(normalizePromptForCompare(candidate.text||''));
  return candidate;
 };
})();

