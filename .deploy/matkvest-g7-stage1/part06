/* Reusable elementary visual readiness. These helpers do not create a second quiz engine. */
function elementaryCountersHtml(count,{max=20}={}){
 const n=Math.max(0,Math.min(Number(max||20),Math.floor(Number(count||0))));
 return `<div class="elementary-model" role="img" aria-label="${n} предметов">${Array.from({length:n},()=>'<span class="elementary-counter"></span>').join("")}</div>`
}
function elementaryNumberLineSvg({min=0,max=20,highlight=null,from=null,to=null,hiddenLabels=[]}={}){
 min=Math.floor(Number(min));max=Math.floor(Number(max));if(!Number.isFinite(min)||!Number.isFinite(max)||max<=min){min=0;max=20}
 const hidden=new Set((Array.isArray(hiddenLabels)?hiddenLabels:[hiddenLabels]).map(Number)),W=680,H=118,L=32,R=32,Y=58,range=max-min,x=n=>L+(n-min)/(range||1)*(W-L-R);
 let ticks="",labels="";for(let n=min;n<=max;n++){const xx=x(n);ticks+=`<line x1="${xx}" y1="${Y-8}" x2="${xx}" y2="${Y+8}" stroke="#6d8278" stroke-width="2"/>`;if(!hidden.has(n))labels+=`<text x="${xx}" y="${Y+29}" text-anchor="middle" font-size="13" fill="#52685e">${n}</text>`}
 const hi=Number.isFinite(Number(highlight))?`<circle cx="${x(Number(highlight))}" cy="${Y}" r="8" fill="#25845f"/>`:"";
 const move=Number.isFinite(Number(from))&&Number.isFinite(Number(to))?`<path d="M ${x(Number(from))} ${Y-16} Q ${(x(Number(from))+x(Number(to)))/2} ${Y-48} ${x(Number(to))} ${Y-16}" fill="none" stroke="#62bb92" stroke-width="4" stroke-linecap="round"/><path d="M ${x(Number(to))-7} ${Y-21} L ${x(Number(to))} ${Y-16} L ${x(Number(to))-7} ${Y-10}" fill="none" stroke="#62bb92" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>`:"";
 return `<div class="elementary-number-line"><svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Числовой луч с делениями" xmlns="http://www.w3.org/2000/svg"><line x1="${L}" y1="${Y}" x2="${W-R}" y2="${Y}" stroke="#52685e" stroke-width="3"/><path d="M ${W-R-10} ${Y-7} L ${W-R} ${Y} L ${W-R-10} ${Y+7}" fill="none" stroke="#52685e" stroke-width="3"/>${ticks}${labels}${move}${hi}</svg></div>`
}

