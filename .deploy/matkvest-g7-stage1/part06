const G8_PRE821_LESSON=g8Lesson;
g8Lesson=function(id){
 const raw=rawCourseId(id);
 if(raw==="elementary_favorable_events")return `<b>Что здесь происходит?</b><br>Представь: мы бросаем обычный кубик и заранее не знаем, какое число выпадет. Возможны шесть результатов: 1, 2, 3, 4, 5, 6.<br><br><b>Как это называется?</b><br>Каждый возможный результат называется <b>исходом</b>. <b>Событие</b> — это то, что нас интересует. Например: «выпало чётное число». Исходы 2, 4 и 6 подходят этому событию — их называют <b>благоприятными исходами</b>.<br><br><b>Запомни.</b><br>Один конкретный исход, например «выпало 4», называют <b>элементарным событием</b>.<br><br><b>Пример.</b><br>Событие «выпало число больше 4» происходит при исходах 5 и 6. Значит благоприятных исходов два.`;
 if(raw==="equiprobable_outcomes")return `<b>Что здесь происходит?</b><br>Если бросить правильную монету много раз, у орла и решки одинаковые шансы. У правильного кубика числа 1, 2, 3, 4, 5 и 6 тоже имеют одинаковый шанс выпасть.<br><br><b>Как это называется?</b><br>Исходы с одинаковыми шансами называются <b>равновозможными</b>.<br><br><b>Как действовать?</b><br>Если всего есть N равновозможных исходов, то вероятность одного конкретного исхода равна <span class="frac"><span class="num">1</span><span class="den">N</span></span>.<br><br><b>Пример.</b><br>У кубика 6 равновозможных исходов. Поэтому вероятность выпадения именно 4 равна <span class="frac"><span class="num">1</span><span class="den">6</span></span>.<br><br><b>Важно:</b> если один результат имеет больший шанс, чем другой, считать их равновозможными нельзя.`;
 if(raw==="event_probability_from_outcomes")return `<b>Что здесь происходит?</b><br>Допустим, бросаем кубик и хотим получить чётное число. Всего возможны 6 исходов, а подходят нам 3: 2, 4 и 6.<br><br><b>Как это называется?</b><br>Подходящие исходы называются <b>благоприятными</b>. Если все исходы равновозможны, вероятность показывает, какую долю всех исходов составляют благоприятные.<br><br><b>Как действовать?</b><br>1. Посчитай все возможные исходы — обозначим их число n.<br>2. Посчитай благоприятные исходы — обозначим их число m.<br>3. Раздели: <b>P(A) = </b><span class="frac"><span class="num">m</span><span class="den">n</span></span>.<br><br><b>Пример.</b><br>Для чётного числа на кубике m=3, n=6. Поэтому <b>P(A) = </b><span class="frac"><span class="num">3</span><span class="den">6</span></span> = <span class="frac"><span class="num">1</span><span class="den">2</span></span>.<br><br><b>Важно:</b> это правило применяем здесь только к равновозможным исходам.`;
 if(raw==="random_choice_probability")return `<b>Что здесь происходит?</b><br>В мешке лежат 5 шаров. Мы, не глядя, достаём один и заранее не знаем, какой попадётся. Если каждый отдельный шар выбирается с одинаковым шансом, можно считать подходящие предметы так же, как благоприятные исходы.<br><br><b>Как это называется?</b><br>Такой выбор называют <b>случайным выбором</b>.<br><br><b>Как действовать?</b><br>1. Посчитай все отдельные предметы.<br>2. Посчитай подходящие предметы.<br>3. Раздели число подходящих на число всех предметов.<br><br><b>Пример.</b><br>Из 5 шаров 2 красные. Вероятность случайно выбрать красный шар равна <span class="frac"><span class="num">2</span><span class="den">5</span></span>.<br><br><b>Частая ошибка:</b> считать не предметы, а только виды. Два цвета — это не два исхода, если самих шаров пять.`;
 if(raw==="tree_graph_basics")return `<b>Что здесь происходит?</b><br>Представь схему дорог между несколькими пунктами. Кружки — это пункты, линии — соединения между ними. Если по соединениям можно добраться между всеми пунктами и при этом нигде нельзя пройти по кругу и вернуться в начало другим путём, получается особая схема.<br><br><b>Как это называется?</b><br>Такая схема называется <b>деревом</b>. Точки дерева — <b>вершины</b>, соединяющие их линии — <b>рёбра</b>.<br><br><b>Как проверить?</b><br>1. Все вершины должны быть связаны между собой.<br>2. В дереве не должно быть циклов — замкнутых обходов.<br><br><b>Пример.</b><br>Если A соединена с B и C, а B соединена с D, это дерево: из любой вершины можно попасть в любую другую, но замкнутого круга нет.`;
 if(raw==="tree_unique_path_leaves")return `<b>Что здесь происходит?</b><br>В дереве между двумя вершинами нельзя выбрать два разных маршрута. Если бы второй маршрут существовал, вместе они образовали бы цикл, а в дереве циклов нет.<br><br><b>Как это называется?</b><br>Между любыми двумя вершинами дерева существует <b>ровно один путь</b>. Вершина, к которой подходит только одно ребро, называется <b>листом</b> (или висячей вершиной).<br><br><b>Как действовать?</b><br>Чтобы найти листья, посчитай рёбра у каждой вершины: если ребро только одно — это лист. Чтобы найти путь, двигайся по рёбрам от первой вершины к второй — другого пути в дереве не будет.<br><br><b>Пример.</b><br>Если A—B, A—C, B—D, то D и C — листья. Единственный путь от D до C: D—B—A—C.`;
 if(raw==="tree_vertices_edges_relation")return `<b>Что здесь происходит?</b><br>Дерево растёт очень аккуратно: когда мы добавляем новую вершину и хотим сохранить дерево, её нужно присоединить ровно одним новым ребром. Поэтому вершин всегда на одну больше, чем рёбер.<br><br><b>Школьное правило.</b><br>Если в дереве <b>V вершин</b>, то в нём <b>E = V − 1 рёбер</b>. И наоборот: <b>V = E + 1</b>.<br><br><b>Как действовать?</b><br>1. Определи, что дано: число вершин или рёбер.<br>2. Если даны вершины — вычти 1.<br>3. Если даны рёбра — прибавь 1.<br><br><b>Пример.</b><br>В дереве 7 вершин. Значит рёбер 7 − 1 = 6.`;
 if(raw==="tree_multiplication_rule")return `<b>Что здесь происходит?</b><br>Представь выбор в два шага. Сначала выбираем, например, одну из 3 футболок. После каждой футболки можно выбрать одни из 2 брюк. Для каждой первой возможности снова доступны все 2 вторые возможности.<br><br><b>Как это называется?</b><br>Это <b>правило умножения</b>. Дерево вариантов помогает увидеть каждый полный путь выбора.<br><br><b>Как действовать?</b><br>1. Посчитай варианты на первом шаге — пусть их m.<br>2. Посчитай варианты второго шага для каждого первого выбора — пусть их n.<br>3. Умножь: всего <b>m · n</b> полных вариантов.<br><br><b>Пример.</b><br>3 футболки и 2 пары брюк дают 3 · 2 = 6 комплектов. На дереве это 6 путей от начала до конечных вершин.<br><br><b>Частая ошибка:</b> складывать 3 + 2. Сложение считает отдельные варианты по шагам, а нам нужны все пары выборов.`;
 return G8_PRE821_LESSON(id)
};

