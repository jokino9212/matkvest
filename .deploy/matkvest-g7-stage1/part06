function trainingPlanAutoCompleteCurrent(kind,{minQuestions=1}={}){
 const ctx=trainingPlanRunContext,plan=trainingPlanNormalize(state.activeTrainingPlan);if(!ctx||!plan||ctx.planId!==plan.planId||ctx.type!==kind)return false;
