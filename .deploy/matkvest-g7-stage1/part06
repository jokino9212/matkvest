function trainingPlanMoveItem(profileId,itemId,delta){
 const hit=teacherProfileById(profileId),plan=hit&&trainingPlanForProfile(hit.profile);if(!plan)return;
 const i=plan.items.findIndex(x=>x.itemId===itemId),j=i+Number(delta||0);if(i<0||j<0||j>=plan.items.length)return;
 [plan.items[i],plan.items[j]]=[plan.items[j],plan.items[i]];plan.currentIndex=Math.max(0,plan.items.findIndex(x=>x.status!=="done"));plan.updatedAt=Date.now();trainingPlanPersistProfile(profileId);openTrainingPlanEditor(profileId)
}
function trainingPlanRemoveItem(profileId,itemId){
 const hit=teacherProfileById(profileId),plan=hit&&trainingPlanForProfile(hit.profile);if(!plan)return;
 plan.items=plan.items.filter(x=>x.itemId!==itemId);plan.currentIndex=Math.max(0,plan.items.findIndex(x=>x.status!=="done"));plan.updatedAt=Date.now();trainingPlanPersistProfile(profileId);openTrainingPlanEditor(profileId)
}
function trainingPlanSetItemStatus(plan,itemId,done){
 const item=plan?.items?.find(x=>x.itemId===itemId);if(!item)return false;
 const next=done?"done":"pending";if(item.status===next)return false;
 item.status=next;item.completedAt=done?Date.now():0;plan.updatedAt=Date.now();
 const pr=trainingPlanProgress(plan);if(pr.total&&pr.done===pr.total){plan.status="completed";plan.completedAt=plan.completedAt||Date.now()}else{plan.status="active";plan.completedAt=0}
 const nextI=plan.items.findIndex(x=>x.status!=="done");plan.currentIndex=nextI>=0?nextI:Math.max(0,plan.items.length-1);return true
}
function trainingPlanToggleDone(profileId,itemId){
