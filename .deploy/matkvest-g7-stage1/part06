 for(let i=0;i<12;i++){candidate=makeG1Question(sid);if(acceptable(candidate,{recent:true,used:true})){registerSignature(sig);candidate._signature=sig;G1_LAST_RETURNED[sid]={template:candidate.templateId,exact};return candidate}}
