 plan.currentIndex=Math.max(0,plan.items.findIndex(x=>x.itemId===itemId));plan.updatedAt=Date.now();state.activeTrainingPlan=plan;save();
 if(item.type==="quick"){openQuickTrainer(item.trainerId);quickSelection=quickNormalizeSelection(item.trainerId,item.selection||quickDefaultSelection(item.trainerId));quickSelection.smartMode=item.mode==="errors"?"errors":"weak";renderQuickIntro();trainingPlanAddReturnBar();return}
