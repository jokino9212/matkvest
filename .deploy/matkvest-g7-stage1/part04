 for(let c=0;c<cols;c++){
   if(c>=start && c<=end){
     // При умножении на десятки переносы сдвигаются влево
     // вместе со вторым неполным произведением.
     const sourceIndex=c+shift;
     const expected=sourceIndex<marks.length ? marks[sourceIndex] : "";
     h+=`<input class="work-in mark-in" maxlength="1" inputmode="numeric" data-exp="${expected}" data-row="${rowid}" data-col="${c}" aria-label="перенос при умножении ${label}, разряд ${c+1}" oninput="workInput(this)" onkeydown="workKey(event,this)">`;
