function randomNonZeroNumber(len){let s="";for(let i=0;i<len;i++)s+=String(ri(1,9));return Number(s)}
function divisionSteps(dividend,divisor){
 const ds=String(dividend).split("").map(Number);let cur=0,started=false,steps=[];
 for(let i=0;i<ds.length;i++){
   cur=cur*10+ds[i];
   if(!started&&cur<divisor)continue;
   started=true;
   const qd=Math.floor(cur/divisor),prod=qd*divisor,rem=cur-prod;
   steps.push({end:i,current:cur,qd:qd,product:prod,remainder:rem});
   cur=rem;
 }
 for(let k=0;k<steps.length-1;k++)steps[k].nextCurrent=steps[k+1].current;
 return steps;
}
function calcCarries(a,b,cols){
 const ad=digits(a,cols).map(x=>x===" "?0:Number(x));
 const bd=digits(b,cols).map(x=>x===" "?0:Number(x));
 const marks=Array(cols).fill("");let carry=0;
 for(let c=cols-1;c>=0;c--){
   const sum=ad[c]+bd[c]+carry;
   const next=sum>=10?1:0;
   if(next&&c>0)marks[c-1]="1";
   carry=next;
 }
 return marks;
}
function calcBorrows(a,b,cols){
 const ad=digits(a,cols).map(x=>x===" "?0:Number(x));
 const bd=digits(b,cols).map(x=>x===" "?0:Number(x));
 const receive=Array(cols).fill("");
 const donor=Array(cols).fill("");
 let borrow=0;
 for(let c=cols-1;c>=0;c--){
   const top=ad[c]-borrow;
   if(top<bd[c]){
     receive[c]="1";
     if(c>0) donor[c-1]="•";
     borrow=1;
   }else borrow=0;
 }
 return {receive,donor};
}
function calcMulCarries(a,digit,cols){
 const marks=Array(cols).fill("");
 const s=String(a);const start=cols-s.length;let carry=0;
 for(let i=s.length-1;i>=0;i--){
   const c=start+i;const p=Number(s[i])*digit+carry;
   carry=Math.floor(p/10);
   if(c>start && carry>0) marks[c-1]=String(carry);
 }
 return marks;
}
