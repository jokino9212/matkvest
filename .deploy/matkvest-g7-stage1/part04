const G8_VARIANT_DECKS=new Map();
function g8PickVariant(raw,d,variants){
 const key=raw+"|"+d,available=new Set(variants);
 let state=G8_VARIANT_DECKS.get(key);
 if(!state||state.pool.some(v=>!available.has(v))||state.pool.length===0){
  const pool=variants.slice();
  for(let i=pool.length-1;i>0;i--){const j=ri(0,i);[pool[i],pool[j]]=[pool[j],pool[i]];}
  if(state&&pool.length>1&&pool[pool.length-1]===state.last){
   const i=pool.findIndex(v=>v!==state.last);
   if(i>=0)[pool[i],pool[pool.length-1]]=[pool[pool.length-1],pool[i]];
  }
  state={pool,last:state?.last??null};G8_VARIANT_DECKS.set(key,state);
 }
 const value=state.pool.pop();state.last=value;
 return value;
}
