function makeG8Question(id,stageOverride=null){
 const raw=rawCourseId(id),d=Math.max(0,Math.min(2,Number.isInteger(stageOverride)?stageOverride:activeDifficulty())),full=`g8:${raw}`;
 if(!G8_STAGE81_IDS.has(full))throw new Error(`Тема 8 класса пока не реализована: ${raw}`);
 if(raw==="square_root_arithmetic")return g8Make81SquareRoot(raw,d);
 if(raw==="irrational_numbers_approximations")return g8Make81Irrational(raw,d);
 if(raw==="real_numbers_compare")return g8Make81RealCompare(raw,d);
 if(raw==="equation_x2_equals_a")return g8Make81Equation(raw,d);
 if(raw==="square_root_properties")return g8Make81Properties(raw,d);
 if(raw==="root_expression_transformations")return g8Make81Transform(raw,d);
 if(raw==="root_calculations_applications")return g8Make81Applications(raw,d);
 throw new Error(`Неизвестная тема 8.1: ${raw}`);
}

// Обычная сессия 8.1: не повторяем подряд templateId/signature и позицию ответа.
const G8_PRE81_FRESH=freshQuiz;
freshQuiz=function(id){
 const s=String(id),full=s.startsWith("g8:")?s:`g8:${rawCourseId(s)}`;
 if(!G8_STAGE81_IDS.has(full))return G8_PRE81_FRESH(id);
 const raw=rawCourseId(full),maker=()=>makeG8Question(full),sigOf=q=>q.sig||`g8:${raw}:${normalizePromptForCompare(q.text)}`;
 if(!blockSession||blockSession.kind!=="g8quiz")return freshCandidate(maker,sigOf,180);
 const prevV=blockSession._g8LastVariant?.[raw]??null,prevP=blockSession._g8LastPosition?.[raw]??-1,prevSig=blockSession._g8LastSig?.[raw]??null;
 let best=null,fallback=null;
 for(let i=0;i<100;i++){
  const cand=maker(),v=cand.templateId||cand.audit?.variant||"",p=g8ChoiceIndex(cand),sig=sigOf(cand);fallback=cand;
  if(prevV!==null&&v===prevV)continue;if(prevSig!==null&&sig===prevSig)continue;if(p>=0&&prevP>=0&&p===prevP)continue;if(wasUsedInBlock(sig)||wasRecent(sig))continue;
  registerSignature(sig);cand._signature=sig;best=cand;break;
 }
 if(!best)best=freshCandidate(maker,sigOf,220);
 blockSession._g8LastVariant=blockSession._g8LastVariant||{};blockSession._g8LastPosition=blockSession._g8LastPosition||{};blockSession._g8LastSig=blockSession._g8LastSig||{};
 blockSession._g8LastVariant[raw]=best.templateId||best.audit?.variant||"";blockSession._g8LastPosition[raw]=g8ChoiceIndex(best);blockSession._g8LastSig[raw]=best.sig||best._signature||sigOf(best);return best;
};

