const chartTree=(d,v,a,b,t,why)=>{const g=g8ChoiceTreeModel821(a,b);const q=g8Choice821('tree_multiplication_rule',d,v,g.gm,t,g.total,g8CountWrongs821(g.total),why,{m:a,n:b,total:g.total,expected:g.total});q.templateId=v;return q};
const MAX={tree_multiplication_rule:[5,7,10],opposite_events:[5,7,10],event_union_intersection:[5,7,10]};
const VAR={
 tree_multiplication_rule:[
