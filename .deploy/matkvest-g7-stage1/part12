function tree(d,v){const id='tree_multiplication_rule',m=R(2,4),n=R(2,5),p=R(2,4),tot=m*n;
 switch(v){
 case 'two_step':return intChoice(id,d,v,`На первом шаге ${m} варианта, на втором после каждого первого — ${n} вариантов. Сколько последовательностей из двух выборов?`,tot,`${m}·${n}=${tot}.`,{m,n});
 case 'read_tree':return chartTree(d,v,m,n,'Сколько полных путей от S к конечным вершинам изображено на дереве?',`В каждой из ${m} ветвей по ${n} концов, всего ${tot}.`);
 case 'pair_count':return intChoice(id,d,v,`Есть ${m} цвета бумаги и ${n} формы наклейки. Сколько разных пар «цвет, форма» можно составить?`,tot,`У каждого цвета ${n} форм. ${m}·${n}=${tot}.`,{m,n});
 case 'rule_reason':return ch(id,d,v,`Почему при ${m} вариантах первого шага и ${n} вариантах второго выбирают умножение?`,'каждый первый выбор сочетается с каждым вторым',['нужно выбирать только один шаг','число рёбер всегда равно произведению','складывать следует при любом последовательном выборе'],`Каждая из ${m} ветвей имеет ${n} продолжений.`,{m,n});
 case 'reverse_second':return intChoice(id,d,v,`Всего ${tot} сочетаний двух шагов. Первых вариантов ${m}, и у каждого одинаковое число продолжений. Сколько вторых вариантов?`,n,`${tot}:${m}=${n}.`,{m,n});
 case 'three_steps':return intChoice(id,d,v,`На трёх шагах имеется соответственно ${m}, ${n}, ${p} вариантов. Сколько полных последовательностей?`,tot*p,`${m}·${n}·${p}=${tot*p}.`,{m,n,p});
 case 'tour_routes':return intChoice(id,d,v,`Из посёлка A в B идут ${m} дороги, из B в C — ${n} дорог, из C в D — ${p} дороги. Сколько маршрутов из A в D через B и C?`,tot*p,`Переходы независимы по выбору дороги: ${m}·${n}·${p}=${tot*p}.`,{m,n,p});
 case 'reverse_first':return intChoice(id,d,v,`Получилось ${tot} различных пар. На втором шаге всегда ${n} вариантов. Сколько было вариантов первого шага?`,m,`${tot}:${n}=${m}.`,{m,n});
 case 'missed_leaves':{const missed=R(1,Math.min(3,tot-1));return intChoice(id,d,v,`В дереве выбора ${m} ветвей, каждая ведёт к ${n} концам. Ученик записал ${tot-missed} полных путей. Сколько он пропустил?`,missed,`Всего ${tot} путей, пропущено ${tot}−${tot-missed}=${missed}.`,{m,n,missed});}
 case 'restricted_pair':return intChoice(id,d,v,`Есть ${m} первых вариантов и ${n} вторых. Для одного конкретного первого варианта запрещено одно сочетание со вторым. Сколько разрешённых пар осталось?`,tot-1,`${m}·${n}−1=${tot-1}.`,{m,n});
 case 'two_shops':{const other=R(2,4);return intChoice(id,d,v,`В первом магазине ${m} видов футболок и ${n} брюк, во втором ${other} готовых комплекта. Сколько всего вариантов купить один комплект либо собрать в первом, либо взять готовый во втором?`,tot+other,`${m}·${n}+${other}=${tot+other}.`,{m,n,other});}
 case 'factor_missing':{const total=tot*p;return intChoice(id,d,v,`За три шага получилось ${total} последовательностей. На первом шаге ${m} вариантов, на третьем ${p}. Сколько одинаковых продолжений на втором?`,n,`${total}:(${m}·${p})=${n}.`,{m,n,p});}
 case 'no_replacement':return intChoice(id,d,v,`Из ${n+2} разных карточек последовательно берут две без возвращения, порядок важен. Сколько упорядоченных пар?`,(n+2)*(n+1),`(${n+2})·(${n+1})=${(n+2)*(n+1)}.`,{N:n+2});
 case 'three_reverse':return intChoice(id,d,v,`Трёхшаговый выбор даёт ${m*n*p} результатов. Первый шаг — ${m} варианта, второй — ${n}. Сколько вариантов на третьем?`,p,`${m*n*p}:(${m}·${n})=${p}.`,{m,n,p});
 case 'forbidden_pair':{const k=R(2,Math.min(4,tot-1));return intChoice(id,d,v,`На первом шаге ${m} вариантов, на втором ${n}. Запрещены ${k} конкретных различных пар. Сколько допустимых полных выборов?`,tot-k,`${tot}−${k}=${tot-k}.`,{m,n,k});}
 case 'at_least_one':return intChoice(id,d,v,`Код состоит из двух цифр 0–${n}, повторения разрешены. Сколько кодов содержат хотя бы один ноль?`,2*(n+1)-1,`Всего ${(n+1)**2}, без нулей ${n*n}. Разность ${2*(n+1)-1}.`,{N:n+1});
 case 'digit_codes':return intChoice(id,d,v,`Код из трёх цифр выбирают из ${m+2} разных цифр без повторения. Порядок важен. Сколько кодов?`,(m+2)*(m+1)*m,`${m+2}·${m+1}·${m}=${(m+2)*(m+1)*m}.`,{N:m+2});
 case 'three_outfits':return intChoice(id,d,v,`Сначала выбирают одну из ${m} рубашек, затем одни из ${n} брюк, затем одну из ${p} пар обуви. Один комплект определяют все три выбора. Сколько комплектов?`,tot*p,`${m}·${n}·${p}=${tot*p}.`,{m,n,p});
 case 'unequal_branches':{const x=n+1;return intChoice(id,d,v,`У первой вершины дерева две ветви: по первой есть ${n} конечных путей, по второй — ${x}. Сколько полных путей всего?`,n+x,`У ветвей разные числа продолжений, поэтому складываем ${n}+${x}=${n+x}.`,{n,x});}
 case 'independent_options':return intChoice(id,d,v,`Выбирают пароль: первая буква из ${m} символов, цифра из ${n}, последняя буква из ${p}; повторение букв разрешено. Сколько разных паролей?`,tot*p,`${m}·${n}·${p}=${tot*p}.`,{m,n,p});
 case 'missing_routes':{const lost=R(1,Math.min(4,tot-1));return intChoice(id,d,v,`Всего должно быть ${m}·${n} маршрутов, но на схеме отображены только ${tot-lost}. Сколько маршрутов ещё надо добавить?`,lost,`${m}·${n}−${tot-lost}=${lost}.`,{m,n,lost});}
 case 'four_stages':return intChoice(id,d,v,`Четыре шага имеют соответственно ${m}, ${n}, ${p} и 2 варианта. Сколько полных последовательностей можно составить?`,2*tot*p,`${m}·${n}·${p}·2=${2*tot*p}.`,{m,n,p});
 default:throw Error(v);
 }
}
function opposite(d,v){const id='opposite_events',N=R(5,12),a=R(1,N-1),b=N-a;
 switch(v){
 case 'meaning':return ch(id,d,v,'Событие A: «выпало чётное число». Какое событие противоположно A?','выпало нечётное число',['выпало число больше 3','выпало 2','выпало число меньше 6'],'Противоположное означает «A не произошло».');
 case 'dice_complement':{const A=[2,4,6],C=[1,3,5];return ch(id,d,v,`Кубик бросают один раз. A={${A.join('; ')}}. Найди Ā.`,set(C),[set(A),set([1,2,3]),set([5,6])],'Из {1;2;3;4;5;6} удаляем 2,4,6.',{A,C});}
 case 'one_minus':return prob(id,d,v,`P(A)=${FS(a,N)}. Найди P(Ā).`,b,N,`P(Ā)=1−${FS(a,N)}=${FS(b,N)}.`,{a,N});
 case 'certain':return ch(id,d,v,'Как называется событие, противоположное достоверному?','невозможное',['достоверное','любое случайное','независимое'],'Достоверное происходит всегда; противоположное никогда.');
 case 'count_complement':return intChoice(id,d,v,`В опыте ${N} равновозможных исходов, событию A благоприятствуют ${a}. Сколько исходов благоприятствуют Ā?`,b,`${N}−${a}=${b}.`,{a,N});
 case 'reverse_prob':return prob(id,d,v,`P(Ā)=${FS(a,N)}. Вычисли P(A).`,b,N,`P(A)=1−${FS(a,N)}=${FS(b,N)}.`,{a,N});
 case 'set_complement':{const U=Array.from({length:N},(_,i)=>i+1),A=U.filter(x=>x%3===0),C=U.filter(x=>x%3!==0);return ch(id,d,v,`Ω={1;…;${N}}. A: «число кратно 3». Каково Ā?`,'число не делится на 3',['число чётное','число кратно 3','число больше 3'],'Противоположное событие содержит все числа, не кратные 3.',{U,A,C});}
 case 'decimal_percent':{const p=R(10,85);return intChoice(id,d,v,`Вероятность A равна ${p}%. Чему равна вероятность Ā в процентах?`,100-p,`100%−${p}%=${100-p}%.`,{p});}
 case 'complement_compare':{const p=R(1,4);return ch(id,d,v,`P(A)=${p}/10, P(Ā)=1−P(A). Какое событие вероятнее?`,'противоположное Ā',['событие A','они равновероятны','сравнить нельзя'],`P(A)=${p}/10 < 1/2, поэтому P(Ā)>P(A).`,{p});}
 case 'ball_complement':return prob(id,d,v,`В мешке ${N} одинаковых по размеру шаров, ${a} красных. Один шар выбирают случайно. Найди вероятность НЕ красного шара.`,b,N,`Некрасных ${N}−${a}=${b}; P=${FS(b,N)}.`,{N,a});
 case 'impossible':return ch(id,d,v,'Какое событие противоположно невозможному?','достоверное',['невозможное','любое независимое','событие вероятности 1/2'],'Если A не происходит никогда, Ā происходит всегда.');
 case 'ratio_complement':{const n=R(2,5),k=R(2,4),whole=n*k,good=n;return prob(id,d,v,`В урне ${whole} равновозможных жетонов. Из них ${good} с цифрой 1. Найди вероятность НЕ получить цифру 1.`,whole-good,whole,`(${whole}−${good})/${whole}=${FS(whole-good,whole)}.`,{whole,good});}
 case 'two_tosses':return prob(id,d,v,'Две правильные монеты бросают независимо. Найди вероятность, что выпадет хотя бы один орёл.',3,4,'Противоположное: обе решки с вероятностью 1/4, значит 1−1/4=3/4.',{space:4,favorable:3});
 case 'not_both':return prob(id,d,v,'Два правильных кубика бросают независимо. Найди вероятность того, что НЕ выпадут одновременно две шестёрки.',35,36,'Противоположное событие «две шестёрки» имеет вероятность 1/36.',{space:36,favorable:35});
 case 'at_least_one':return prob(id,d,v,'Три правильные монеты бросают независимо. Найди вероятность, что хотя бы одна — решка.',7,8,'Противоположное: три орла из восьми равновозможных исходов — один случай.',{space:8,favorable:7});
 case 'reverse_fraction':{const k=R(2,6),n=R(1,k-1);return prob(id,d,v,`P(Ā)=${FS(n,k)}. Вычисли P(A) при условии, что A и Ā — противоположные события.`,k-n,k,`1−${FS(n,k)}=${FS(k-n,k)}.`,{k,n});}
 case 'de_morgan':return ch(id,d,v,'Как описать событие «НЕ произошло ни A, ни B»?','не произошло A и не произошло B',['не произошло A или не произошло B','произошли оба A и B','произошло хотя бы одно'],'Это противоположное событию A∪B, по закону де Моргана: Ā∩B̄.');
 case 'find_total':{const k=R(2,6),good=R(1,k-1),scale=R(2,5);return intChoice(id,d,v,`Из ${k*scale} равновозможных исходов событию Ā благоприятствуют ${good*scale}. Сколько исходов благоприятствуют A?`,(k-good)*scale,`${k*scale}−${good*scale}=${(k-good)*scale}.`,{k,good,scale});}
 case 'check_probability':{const p=P([1,2,3,4,6,7,8,9]),yes=Math.random()<.5,shown=yes?10-p:p;return yn(id,d,v,`Ученик утверждает: «Если P(A)=${p}/10, то P(Ā)=${shown}/10». Верно ли?`,yes,`Правильно: P(Ā)=${10-p}/10.`,{p,shown,yes});}
 case 'count_not_both':return intChoice(id,d,v,'Из всех упорядоченных пар результатов двух кубиков сколько НЕ являются парой (6;6)?',35,'Всего 6·6=36; исключаем одну пару.',{space:36,favorable:35});
 case 'quality_control':{const defective=R(1,5),total=R(7,13);return prob(id,d,v,`Из партии ${total} изделий ${defective} бракованных. Случайно выбирают одно. Найди вероятность получить исправное изделие.`,total-defective,total,`Исправных ${total-defective}, всего ${total}.`,{total,defective});}
 case 'three_tosses':return intChoice(id,d,v,'Три монеты бросают независимо. Сколько из 8 упорядоченных исходов содержат хотя бы одного орла?',7,'Единственный не подходящий исход — три решки.',{space:8,favorable:7});
 default:throw Error(v)
 }
}
function events(d,v){const id='event_union_intersection',N=R(8,15),a=R(3,6),b=R(3,7),shared=R(1,Math.min(a,b)-1),uni=a+b-shared;
 switch(v){
 case 'meaning_union':return ch(id,d,v,'Что означает A∪B?','произошло хотя бы одно из событий A и B',['произошли только оба события','не произошло ни одно','произошло только A'],'Событие A∪B включает исходы A, B и общие исходы.');
 case 'meaning_inter':return ch(id,d,v,'Что означает A∩B?','произошли оба события A и B',['произошло хотя бы одно','не произошло A','произошло ровно одно'],'Пересечение требует выполнения обоих событий.');
 case 'union_dice':{const A=[2,4,6],B=[4,5,6],U=[2,4,5,6];return ch(id,d,v,`A=${set(A)}, B=${set(B)}. Найди A∪B.`,set(U),[set([4,6]),set(A),set(B)],'Объединяем все исходы без повторов.',{A,B,U});}
 case 'inter_dice':{const A=[2,4,6],B=[4,5,6],I=[4,6];return ch(id,d,v,`A=${set(A)}, B=${set(B)}. Найди A∩B.`,set(I),[set([2,4,5,6]),set(A),set([2,5])],'Пересечение содержит общие элементы 4 и 6.',{A,B,I});}
 case 'membership':return yn(id,d,v,'Для кубика A: «чётное», B: «больше 3». Входит ли исход 4 в A∩B?',true,'4 чётное и больше 3.',{x:4});
 case 'count_union':return intChoice(id,d,v,`В пространстве исходов событиям A и B благоприятствуют ${a} и ${b} исходов, из них ${shared} общих. Сколько исходов в A∪B?`,uni,`${a}+${b}−${shared}=${uni}.`,{a,b,shared});
