function discriminant(r,d,v){
 if(v==='d_formula')return CHO(r,d,v,'Для квадратного уравнения ax²+bx+c=0 какая формула дискриминанта верна?','D=b²−4ac',['D=b²+4ac','D=2b−4ac','D=a²−4bc'],'Квадратный коэффициент a≠0, дискриминант D=b²−4ac.',{kind:v});
 if(v==='d_compute'){const a=PK([1,2,3]),x=RI(1,6),y=RI(x+1,x+5),b=-a*(x+y),c=a*x*y,m=POLY(a,b,c);return NUM(r,d,v,`Найди дискриминант уравнения ${EQ(a,b,c)}.`,m.D,`D=${S(b)}²−4·${a}·${c}=${m.D}.`,{kind:v,...m});}
 if(v==='d_two_root'){const x=RI(1,7),y=RI(x+1,x+7),b=-(x+y),c=x*y;return CHO(r,d,v,`Найди два корня уравнения ${EQ(1,b,c)}.`,SORT([x,y]),[SORT([-x,-y]),SORT([x]),'действительных корней нет'],`D=(${x-y})²>0. По формуле корней получаем ${x} и ${y}.`,{kind:v,...POLY(1,b,c),roots:[x,y]});}
 if(v==='d_one_root'){const x=NN(-8,8),b=-2*x,c=x*x;return NUM(r,d,v,`Уравнение ${EQ(1,b,c)} имеет один действительный корень. Найди его.`,x,`D=0; x=−b/(2a)=${x}.`,{kind:v,...POLY(1,b,c),roots:[x]});}
 if(v==='d_coefficient'){const a=RI(1,5),b=NN(-9,9),c=RI(1,9);return NUM(r,d,v,`У квадратного уравнения ${EQ(a,b,c)} какое значение имеет b²?`,b*b,`b=${S(b)}, поэтому b²=${b*b}.`,{kind:v,...POLY(a,b,c)});}
 if(v==='d_negative_b'){const a=PK([1,2,3]),x=RI(1,6),y=RI(x+1,x+5),b=-a*(x+y),c=a*x*y,m=POLY(a,b,c);return NUM(r,d,v,`Для ${EQ(a,b,c)} вычисли b²−4ac, не потеряв знак b.`,m.D,`D=(${S(b)})²−4·${a}·${c}=${m.D}.`,{kind:v,...m});}
 if(v==='d_solve_pair'){const a=PK([2,3]),x=RI(-7,-2),y=RI(1,7),b=-a*(x+y),c=a*x*y;return CHO(r,d,v,`Реши с помощью дискриминанта ${EQ(a,b,c)}.`,SORT([x,y]),[SORT([x,-y]),SORT([x]),SORT([y])],`D=${a*a*(x-y)*(x-y)}; корни ${x} и ${y}.`,{kind:v,...POLY(a,b,c),roots:[x,y]});}
 if(v==='d_shift_constant'){const a=RI(1,4),x=RI(1,5),y=RI(x+1,9),b=-a*(x+y),c=a*x*y,k=RI(2,8);const m=POLY(a,b,c);return NUM(r,d,v,`В уравнении <span class="math">${F(a,b,c+k)} = ${k}</span> сначала перенеси правую часть. Чему равен дискриминант?`,m.D,`После переноса c=${c}; D=(${S(b)})²−4·${a}·${c}=${m.D}.`,{kind:v,...m,k});}
 if(v==='d_double_root'){const a=PK([2,3,4]),x=NN(-6,6),b=-2*a*x,c=a*x*x;return NUM(r,d,v,`Найди единственный действительный корень ${EQ(a,b,c)}.`,x,`D=${b*b}−4·${a}·${c}=0; x=−b/(2a)=${x}.`,{kind:v,...POLY(a,b,c),roots:[x]});}
 if(v==='d_scale_equation'){const x=RI(-5,-1),y=RI(1,6),k=PK([2,3,4]),b=-(x+y),c=x*y,m=POLY(k,k*b,k*c);return NUM(r,d,v,`Обе части уравнения ${EQ(1,b,c)} умножили на ${k}. Чему равен дискриминант полученного уравнения?`,m.D,`При умножении коэффициентов на ${k} дискриминант умножается на ${k*k}: D=${m.D}.`,{kind:v,...m,k});}
 if(v==='d_param_double'){const a=1,u=RI(2,8),b=-2*u,c=u*u,t=RI(2,9);return NUM(r,d,v,`При каком t уравнение <span class="math">x² ${b<0?'−':'+'} ${Math.abs(b)}x + t = 0</span> имеет один действительный корень?`,c,`D=${b*b}−4t=0, поэтому t=${c}.`,{kind:v,a,b,c,parameter:'c',roots:[u],t});}
 if(v==='d_inverse_c'){const a=PK([1,2,3]),b=PK([4,6,8,10]),c=RI(-9,9),D=b*b-4*a*c;return NUM(r,d,v,`У квадратного уравнения a=${a}, b=${b} и дискриминант D=${D}. Найди c.`,c,`Из D=b²−4ac получаем c=(b²−D)/(4a)=(${b*b}−${D})/${4*a}=${c}.`,{kind:v,...POLY(a,b,c)});}
 if(v==='d_param_two'){const a=1,b=0,t=RI(2,9);return CHO(r,d,v,`Для каких значений t у уравнения <span class="math">x² + t = 0</span> два различных действительных корня?`,'t < 0',['t > 0','t = 0','для любого t'],`D=−4t>0 только при t<0.`,{kind:v,a,b,parameter:'c'});}
 if(v==='d_root_sum'){const a=PK([2,3,4]),x=RI(-8,-2),y=RI(1,8),b=-a*(x+y),c=a*x*y;return NUM(r,d,v,`Найди сумму корней квадратного уравнения ${EQ(a,b,c)}.`,x+y,`D>0; корни ${S(x)} и ${y}, их сумма ${S(x+y)}.`,{kind:v,...POLY(a,b,c),roots:[x,y]});}
 const a=PK([1,2,3]),x=RI(1,5),y=RI(x+1,8),k=PK([2,3,4]),b=-a*(x+y),c=a*x*y;return NUM(r,d,v,`Первое уравнение: ${EQ(a,b,c)}. Второе получено умножением всех его коэффициентов на ${k}. Во сколько раз дискриминант второго больше первого?`,k*k,`При умножении коэффициентов на ${k} дискриминант умножается на ${k}²=${k*k}.`,{kind:v,a,b,c,k});
}
function rootsCases(r,d,v){
 if(v==='n_positive'){const d0=PK([1,4,9,16,25,36]);return CHO(r,d,v,`Если D=${d0}, сколько различных действительных корней имеет квадратное уравнение?`,'2',['0','1','бесконечно много'],`При D>0 корней два.`,{kind:v,D:d0,expectedCount:2});}
 if(v==='n_zero')return CHO(r,d,v,'Сколько различных действительных корней квадратного уравнения при D=0?','1',['0','2','бесконечно много'],'При D=0 корень один (двукратный).',{kind:v,D:0,expectedCount:1});
 if(v==='n_negative'){const D=-RI(1,30);return CHO(r,d,v,`Сколько действительных корней при D=${S(D)}?`,'0',['1','2','бесконечно много'],'При отрицательном дискриминанте действительных корней нет.',{kind:v,D,expectedCount:0});}
 if(v==='n_formula_rule')return CHO(r,d,v,'Какое неравенство на дискриминант гарантирует два различных действительных корня?','D > 0',['D = 0','D < 0','D ≤ 0'],'Для двух различных действительных корней D должен быть положительным.',{kind:v});
 if(v==='n_compute_count'){const a=RI(1,4),u=RI(2,7),b=-2*a*u,c=a*u*u;return NUM(r,d,v,`Определи число различных действительных корней ${EQ(a,b,c)}.`,1,`D=0, поэтому единственный действительный корень.`,{kind:v,...POLY(a,b,c),expectedCount:1});}
 if(v==='n_shift'){const a=PK([1,2]),x=RI(1,5),y=RI(x+1,8),b=-a*(x+y),c=a*x*y,k=RI(2,10);return NUM(r,d,v,`Сколько действительных корней у <span class="math">${F(a,b,c+k)} = ${k}</span>?`,2,`После переноса получаем ${F(a,b,c)}=0, D=${a*a*(x-y)*(x-y)}>0.`,{kind:v,...POLY(a,b,c),expectedCount:2,k});}
 if(v==='n_scaled'){const a=RI(1,5),u=RI(2,6),b=-2*a*u,c=a*u*u;return CHO(r,d,v,`Сколько корней у ${EQ(-a,-b,-c)}?`,'1',['0','2','бесконечно много'],`Умножение на −1 не меняет корни; дискриминант равен 0.`,{kind:v,...POLY(-a,-b,-c),expectedCount:1});}
 if(v==='n_parameter_one'){const b=2*RI(2,9);return NUM(r,d,v,`Найди значение t, при котором <span class="math">x² − ${b}x + t = 0</span> имеет единственный действительный корень.`,b*b/4,`D=${b*b}−4t=0; t=${b*b/4}.`,{kind:v,b:-b,c:b*b/4,expectedCount:1});}
 if(v==='n_classify'){const a=RI(1,4),p=RI(2,8),b=-2*a*p,c=a*p*p;return CHO(r,d,v,`Для ${EQ(a,b,c)} дискриминант…`,'равен нулю',['положителен','отрицателен','зависит от x'],`Это квадрат полного квадрата a(x−${p})²=0, следовательно D=0.`,{kind:v,...POLY(a,b,c),expectedCount:1});}
 if(v==='n_change_c'){const u=RI(2,7),k=RI(1,u*u-1);return NUM(r,d,v,`Уравнение <span class="math">x² − ${u*u} + ${k} = 0</span> имеет сколько различных действительных корней?`,2,`x²=${u*u-k}>0, значит корней два.`,{kind:v,a:1,b:0,c:-u*u+k,expectedCount:2});}
 if(v==='n_parameter_range'){const m=RI(2,9);return CHO(r,d,v,`При каких t уравнение <span class="math">x² − ${2*m}x + t = 0</span> имеет два различных действительных корня?`,`t < ${m*m}`,[`t > ${m*m}`,`t = ${m*m}`,`t ≤ ${m*m}`],`D=${4*m*m}−4t>0, когда t<${m*m}.`,{kind:v,m,limit:m*m});}
 if(v==='n_parameter_threshold'){const m=RI(3,10);return CHO(r,d,v,`При каких t у уравнения <span class="math">x² − ${2*m}x + t = 0</span> нет действительных корней?`,`t > ${m*m}`,[`t < ${m*m}`,`t = ${m*m}`,`t ≥ ${m*m}`],`D=${4*m*m}−4t<0 при t>${m*m}.`,{kind:v,m,limit:m*m});}
 if(v==='n_border'){const a=RI(2,5),m=RI(2,6);return NUM(r,d,v,`При каком c уравнение <span class="math">${a}x² − ${2*a*m}x + c = 0</span> имеет один действительный корень?`,a*m*m,`D=(${2*a*m})²−4·${a}c=0; c=${a*m*m}.`,{kind:v,a,b:-2*a*m,c:a*m*m,expectedCount:1});}
 if(v==='n_parameter_b'){const a=PK([1,2,3]),c=RI(2,8),k=RI(2,6);return CHO(r,d,v,`Уравнение <span class="math">${a}x² + t x + ${c} = 0</span> не имеет действительных корней, если…`,`t² < ${4*a*c}`,[`t² > ${4*a*c}`,`t² = ${4*a*c}`,`t² ≥ ${4*a*c}`],`D=t²−${4*a*c}<0 только при t²<${4*a*c}.`,{kind:v,a,c,limit:4*a*c});}
 const a=RI(1,4),x=RI(1,5),y=x+2*RI(1,3),b=-a*(x+y),c=a*x*y,m=POLY(a,b,c);return NUM(r,d,v,`Первое уравнение ${EQ(a,b,c)}, второе ${EQ(a,b,c+m.D/(4*a))}. На сколько число различных действительных корней первого больше второго?`,1,`Первое имеет D=${m.D}>0 (2 корня), второе D=0 (1 корень). Разность 1.`,{kind:v,...m,expectedCount:2});
}
function vieta(r,d,v){
 if(v==='v_sum'){const u=RI(-7,-2),w=RI(1,7),b=-(u+w),c=u*w;return NUM(r,d,v,`Найди сумму корней ${EQ(1,b,c)} по теореме Виета.`,u+w,`x₁+x₂=−b=${S(u+w)}.`,{kind:v,a:1,b,c,roots:[u,w]});}
 if(v==='v_product'){const u=RI(-7,-2),w=RI(1,7),b=-(u+w),c=u*w;return NUM(r,d,v,`Найди произведение корней ${EQ(1,b,c)}.`,c,`x₁x₂=c=${S(c)}.`,{kind:v,a:1,b,c,roots:[u,w]});}
 if(v==='v_other_root'){const u=NN(-8,8),w=PK(Array.from({length:15},(_,i)=>i-7).filter(n=>n!==0&&n!==u));const b=-(u+w),c=u*w;return NUM(r,d,v,`Один корень ${EQ(1,b,c)} равен ${S(u)}. Найди второй корень.`,w,`Сумма корней −b=${S(u+w)}; второй корень равен ${S(u+w)}−${S(u)}=${S(w)}.`,{kind:v,a:1,b,c,roots:[u,w],known:u});}
 if(v==='v_rules')return CHO(r,d,v,'Для приведённого квадратного уравнения x²+px+q=0 каковы сумма и произведение корней?','−p и q',['p и q','−p и −q','q и −p'],'По Виету: сумма равна −p, произведение — q.',{kind:v});
 if(v==='v_sign'){const u=RI(2,8),w=RI(2,8);return CHO(r,d,v,`Если действительные корни приведённого квадратного уравнения имеют сумму ${u+w} и произведение ${u*w}, то оба корня…`,'положительные',['отрицательные','разных знаков','один равен нулю'],'Положительные сумма и произведение при действительных корнях означают два положительных корня.',{kind:v,roots:[u,w]});}
 if(v==='v_find_c'){const u=RI(-8,-2),w=RI(1,9),b=-(u+w);return NUM(r,d,v,`У уравнения <span class="math">x² ${b?(b>0?'+ '+b:'− '+(-b))+'x':''} + c = 0</span> корни ${S(u)} и ${S(w)}. Найди c.`,u*w,`По Виету c=x₁x₂=${S(u)}·${w}=${S(u*w)}.`,{kind:v,a:1,b,c:u*w,roots:[u,w]});}
 if(v==='v_find_b'){const u=RI(-8,-1),w=RI(1,8),c=u*w;return NUM(r,d,v,`Для приведённого квадратного уравнения с корнями ${S(u)} и ${w} найди коэффициент b при x.`,-(u+w),`b=−(x₁+x₂)=−(${S(u)}+${w})=${S(-(u+w))}.`,{kind:v,a:1,b:-(u+w),c,roots:[u,w]});}
 if(v==='v_pair'){const u=RI(-8,-2),w=RI(1,8),b=-(u+w),c=u*w;return CHO(r,d,v,`Выбери пару корней ${EQ(1,b,c)}.`,SORT([u,w]),[SORT([u,-w]),SORT([u]),SORT([w])],`Сумма ${S(u+w)}=−b, произведение ${S(u*w)}=c.`,{kind:v,a:1,b,c,roots:[u,w]});}
 if(v==='v_nonmonic'){const a=PK([2,3,4,5]),u=RI(-6,-1),w=RI(2,8),b=-a*(u+w),c=a*u*w;return NUM(r,d,v,`Найди произведение корней ${EQ(a,b,c)}.`,u*w,`Для ax²+bx+c=0 произведение корней c/a=${c}/${a}=${u*w}.`,{kind:v,a,b,c,roots:[u,w]});}
 if(v==='v_verify_root'){const u=RI(-7,-2),w=RI(1,7),b=-(u+w),c=u*w;return CHO(r,d,v,`Какой набор верно описывает корни ${EQ(1,b,c)}?`,`сумма ${S(u+w)}, произведение ${S(c)}`,[`сумма ${S(u+w+1)}, произведение ${S(c)}`,`сумма ${S(u+w)}, произведение ${S(-c)}`,`сумма ${S(c)}, произведение ${S(u+w)}`],`По Виету сумма −b=${S(u+w)}, произведение c=${S(c)}.`,{kind:v,a:1,b,c,roots:[u,w]});}
 if(v==='v_reconstruct'){const u=RI(-8,-2),w=RI(1,9),b=-(u+w),c=u*w;return CHO(r,d,v,`Корни равны ${S(u)} и ${w}. Выбери приведённое квадратное уравнение с этими корнями.`,F(1,b,c)+' = 0',[F(1,b+1,c)+' = 0',F(1,b,-c)+' = 0',F(1,b+1,-c)+' = 0'],`Сумма ${S(u+w)}, значит b=${S(b)}; произведение ${S(c)}.`,{kind:v,a:1,b,c,roots:[u,w]});}
 if(v==='v_param_sum'){const a=RI(2,5),u=RI(-7,-2),w=RI(2,8),b=-a*(u+w),c=a*u*w;return NUM(r,d,v,`Корни уравнения <span class="math">${a}x² + tx ${c<0?'− '+Math.abs(c):'+ '+c} = 0</span> имеют сумму ${S(u+w)}. Найди t.`,b,`x₁+x₂=−t/${a}; t=−${a}·${SB(u+w)}=${S(b)}.`,{kind:v,a,b,c,roots:[u,w]});}
 if(v==='v_param_product'){const a=RI(2,5),u=RI(-7,-2),w=RI(2,8),b=-a*(u+w),c=a*u*w;return NUM(r,d,v,`Произведение корней квадратного уравнения <span class="math">${a}x² ${b>=0?'+ '+b:'− '+(-b)}x + t = 0</span> равно ${S(u*w)}. Найди t.`,c,`x₁x₂=t/${a}; t=${a}·${SB(u*w)}=${S(c)}.`,{kind:v,a,b,c,roots:[u,w]});}
 if(v==='v_shift'){const u=RI(-7,-2),w=RI(1,8),k=RI(2,5),b=-(u+w),c=u*w;return NUM(r,d,v,`Корни ${EQ(1,b,c)} увеличили каждый на ${k}. Найди произведение новых корней.`,(u+k)*(w+k),`Новые корни ${S(u+k)} и ${S(w+k)}; произведение ${S((u+k)*(w+k))}.`,{kind:v,a:1,b,c,roots:[u,w],k});}
 const a=PK([2,3,4]),u=RI(-8,-2),w=RI(2,8),b=-a*(u+w),c=a*u*w;return CHO(r,d,v,`Найди оба корня ${EQ(a,b,c)} с помощью теоремы Виета (после деления на a).`,SORT([u,w]),[SORT([u,-w]),SORT([u]),SORT([w])],`После деления на ${a} получаем приведённое уравнение с суммой ${S(u+w)} и произведением ${S(u*w)}.`,{kind:v,a,b,c,roots:[u,w]});
}
