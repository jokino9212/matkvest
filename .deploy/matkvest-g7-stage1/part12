const unique=(a)=>[...new Set(a)];
function makeNumber(raw,stage,v,body,answer,ex,model,meta,unit=''){
 if(!Number.isSafeInteger(answer))throw Error('QA2 non-integer '+v+': '+answer);
 const sig=`g8:qa2:${raw}:${stage}:${v}:`+body.replace(/<[^>]+>/g,'').replace(/\s+/g,'_');
 const q=g7GeoNumber(body,answer,ex,sig,{type:'g8FinalBatch2',topic:raw,variant:v,stage,meta},model,'',unit);
 q.templateId='qa2_'+v;
 return q;
}
function makeChoice(raw,stage,v,body,answer,wrong,ex,model,meta={}){
 const opts=unique(wrong.map(String)).filter(x=>x!==String(answer));
 if(opts.length<3)throw Error('QA2 insufficient distractors '+v);
 const sig=`g8:qa2:${raw}:${stage}:${v}:`+body.replace(/<[^>]+>/g,'').replace(/\s+/g,'_');
 const q=g7GeoChoice(body,String(answer),opts.slice(0,3),ex,sig,{type:'g8FinalBatch2',topic:raw,variant:v,stage,meta},model);
 q.templateId='qa2_'+v;
 return q;
}
function geo(shape,dims={},labels={},extra={}){
 return {kind:'g7-g8-final-qa2',shape,dims:{...dims},labels:{...labels},caption:extra.caption||'Схема фигуры: подписаны только известные по условию величины.',...extra};
}
function rect(a=7,b=5,labels={},opt={}){return geo('rectangle',{a,b},labels,opt)}
function par(a=8,h=5,labels={},opt={}){return geo('parallelogram',{a,h,...(opt.side?{side:opt.side}:{})},labels,opt)}
function rhh(a=10,h=8,labels={},opt={}){if(h>a||h<=0)throw Error('impossible rhombus');return geo('rhombus-height',{a,h},labels,opt)}
function rhd(d1=10,d2=12,labels={},opt={}){return geo('rhombus-diagonals',{d1,d2},labels,opt)}
function trap(a=8,b=14,h=6,labels={},opt={}){if(a>=b||a<=0||h<=0)throw Error('bad trapezoid dimensions');return geo('trapezoid',{a,b,h},labels,opt)}
function makeRect(stage,v){const raw='rectangle_properties_tests';let a,b,x,y,p,s,z,diag,m;
 const N=(body,answer,ex,model,meta={},unit='см')=>makeNumber(raw,stage,v,body,answer,ex,model,meta,unit);
 const C=(body,c,wrong,ex,model,meta={})=>makeChoice(raw,stage,v,body,c,wrong,ex,model,meta);
 switch(v){
 case 'rect_definition':return C('Параллелограмм ABCD имеет один прямой угол. Какая это фигура?', 'прямоугольник',['ромб, но не прямоугольник','произвольная трапеция','определить невозможно'],'В параллелограмме наличие одного прямого угла означает, что все углы прямые.',rect(),{rule:'rectangle_test'});
 case 'rect_angles':return N('В прямоугольнике один внутренний угол равен 90°. Найди сумму трёх других углов.',270,'У каждого прямоугольника четыре прямых угла; 3·90=270°.',rect(),{angles:[90,90,90,90]},'°');
 case 'rect_diagonal_equal':x=2*r(5,18);return N(`Диагональ AC прямоугольника равна ${x} см. Найди диагональ BD.`,x,`Диагонали прямоугольника равны: BD=AC=${x}.`,rect(3*x/5,4*x/5,{AC:`${x} см`},{diagonals:true}),{AC:x,BD:x});
 case 'rect_diag_half':x=2*r(4,17);return N(`Диагональ AC прямоугольника длиной ${x} см пересекает BD в точке O. Найди AO.`,x/2,`Диагонали делятся пополам: AO=${x}/2=${x/2}.`,rect(3*x/5,4*x/5,{AC:`${x} см`},{diagonals:true}),{AC:x,AO:x/2});
 case 'rect_perimeter':a=r(5,15);b=r(3,12);return N(`Стороны прямоугольника ${a} см и ${b} см. Найди периметр.`,2*(a+b),`P=2(${a}+${b})=${2*(a+b)}.`,rect(a,b,{a:`${a} см`,b:`${b} см`}),{a,b});
 case 'rect_area':a=r(6,17);b=r(3,13);return N(`Длина прямоугольника ${a} см, ширина ${b} см. Найди его площадь.`,a*b,`S=${a}·${b}=${a*b} см².`,rect(a,b,{a:`${a} см`,b:`${b} см`}),{a,b},'см²');
 case 'rect_missing_side':a=r(7,19);b=r(3,12);p=2*(a+b);return N(`Периметр прямоугольника ${p} см, одна сторона ${a} см. Найди другую сторону.`,b,`Полупериметр ${p}/2=${a+b}, искомая сторона ${a+b}−${a}=${b}.`,rect(a,b,{a:`${a} см`}),{a,b,p});
 case 'rect_diag_from_half':x=r(5,19);return N(`Диагонали прямоугольника пересекаются в O. Если AO=${x} см, какова длина BD?`,2*x,`AC=2AO=${2*x}, а BD=AC.`,rect(6*x/5,8*x/5,{AO:`${x} см`},{diagonals:true}),{AO:x,BD:2*x});
 case 'rect_pythagoras_diagonal':[a,b,diag]=triple();return N(`Стороны прямоугольника равны ${a} см и ${b} см. Найди диагональ.`,diag,`d²=${a}²+${b}²=${diag*diag}, значит d=${diag}.`,rect(a,b,{a:`${a} см`,b:`${b} см`},{diagonals:true}),{a,b,diag});
 case 'rect_perimeter_ratio':x=pick([2,3,4]);a=r(4,10);b=a*x;p=2*(a+b);return N(`Периметр прямоугольника ${p} см, длина в ${x} раза больше ширины. Найди ширину.`,a,`P/2=${a+b}=(1+${x})·a, значит a=${a}.`,rect(b,a,{a:`?`,b:`?`}),{a,b,p,ratio:x});
 case 'rect_perimeter_from_area':a=r(4,12);b=r(4,11);s=a*b;return N(`Площадь прямоугольника ${s} см², ширина ${b} см. Вычисли периметр.`,2*(a+b),`Длина S/b=${s}/${b}=${a}. P=2(${a}+${b})=${2*(a+b)}.`,rect(a,b,{b:`${b} см`}),{a,b,s});
 case 'rect_midpoint_diag':x=r(5,16);return N(`В прямоугольнике ABCD диагонали пересекаются в O. Если AO=${x} см, найди сумму отрезков AO, BO, CO и DO.`,4*x,`Все четыре полуотрезка диагоналей равны ${x} см, сумма ${4*x} см.`,rect(6*x/5,8*x/5,{AO:`${x} см`},{diagonals:true}),{AO:x});
 case 'rect_other_side_from_diagonal':[a,b,diag]=triple();return N(`Диагональ прямоугольника ${diag} см, одна сторона ${a} см. Найди другую сторону.`,b,`b=√(${diag}²−${a}²)=√${b*b}=${b}.`,rect(a,b,{a:`${a} см`,AC:`${diag} см`},{diagonals:true}),{a,b,diag});
 case 'rect_area_from_diag_side':[a,b,diag]=triple();return N(`У прямоугольника диагональ ${diag} см, одна сторона ${a} см. Найди площадь.`,a*b,`Вторая сторона √(${diag}²−${a}²)=${b}, площадь ${a}·${b}=${a*b}.`,rect(a,b,{a:`${a} см`,AC:`${diag} см`},{diagonals:true}),{a,b,diag},'см²');
 case 'rect_perimeter_from_diag_side':[a,b,diag]=triple();return N(`Диагональ прямоугольника ${diag} см, ширина ${b} см. Найди периметр.`,2*(a+b),`Длина √(${diag}²−${b}²)=${a}; P=2(${a}+${b})=${2*(a+b)}.`,rect(a,b,{b:`${b} см`,AC:`${diag} см`},{diagonals:true}),{a,b,diag});
 case 'rect_area_perim_pair':a=r(5,12);b=a+r(2,9);p=2*(a+b);return N(`Периметр прямоугольника ${p} см, длина на ${b-a} см больше ширины. Найди его площадь.`,a*b,`a+b=${a+b}, b−a=${b-a}, откуда a=${a}, b=${b}; S=${a*b}.`,rect(b,a),{a,b,p},'см²');
 case 'rect_ratio_and_area':x=pick([2,3,4]);a=r(3,9);b=x*a;return N(`Ширина прямоугольника ${a} см, его длина в ${x} раза больше. Найди площадь, если обе стороны увеличили ещё в 2 раза.`,4*a*b,`Исходная площадь ${a}·${b}=${a*b}; при удвоении обеих сторон площадь увеличивается в 4 раза: ${4*a*b}.`,rect(b,a,{a:`${b} см`,b:`${a} см`}),{a,b,scale:2},'см²');
 case 'rect_scale_area':a=r(5,14);b=r(4,12);x=pick([2,3,4]);return N(`Прямоугольник ${a}×${b} см увеличили: длину в ${x} раза, ширину вдвое. Найди площадь нового прямоугольника.`,2*x*a*b,`S=${a}·${b}·${x}·2=${2*x*a*b} см².`,rect(a,b,{a:`${a} см`,b:`${b} см`}),{a,b,k:x},'см²');
 case 'rect_diag_circumradius':[a,b,diag]=triple();return N(`Прямоугольник со сторонами ${a} и ${b} см вписан в окружность. Найди диаметр этой окружности.`,diag,`Диаметр описанной окружности равен диагонали прямоугольника: √(${a*a}+${b*b})=${diag}.`,rect(a,b,{a:`${a} см`,b:`${b} см`},{diagonals:true,circumcircle:true}),{a,b,diag});
 case 'rect_coordinates_distance':a=r(4,13);b=r(3,10);return N(`На координатной плоскости даны A(0;0), B(${a};0), C(${a};${b}), D(0;${b}). Найди площадь ABCD.`,a*b,`Стороны AB=${a}, BC=${b}, площадь ${a*b}.`,rect(a,b),{a,b},'кв. ед.');
 case 'rect_compare_areas':a=r(4,10);b=r(4,9);x=pick([4,6,8]);return N(`У прямоугольника ${a}×${b} см длину увеличили в ${x} раза, а ширину уменьшили в 2 раза. Во сколько раз увеличилась площадь?`,x/2,`S₂/S₁=${x}/2=${x/2}.`,rect(a,b,{a:`${a} см`,b:`${b} см`}),{a,b,k:x},'раз');
 case 'rect_perimeter_and_diag':[a,b,diag]=triple();return N(`Прямоугольник имеет диагональ ${diag} см и сторону ${b} см. На сколько сантиметров его периметр больше удвоенной диагонали?`,2*(a+b-diag),`P=2(${a}+${b})=${2*(a+b)}, 2d=${2*diag}. Разность ${2*(a+b-diag)}.`,rect(a,b,{b:`${b} см`,AC:`${diag} см`},{diagonals:true}),{a,b,diag});
 default:throw Error('unknown rect '+v)
 }
}
function makePar(stage,v){const raw='parallelogram_rhombus_area';let a,b,h,d1,d2,s,p,k,t;
 const N=(body,answer,ex,model,meta={},unit='см²')=>makeNumber(raw,stage,v,body,answer,ex,model,meta,unit);
 const C=(body,ans,wrong,ex,model,meta={})=>makeChoice(raw,stage,v,body,ans,wrong,ex,model,meta);
 switch(v){
 case 'par_area':a=r(6,16);h=r(3,11);return N(`Основание параллелограмма ${a} см, высота ${h} см. Найди площадь.`,a*h,`S=${a}·${h}=${a*h}.`,par(a,h,{a:`${a} см`,h:`${h} см`}),{a,h});
 case 'par_height':a=r(5,13);h=r(3,10);return N(`Площадь параллелограмма ${a*h} см², основание ${a} см. Найди высоту.`,h,`h=S/a=${a*h}/${a}=${h}.`,par(a,h,{a:`${a} см`}),{a,h,s:a*h},'см');
 case 'par_base':a=r(5,13);h=r(3,10);return N(`Площадь параллелограмма ${a*h} см², высота ${h} см. Найди основание.`,a,`a=S/h=${a*h}/${h}=${a}.`,par(a,h,{h:`${h} см`}),{a,h,s:a*h},'см');
 case 'rh_diag_area':d1=2*r(3,9);d2=2*r(3,10);return N(`Диагонали ромба ${d1} см и ${d2} см. Найди площадь.`,d1*d2/2,`S=d₁d₂/2=${d1*d2/2}.`,rhd(d1,d2,{d1:`${d1} см`,d2:`${d2} см`}),{d1,d2});
 case 'rh_property':return C('Как вычисляют площадь ромба по его диагоналям?','половина произведения диагоналей',['произведение диагоналей','полусумма диагоналей','сумма квадратов диагоналей'],'S=d₁d₂/2.',rhd(10,14),{formula:true});
 case 'rh_side_height_area':a=r(7,14);h=r(3,a-1);return N(`Сторона ромба ${a} см, высота к ней ${h} см. Вычисли площадь.`,a*h,`S=a·h=${a*h}.`,rhh(a,h,{side:`${a} см`,h:`${h} см`}),{a,h});
 case 'rh_height_from_area':a=r(8,15);h=r(3,a-1);return N(`Площадь ромба ${a*h} см², сторона ${a} см. Найди высоту.`,h,`h=S/a=${a*h}/${a}=${h}.`,rhh(a,h,{side:`${a} см`}),{a,h,s:a*h},'см');
 case 'rh_other_diag':d1=2*r(3,10);d2=2*r(4,11);s=d1*d2/2;return N(`Площадь ромба ${s} см², первая диагональ ${d1} см. Найди вторую.`,d2,`d₂=2S/d₁=${2*s}/${d1}=${d2}.`,rhd(d1,d2,{d1:`${d1} см`}),{d1,d2,s},'см');
 case 'par_compare_area':a=r(5,11);h=r(3,9);k=pick([2,3,4]);return N(`Два параллелограмма имеют одинаковую высоту ${h} см. Основание первого ${a} см, второго — в ${k} раза больше. На сколько см² площадь второго больше?`,a*h*(k-1),`Разность S₂−S₁=(${k}−1)·${a}·${h}=${a*h*(k-1)}.`,par(a,h,{a:`${a} см`,h:`${h} см`},{caption:'Изображён первый параллелограмм; размеры второго заданы в условии.'}),{a,h,k});
 case 'par_height_change':a=r(6,14);h=r(3,9);k=pick([2,3,4]);return N(`У параллелограмма основание ${a} см и высота ${h} см. Высоту увеличили в ${k} раза, основание не меняли. Найди новую площадь.`,a*h*k,`S₂=${a}·${h}·${k}=${a*h*k}.`,par(a,h,{a:`${a} см`,h:`${h} см`}),{a,h,k});
 case 'par_area_from_base_ratio':a=r(4,12);h=r(3,8);k=pick([2,3,4]);return N(`Основания двух параллелограммов относятся как 1:${k}, высоты равны ${h} см. Меньшее основание ${a} см. Найди площадь большего параллелограмма.`,a*k*h,`Большое основание ${a*k} см; площадь ${a*k}·${h}=${a*k*h}.`,par(a,h,{a:`${a} см`,h:`${h} см`},{caption:'Показан первый параллелограмм.'}),{a,h,k});
 case 'rh_area_from_perimeter':a=r(8,15);h=r(3,a-1);p=4*a;return N(`Периметр ромба ${p} см, высота к стороне ${h} см. Найди площадь.`,a*h,`Сторона P/4=${a}, площадь ${a}·${h}=${a*h}.`,rhh(a,h,{h:`${h} см`}),{a,h,p});
 case 'rh_side_pythagoras':[d1,d2,t]=triple();d1*=2;d2*=2;return N(`Полудиагонали ромба равны ${d1/2} см и ${d2/2} см. Найди его сторону.`,t,`Диагонали перпендикулярны и делятся пополам: a=√(${d1/2}²+${d2/2}²)=${t}.`,rhd(d1,d2,{d1:`${d1} см`,d2:`${d2} см`}),{d1,d2,side:t},'см');
 case 'rh_other_diag_pythagoras':[a,b,t]=triple();return N(`Сторона ромба ${t} см, одна диагональ ${2*a} см. Найди вторую диагональ.`,2*b,`Половины диагоналей и сторона образуют прямоугольный треугольник: d₂=2√(${t}²−${a}²)=${2*b}.`,rhd(2*a,2*b,{d1:`${2*a} см`}),{d1:2*a,d2:2*b,side:t},'см');
 case 'rh_area_from_side_and_diag':[a,b,t]=triple();return N(`Сторона ромба ${t} см, одна диагональ ${2*a} см. Найди площадь ромба.`,2*a*b,`Вторая диагональ 2√(${t}²−${a}²)=${2*b}, поэтому S=${2*a}·${2*b}/2=${2*a*b}.`,rhd(2*a,2*b,{d1:`${2*a} см`}),{d1:2*a,d2:2*b,side:t});
 case 'rh_perimeter_from_area_height':a=r(8,15);h=r(3,a-1);return N(`Площадь ромба ${a*h} см², высота ${h} см. Вычисли периметр.`,4*a,`a=S/h=${a}, P=4a=${4*a}.`,rhh(a,h,{h:`${h} см`}),{a,h,s:a*h},'см');
 case 'par_height_from_perimeter':a=r(7,15);h=r(3,9);b=r(h,h+11);p=2*(a+b);return N(`У параллелограмма периметр ${p} см. Одна сторона ${b} см, площадь ${a*h} см². Найди высоту к другой стороне.`,h,`Другая сторона P/2−${b}=${a}. Высота ${a*h}/${a}=${h}.`,par(a,h,{}, {side:b}),{a,b,h,p},'см');
 case 'par_area_ratio_heights':a=r(5,12);h=r(3,8);k=pick([2,3,4]);return N(`Два параллелограмма имеют основание ${a} см. Высота второго в ${k} раза больше высоты первого ${h} см. Найди отношение площадей второго к первому.`,k,`S₂/S₁=h₂/h₁=${k}.`,par(a,h,{a:`${a} см`,h:`${h} см`},{caption:'Изображён первый параллелограмм.'}),{a,h,k},'раз');
