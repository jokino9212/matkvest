}
function mk854SameRoute(a,b){
 try{return JSON.stringify(a||{})===JSON.stringify(b||{})}catch(e){return false}
}
function mk854HistoryWrite(route,mode="push"){
 const current=mk854Route(),depth=mk854Depth();
 if(mode==="push"&&mk854SameRoute(current,route))return false;
 const payload={__matkvest854:true,depth:mode==="push"?depth+1:depth,route};
 try{
  if(mode==="replace")history.replaceState(payload,"");
  else history.pushState(payload,"");
  return true
 }catch(e){
  try{console.warn("МатКвест: History API недоступен в текущем окружении",e)}catch(_){}
  return false
 }
}
