 if(raw==="numbers_100")html=`<div class="elementary-theory"><p><b>Числа до 100 легче понимать, если увидеть, сколько в них десятков и единиц.</b></p><div class="g2-theory-block"><h3>Соберём число</h3>${g2TensOnesVisualHtml({tens:3,ones:4})}<p>Сначала считаем десятки: 3 десятка — это 30. Потом добавляем 4 единицы. Получаем <b>34</b>.</p><div class="elementary-example"><b>34 = 3 десятка и 4 единицы.</b></div></div><div class="g2-theory-block"><h3>Где число стоит</h3>${elementaryNumberLineSvg({min:30,max:40,highlight:34})}<p>На числовом луче числа увеличиваются вправо. Перед 34 стоит 33, после 34 — 35.</p></div><div class="elementary-example"><b>Короткое правило:</b> сначала сравни десятки, а если их поровну — единицы. Десятки и единицы называют разрядами числа.</div></div>`;
 else if(raw==="quantities")html=`<div class="elementary-theory"><p><b>Когда нужно узнать, насколько предмет длинный, тяжёлый или сколько длится событие, его измеряют.</b></p><div class="g2-theory-block"><h3>Выбери подходящую единицу</h3><p>Карандаш удобно измерять в сантиметрах, комнату — в метрах, массу арбуза — в килограммах, урок — в минутах.</p><div class="elementary-example"><b>1 дм = 10 см • 1 м = 100 см • 1 ч = 60 мин</b></div></div><div class="g2-theory-block"><h3>Сравни по шагам</h3><p>1. Посмотри на единицы. 2. Если они разные — переведи в одинаковые. 3. Сравни числа.</p><div class="elementary-example">Например: 4 дм = 40 см, поэтому 4 дм больше 30 см.</div></div><div class="elementary-example"><b>Короткое правило:</b> сравнивать удобно только одинаковые единицы. Длина, масса и время — это величины.</div></div>`;
 else if(raw==="add_sub_100")html=`<div class="elementary-theory"><p><b>Считать до 100 легче, если разбивать действие на удобные шаги.</b></p><div class="g2-theory-block"><h3>Прибавляем десятки</h3>${g2ArithmeticStepVisualHtml({expression:"34 + 20",showSteps:true,steps:["30 + 20 = 50","50 + 4 = 54"]})}<p>К 34 прибавили 2 десятка и получили <b>54</b>.</p></div><div class="g2-theory-block"><h3>Переходим через десяток</h3>${g2ArithmeticStepVisualHtml({expression:"38 + 7",showSteps:true,steps:["38 + 2 = 40","от 7 осталось 5","40 + 5 = 45"]})}<p>Сначала доходим до круглого десятка, потом прибавляем остаток.</p></div><div class="g2-theory-block"><h3>Вычитаем так же</h3>${g2ArithmeticStepVisualHtml({expression:"42 − 5",showSteps:true,steps:["42 − 2 = 40","осталось вычесть 3","40 − 3 = 37"]})}</div><div class="elementary-example"><b>Короткое правило:</b> выбирай шаг, после которого считать проще.</div></div>`;
 else if(raw==="multiply_divide")html=`<div class="elementary-theory"><p><b>Если есть несколько одинаковых групп, одно и то же число не обязательно складывать много раз.</b></p><div class="g2-theory-block"><h3>Одинаковые группы</h3>${g2EqualGroupsVisualHtml({groups:3,each:4})}<p>В каждой группе по 4 предмета, групп 3: <b>4 + 4 + 4 = 12</b>. Короткая запись: <b>4 × 3 = 12</b>.</p><p>Такое действие называют <b>умножением</b>.</p></div><div class="g2-theory-block"><h3>Делим поровну</h3><p>Если 12 предметов раздать поровну в 3 группы, в каждой будет по 4: <b>12 ÷ 3 = 4</b>.</p><p>Такое действие называют <b>делением</b>.</p></div><div class="elementary-example"><b>Короткое правило:</b> умножение собирает одинаковые группы, а деление помогает разделить поровну или узнать число групп.</div></div>`;
 else if(raw==="operations_100")html=`<div class="elementary-theory"><p><b>Когда в одной записи несколько действий, важно понять, какое выполнять первым.</b></p><div class="g2-theory-block"><h3>Если только + и −</h3>${g2ExpressionVisualHtml({expression:"30 + 8 − 5",showFocus:true,focus:"30 + 8"})}<p>Считаем слева направо: сначала 30 + 8, потом вычитаем 5.</p></div><div class="g2-theory-block"><h3>× и ÷ раньше + и −</h3>${g2ExpressionVisualHtml({expression:"20 + 3 × 4",showFocus:true,focus:"3 × 4"})}<p>Сначала 3 × 4 = 12. Потом 20 + 12 = 32.</p></div><div class="g2-theory-block"><h3>Скобки — сначала</h3>${g2ExpressionVisualHtml({expression:"(8 + 4) ÷ 3",showFocus:true,focus:"8 + 4"})}<p>Сначала 8 + 4 = 12. Потом 12 ÷ 3 = 4.</p></div><div class="elementary-example"><b>Короткое правило:</b> скобки → × и ÷ → + и −. Запись из чисел и действий называют выражением.</div></div>`;
 else if(raw==="word_problems"){
  const one={steps:[{label:"Было",value:"28"},{label:"Добавили",value:"+ 15"},{label:"Стало",value:"?",answer:true}],aria:"Было 28, добавили 15, нужно узнать сколько стало"};
  const two={steps:[{label:"Было",value:"35"},{label:"Добавили",value:"+ 18"},{label:"После 1-го действия",value:"53",derived:true},{label:"Убрали",value:"− 9"},{label:"Осталось",value:"?",answer:true}],aria:"Два действия: сначала прибавить 18, потом вычесть 9"};
  html=`<div class="elementary-theory"><p><b>В задаче сначала нужно понять, что известно и что спрашивают.</b></p><div class="g2-theory-block"><h3>Один шаг</h3><p>Прочитай вопрос. Если предметы добавили, обычно нужно сложить; если убрали — вычесть.</p>${g2StoryVisualHtml(one)}<div class="elementary-example">28 + 15 = 43. Значит, стало 43.</div></div><div class="g2-theory-block"><h3>Одинаковые группы</h3>${g2EqualGroupsVisualHtml({groups:4,each:5})}<p>4 группы по 5 предметов: <b>5 × 4 = 20</b>.</p></div><div class="g2-theory-block"><h3>Два шага</h3>${g2StoryVisualHtml({...two,showDerived:true})}<p>Сначала 35 + 18 = 53. Потом 53 − 9 = 44.</p></div><div class="elementary-example"><b>Короткое правило:</b> вопрос → действие → вычисление → ответ. Если после первого действия на вопрос ещё нельзя ответить, нужен второй шаг.</div></div>`
 }
 else if(raw==="geometric_figures")html=`<div class="elementary-theory"><p><b>Фигуры можно различать по форме, сторонам и углам.</b></p><div class="g2-theory-block"><h3>Сравни фигуры</h3>${g1ShapeVisualHtml({mode:"gallery",order:["Круг","Треугольник","Квадрат","Прямоугольник"]})}<p>У треугольника 3 стороны. У квадрата и прямоугольника — по 4.</p><div class="elementary-example">У квадрата все 4 стороны равны. У прямоугольника две длинные стороны равны между собой и две короткие — между собой.</div></div><div class="g2-theory-block"><h3>Точка и отрезок</h3>${g1ShapeVisualHtml({mode:"single",shape:"Отрезок"})}<p>Точка — маленькая отметка. Отрезок — прямая линия между двумя отмеченными концами.</p></div><div class="elementary-example"><b>Короткое правило:</b> сначала посмотри на форму, затем посчитай стороны и углы.</div></div>`;
 else if(raw==="geometric_quantities"){
  const rect={shape:"rectangle",a:6,b:3,perimeter:18},square={shape:"square",a:4,perimeter:16};
  html=`<div class="elementary-theory"><p><b>Если пройти по всей границе фигуры, её длину можно найти сложением сторон.</b></p><div class="g2-theory-block"><h3>Сложи все стороны</h3>${g2PerimeterVisualHtml({...rect,labelAllSides:true,showPerimeter:true})}<p>6 + 3 + 6 + 3 = 18 см. Длину всей границы называют <b>периметром</b>.</p></div><div class="g2-theory-block"><h3>Квадрат</h3>${g2PerimeterVisualHtml({...square,labelAllSides:true,showPerimeter:true})}<p>У квадрата 4 равные стороны: 4 + 4 + 4 + 4 = 16 см.</p></div><div class="g2-theory-block"><h3>Длина отрезка</h3>${g1LengthVisualHtml({kind:"measure",a:7})}<p>Поставь начало отрезка у 0 и прочитай число у его конца.</p></div><div class="elementary-example"><b>Короткое правило:</b> периметр — сумма длин всех сторон фигуры.</div></div>`
 }
 else if(raw==="math_information"){
  const demoRows=[{label:"Книги",value:12},{label:"Тетради",value:18},{label:"Альбомы",value:9}],pattern=[20,25,30,35],steps=["Начни с числа 24.","Прибавь 10.","Вычти 4."];
  html=`<div class="elementary-theory"><p><b>По числам в таблице или ряду можно быстро найти нужные данные и заметить порядок.</b></p><div class="g2-theory-block"><h3>Прочитай таблицу</h3>${g2InfoTableVisualHtml({rows:demoRows,title:"Школьные принадлежности"})}<p>Сначала найди нужную строку, потом прочитай число рядом.</p><div class="elementary-example">Тетрадей больше, чем книг, потому что <b>18 &gt; 12</b>.</div></div><div class="g2-theory-block"><h3>Найди правило</h3>${g2InfoSequenceVisualHtml({shown:pattern})}<p>Здесь каждый раз прибавляют 5. Такой повторяющийся порядок называют <b>закономерностью</b>.</p></div><div class="g2-theory-block"><h3>Делай по шагам</h3>${g2InfoAlgorithmVisualHtml({steps})}<p>Сначала выполни первый шаг, затем следующий. Такой порядок команд называют <b>алгоритмом</b>.</p><div class="elementary-example">24 + 10 = 34, затем 34 − 4 = 30.</div></div><div class="elementary-example"><b>Короткое правило:</b> найди данные → пойми правило → выполняй шаги по порядку.</div></div>`
 }
 else html=PRE846_G2_THEORY_HTML(id);
 return g2SchoolText846(html)
};

