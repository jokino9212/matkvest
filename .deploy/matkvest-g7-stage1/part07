const G8_PRE852_LESSON=g8Lesson;
const G8_STAGE852_THEORY_CACHE={};
function g8TheoryPlain852(html){const d=document.createElement("div");d.innerHTML=String(html||"");return (d.innerText||"").replace(/\s+/g," ").trim()}
function g8TheorySeed852(text){let h=2166136261>>>0;for(const ch of String(text)){h^=ch.charCodeAt(0);h=Math.imul(h,16777619)}return h>>>0}
function g8TheoryRng852(seed){let a=seed>>>0;return function(){a|=0;a=a+0x6D2B79F5|0;let t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return ((t^t>>>14)>>>0)/4294967296}}
function g8TheoryAnswer852(q){
 if(q?.correctLabel!=null&&String(q.correctLabel)!=="")return String(q.correctLabel);
 if(Array.isArray(q?.choices)){const key=String(q?.ans??q?.correct??q?.answer??"");const row=q.choices.find(x=>String(x.key)===key);if(row)return String(row.label??row.key)}
 const v=q?.ans??q?.correct??q?.answer;return v==null?"":String(v)
}
function g8TheoryExample852(id){
 const raw=rawCourseId(id);if(G8_STAGE852_THEORY_CACHE[raw])return G8_STAGE852_THEORY_CACHE[raw];
 const oldRandom=Math.random,random=g8TheoryRng852(g8TheorySeed852(raw)),candidates=[];Math.random=random;
 try{
  for(let i=0;i<48;i++){
   try{
    const q=makeG8Question(`g8:${raw}`,0),ex=String(q?.ex||q?.explain||""),text=String(q?.text||""),plain=`${g8TheoryPlain852(text)} ${g8TheoryPlain852(ex)}`;
    if(!ex||/NaN|Infinity|undefined/.test(plain)||/\d+[,.]\d{6,}/.test(plain))continue;
    const score=Math.min(420,g8TheoryPlain852(ex).length)+(q?.visual?18:0)+(g8TheoryPlain852(ex).length>=80?35:0);
    candidates.push({q,score})
   }catch(e){}
  }
 }finally{Math.random=oldRandom}
 candidates.sort((a,b)=>b.score-a.score);const q=candidates[0]?.q;if(!q)return "";
 let visual="";try{visual=q.visual?quizVisualHtml(q):""}catch(e){visual=""}
 const answer=g8TheoryAnswer852(q),ex=String(q.ex||q.explain||"");
 const html=`<div class="g8-theory852-example"><p><b>Разобранный пример.</b> ${q.text}</p>${visual}${answer?`<p><b>Ответ:</b> ${answer}</p>`:""}<p><b>Почему так:</b> ${ex}</p></div>`;
 G8_STAGE852_THEORY_CACHE[raw]=html;return html
}
