 mk854RunRestoring(()=>{
  MK854_CORE_CLOSE_MODAL();
  if(r.screen==="home")return MK854_CORE_RENDER_HOME();
  if(r.screen==="grade")return MK854_CORE_OPEN_GRADE(Number(r.grade));
  if(r.screen==="topic")return mk854RenderTopicCore(r);
  if(r.screen==="trainer")return MK854_CORE_OPEN_QUICK(r.trainerId);
  if(r.screen==="store"){MK854_CORE_OPEN_SHOP(r.category||"avatars");return}
  if(r.screen==="leaderboard"){MK854_CORE_OPEN_LEADERBOARD();mk854AfterLeaderboardOpen();return}
  if(r.screen==="profiles"){MK854_CORE_OPEN_PROFILES();mk854AfterProfilesOpen();return}
  if(mk854ExtraRouteRenderer(r))return;
  MK854_CORE_RENDER_HOME();
 });
}
