/* 6 класс: чередование педагогических шаблонов без изменения структуры
   существующих попыток. Используем штатные подписи и историю вопросов. */
const G6_PRE_AUDIT_FRESH=freshQuiz;
function g6AuditFamily(sig){
 const parts=String(sig||"").split(":");
 return parts[0]==="g6"&&parts.length>=4?`${parts[1]}:${parts[3]}`:String(sig||"").slice(0,90);
}
freshQuiz=function(id){
 const sid=String(id||"");
 if(!sid.startsWith("g6:")||blockSession?.kind!=="g6quiz")return G6_PRE_AUDIT_FRESH(id);
 const maker=()=>makeG6Question(sid),signature=q=>q.sig||`g6:${rawCourseId(sid)}:${normalizePromptForCompare(q.text||"")}`;
 const used=blockSession?.usedSignatures||[],lastSig=used.length?used[used.length-1]:"",lastFamily=g6AuditFamily(lastSig);
 const promptOf=q=>normalizePromptForCompare(quizAttemptPrompt(q)),pastPrompts=new Set((blockSession.items||[]).map(x=>normalizePromptForCompare(x.prompt||"")));
 let candidate=null;
 // Сначала: новый пример, новый тип действия и не та же формулировка.
 for(let pass=0;pass<3;pass++){
  for(let tries=0;tries<180;tries++){
   const q=maker(),sig=signature(q),family=g6AuditFamily(sig);
   if(wasUsedInBlock(sig))continue;
   if(pass===0&&(wasRecent(sig)||family===lastFamily||pastPrompts.has(promptOf(q))))continue;
   if(pass===1&&(family===lastFamily||pastPrompts.has(promptOf(q))))continue;
   if(pass===2&&pastPrompts.has(promptOf(q)))continue;
   candidate=q;registerSignature(sig);candidate._signature=sig;break;
  }
  if(candidate)break;
 }
 // В чрезвычайно маленьком пуле действует прежний bounded fallback.
 return candidate||freshCandidate(maker,signature,480);
};


