function g8AllTopics(){return G8_GROUPS.flatMap(g=>g.topics)}
function g8InfoById(id){const v=String(id||""),key=v.startsWith("g8:")?v:`g8:${v}`;return g8AllTopics().find(x=>x.id===key)||null}
function g8CourseById(id){return G8_COURSES.find(c=>c.id===id)||null}
function g8GroupsByCourse(id){return G8_GROUPS.filter(g=>g.course===id)}
function g8ImplementedTopics(){return g8AllTopics().filter(t=>t.implemented!==false)}
function g8CatalogAudit(){
 const topics=g8AllTopics(),ids=topics.map(t=>t.id),orders=topics.map(t=>t.order),courseIds=new Set(G8_COURSES.map(c=>c.id)),groupIds=new Set(G8_GROUPS.map(g=>g.id)),issues=[];
 const stage81=new Set(["g8:square_root_arithmetic","g8:irrational_numbers_approximations","g8:real_numbers_compare","g8:equation_x2_equals_a","g8:square_root_properties","g8:root_expression_transformations","g8:root_calculations_applications"]);
 if(new Set(ids).size!==ids.length)issues.push("duplicate-id");
 if(ids.some(id=>!id.startsWith("g8:")))issues.push("id-prefix");
 if(topics.some(t=>t.grade!==8))issues.push("grade");
 if(new Set(orders).size!==orders.length||orders.some((v,i)=>v!==i+1))issues.push("order");
 if(topics.some(t=>stage81.has(t.id)?t.implemented!==true:t.implemented!==false))issues.push("implemented-boundary");
 if(topics.some(t=>stage81.has(t.id)?t.rendererType==="pending":t.rendererType!=="pending"))issues.push("rendererType-boundary");
 if(topics.some(t=>!t.plannedRendererType))issues.push("plannedRendererType");
 if(topics.some(t=>!courseIds.has(t.course)))issues.push("course");
 if(G8_GROUPS.some(g=>!courseIds.has(g.course)||!groupIds.has(g.id)))issues.push("group");
 if(topics.some(t=>!t.title||!t.shortTitle||!t.source||!t.programRef))issues.push("metadata");
 return {ok:issues.length===0,issues,total:topics.length,implemented:g8ImplementedTopics().length,pending:topics.filter(t=>t.rendererType==="pending").length};
}
