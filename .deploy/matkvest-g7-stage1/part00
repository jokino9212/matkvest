<script>

/* =========================================================
   5 КЛАСС — учебный контент перенесён из файла-донора
   ========================================================= */
function frac(n,d){return '<span class="frac"><span class="num">'+n+'</span><span class="den">'+d+'</span></span>'}
function mixed(w,n,d){return '<span class="mixed"><span class="whole">'+w+'</span>'+frac(n,d)+'</span>'}
function math(s){return '<span class="math">'+s+'</span>'}
function gcd(a,b){a=Math.abs(a);b=Math.abs(b);while(b){let t=a%b;a=b;b=t}return a||1}
function lcm(a,b){a=Math.abs(Math.trunc(a));b=Math.abs(Math.trunc(b));if(!a||!b)return 0;return Math.abs((a/gcd(a,b))*b)}
function isPrime(n){n=Math.trunc(Number(n));if(n<2)return false;if(n===2)return true;if(n%2===0)return false;for(let d=3;d*d<=n;d+=2)if(n%d===0)return false;return true}
function primeFactors(n){n=Math.abs(Math.trunc(Number(n)));const out=[];for(let d=2;d*d<=n;d+=(d===2?1:2)){while(n%d===0){out.push(d);n/=d}}if(n>1)out.push(n);return out}
function superscriptInt(n){const map={"0":"⁰","1":"¹","2":"²","3":"³","4":"⁴","5":"⁵","6":"⁶","7":"⁷","8":"⁸","9":"⁹","-":"⁻"};return String(n).split("").map(ch=>map[ch]||ch).join("")}
function formatPrimeFactorization(n){const f=primeFactors(n),counts=new Map();for(const p of f)counts.set(p,(counts.get(p)||0)+1);return [...counts.entries()].map(([p,e])=>e===1?String(p):`${p}${superscriptInt(e)}`).join(" · ")}
function allDivisors(n){n=Math.abs(Math.trunc(Number(n)));const a=[],b=[];for(let d=1;d*d<=n;d++){if(n%d===0){a.push(d);if(d*d!==n)b.push(n/d)}}return a.concat(b.reverse())}
function simp(n,d){let g=gcd(n,d);return[n/g,d/g]}
function decimalComma(x,places=2){let s=(Math.round(x*Math.pow(10,places))/Math.pow(10,places)).toString();return s.replace(".",",")}
function g5UniqChoices(arr){
 let out=[];
 for(const x of arr){
   const sameKey=out.some(y=>String(y.key)===String(x.key));
   const sameLabel=out.some(y=>String(y.label)===String(x.label));
   if(!sameKey&&!sameLabel)out.push(x);
 }
 return out;
}

/* HOTFIX 8.51: semantic single-choice safety.
   Финализатор имеет право только удалить эквивалентные дубли и перемешать
   уже подготовленные generator-ом варианты. Он НЕ создаёт новые distractors:
